                            },
                            {
                              "Key": "Depth",
                              "Value": "0"
                            },
                            {
                              "Key": "Efficiency",
                              "Value": "1"
                            },
                            {
                              "Key": "WillRunoff",
                              "Value": "False"
                            }
                          ],
                          "Name": "IrrDate0",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
