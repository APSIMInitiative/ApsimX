          "FileNames": [
            "Observed/ForestHillObserved.xlsx",
            "Observed/Narrabri0607Observed.xlsx",
            "Observed/Narrabri0203Observed.xlsx",
            "Observed/BDKObserved.xlsx",
            "Observed/WarraObserved.xlsx",
            "Observed/Narrabri23.xlsx",
            "Observed/DouglasDaly2021.xlsx",
            "Observed/DouglasDaly21Observed_20251202.xlsx",
            "Observed/Emerald2015Observed.xlsx"
          ],
          "SheetNames": [
            "CottonObserved",
            "PhenologyObserved"
          ],
          "Name": "Observed",
          "ResourceName": null,
          "Children": [],
