                              "Value": "2017/05/26"
                            },
                            {
                              "Key": "ValueCsvString",
                              "Value": "1.7,2.2"
                            },
                            {
                              "Key": "ThicknessCsvString",
                              "Value": "300,300"
                            }
                          ],
                          "Name": "NH4Initialise1",
