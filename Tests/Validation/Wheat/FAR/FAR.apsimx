            {
              "$type": "Models.Factorial.Experiment, Models",
              "DisabledSimNames": null,
              "Name": "FAR HYC W18-08-1",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Memo, Models",
                  "Text": "# Field Applied Research (FAR) Australia trial FAR HYC W18-08-1 at Hagley in 2018. \r\n\r\nThis trial has been selected because it contained 2 cultivars of interest, and had up to 8 Greenseeker (NDVI), 4 biomass, 1 N concentration or 0 growth stage measurements. \r\n\r\n*Grazing/defolation treatments have been excluded.* \r\n\r\nTrial description: **Nitrogen management in wheat � optimising nitrogen applications for hyper yielding wheat crops (40 plots taken to yield sown 5 April).** \r\n\r\n[Some trial details may be found here](https://faraustralia.com.au/resource) \r\n\r\n",
                  "Name": "Description",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Factorial.Factors, Models",
                  "Name": "Factors",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Factorial.Permutation, Models",
                      "Name": "Permutation",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Factorial.Factor, Models",
                          "Specification": null,
                          "Name": "Nutrition",
                          "ResourceName": null,
                          "Children": [
                            {
                              "$type": "Models.Factorial.CompositeFactor, Models",
                              "Specifications": [
                                "[Sowing].Script.Treat = 46NLate",
                                "[FertStage0].Script.Stage = 30",
                                "[FertStage0].Script.FertiliserType = UreaN",
                                "[FertStage0].Script.Amount = 0",
                                "[FertStage1].Script.Stage = 31",
                                "[FertStage1].Script.FertiliserType = UreaN",
                                "[FertStage1].Script.Amount = 0",
                                "[FertStage2].Script.Stage = 37",
                                "[FertStage2].Script.FertiliserType = UreaN",
                                "[FertStage2].Script.Amount = 46"
                              ],
                              "Paths": null,
                              "Values": null,
                              "Name": "46NLate",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            },
                            {
                              "$type": "Models.Factorial.CompositeFactor, Models",
                              "Specifications": [
                                "[Sowing].Script.Treat = 200NMid",
                                "[FertStage0].Script.Stage = 30",
                                "[FertStage0].Script.FertiliserType = UreaN",
                                "[FertStage0].Script.Amount = 50",
                                "[FertStage1].Script.Stage = 31",
                                "[FertStage1].Script.FertiliserType = UreaN",
