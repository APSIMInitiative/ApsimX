          "ReadOnly": false
        },
        {
          "$type": "Models.Manager, Models",
          "CodeArray": [
            "using Models.Soils.Nutrients;",
            "using System;",
            "using Models.Core;",
            "using Models.PMF;",
            "using Models.Soils;",
            "using Models.Soils.Nutrients;",
            "using Models.Utilities;",
            "using Models.Functions;",
            "using APSIM.Shared.Utilities;",
            "",
            "using System.Diagnostics;",
            "",
            "namespace Models",
            "{",
            "    [Serializable]",
            "    public class Script : Model",
            "    {",
            "        [Link] Plant Wheat;",
            "        [Link(Type = LinkType.Path, Path = \"[Wheat].Phenology.Phyllochron.BasePhyllochron\")] Constant WheatPhyllochron;",
            "        [Link(Type = LinkType.Path, Path = \"[Wheat].Phenology.Phyllochron.LeafStageFactor.XYPairs\")] XYPairs PhyllochronMultipliers;",
            "                        ",
            "        [Description(\"Germination Date (d-mmm)\")]",
            "        public string GermDate { get; set;} ",
            "        [Description(\"Emergence Date (d-mmm)\")]",
            "        public string EmergDate { get; set;}",
            "        [Description(\"Vernalisation Date (d-mmm)\")]",
            "        public string VernDate { get; set;}",
            "        [Description(\"Terminal Spikelet Date (d-mmm)\")]",
            "        public string TSDate { get; set;}",
            "        [Description(\"FlagLeaf Date (d-mmm)\")]",
            "        public string FlagDate { get; set;}",
            "        [Description(\"Heading Date (d-mmm)\")]",
            "        public string HeadingDate { get; set;}",
            "        [Description(\"Anthesis Date (d-mmm)\")]",
            "        public string AnthDate { get; set;}",
            "        [Description(\"Ripe Date (d-mmm)\")]",
            "        public string RipeDate { get; set;}",
            "",
            "        [Description(\"Phyllochron (oC.d)\")]",
            "        public double Phyllochron { get; set;}",
            "        ",
            "        [Description(\"Phyllochron Multiplier (-)\")]",
            "        public double PhyllochronMultiplier { get; set;}",
            "        ",
            "        ",
            "        [EventSubscribe(\"PlantSowing\")]",
            "        private void OnPlantSowing(object sender, SowingParameters data)",
            "        {",
            "            if (!String.IsNullOrEmpty(GermDate))",
            "            {",
            "               Wheat.Phenology.SetPhaseCompletionDate(GermDate,\"Germinating\");",
            "            }",
            "            if (!String.IsNullOrEmpty(EmergDate))",
            "            {",
            "               Wheat.Phenology.SetPhaseCompletionDate(EmergDate,\"Emerging\");",
            "            }",
            "            if (!String.IsNullOrEmpty(VernDate))",
            "            {",
            "               Wheat.Phenology.SetPhaseCompletionDate(VernDate,\"LeavesInitiating\");",
            "            }",
            "            if (!String.IsNullOrEmpty(TSDate))",
            "            {",
            "               Wheat.Phenology.SetPhaseCompletionDate(TSDate,\"SpikeletsDifferentiating\");",
            "            }",
            "            if (!String.IsNullOrEmpty(FlagDate))",
            "            {",
            "               Wheat.Phenology.SetPhaseCompletionDate(FlagDate,\"StemElongating\");",
            "            }",
            "            if (!String.IsNullOrEmpty(HeadingDate))",
            "            {",
            "               Wheat.Phenology.SetPhaseCompletionDate(HeadingDate,\"Heading\");",
            "            }",
            "            if (!String.IsNullOrEmpty(AnthDate))",
            "            {",
            "               Wheat.Phenology.SetPhaseCompletionDate(AnthDate,\"Flowering\");",
            "            }",
            "            if (!String.IsNullOrEmpty(RipeDate))",
            "            {",
            "               Wheat.Phenology.SetPhaseCompletionDate(RipeDate,\"GrainRipening\");",
            "            }",
            "            if (Phyllochron>0)",
            "               WheatPhyllochron.FixedValue = Phyllochron;",
            "               ",
            "            if (PhyllochronMultiplier>0)",
            "            {",
            "               //Debugger.Break();",
            "               PhyllochronMultipliers.Y[4] = PhyllochronMultiplier;",
            "               PhyllochronMultipliers.Y[5] = PhyllochronMultiplier;",
            "             }  ",
            "        }",
            "    }",
            "}"
          ],
          "Parameters": [
            {
              "Key": "GermDate",
              "Value": ""
            },
            {
              "Key": "EmergDate",
              "Value": ""
            },
            {
              "Key": "VernDate",
              "Value": ""
            },
            {
              "Key": "TSDate",
              "Value": ""
            },
            {
              "Key": "FlagDate",
              "Value": ""
            },
            {
              "Key": "HeadingDate",
              "Value": ""
            },
            {
              "Key": "AnthDate",
              "Value": ""
            },
            {
              "Key": "RipeDate",
              "Value": ""
            },
            {
              "Key": "Phyllochron",
              "Value": "100"
            },
            {
              "Key": "PhyllochronMultiplier",
              "Value": "0"
            }
          ],
          "Name": "SetPhenology",
          "ResourceName": null,
          "Children": [],
          "Enabled": true,
          "ReadOnly": false
        }
      ],
      "Enabled": true,
      "ReadOnly": false
    },
