                      "InitialResidueName": "wheat_stubble",
                      "InitialResidueType": "wheat",
                      "InitialResidueMass": 10000.0,
                      "InitialStandingFraction": 0.0,
                      "InitialCPR": 0.0,
                      "InitialCNR": 20.0,
                      "Name": "SurfaceOrganicMatter",
                      "ResourceName": "SurfaceOrganicMatter",
                      "Children": [],
