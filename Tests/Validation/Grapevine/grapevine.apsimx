                  "AspectAngle": 0.0,
                  "Altitude": 50.0,
                  "Name": "Row",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Report, Models",
                      "VariableNames": [
                        ""
                      ],
                      "EventNames": [
                        "[Clock].DoReport"
