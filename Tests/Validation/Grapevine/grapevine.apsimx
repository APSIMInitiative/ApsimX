                {
                  "$type": "Models.Zones.RectangularZone, Models",
                  "Length": 100.0,
                  "Width": 1.5,
                  "CanopyType": "VineRow",
                  "Slope": 0.0,
                  "AspectAngle": 0.0,
                  "Altitude": 50.0,
                  "Name": "Alley",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Surface.SurfaceOrganicMatter, Models",
                      "SurfOM": [],
                      "Canopies": [],
                      "InitialResidueName": "wheat_stubble",
                      "InitialResidueType": "Grapevine",
                      "InitialResidueMass": 20.0,
                      "InitialStandingFraction": 0.0,
                      "InitialCPR": 0.0,
                      "InitialCNR": 30.0,
                      "Name": "SurfaceOrganicMatter",
