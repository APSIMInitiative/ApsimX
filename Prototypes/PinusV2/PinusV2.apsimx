                      "Name": "BarkThickness",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Functions.VariableReference, Models",
                          "VariableName": "[Pinus].Stem.DBH",
                          "Name": "XValue",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
