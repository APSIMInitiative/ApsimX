                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Report, Models",
                      "VariableNames": [
                        ""
                      ],
                      "EventNames": [
                        "[Clock].DoReport"
                      ],
                      "GroupByVariableName": null,
