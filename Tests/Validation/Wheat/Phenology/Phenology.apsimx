                    },
                    {
                      "$type": "Models.Manager, Models",
                      "CodeArray": [
                        "using Models.Climate;",
                        "using System;",
                        "using Models.Core;",
                        "using Models.PMF;",
                        "using Models.Soils;",
                        "using Models.Utilities;",
                        "using APSIM.Shared.Utilities;",
                        "",
                        "namespace Models",
                        "{",
                        "    [Serializable]",
                        "    public class Script : Model",
                        "    {",
                        "        [Link] Clock clock;",
                        "        [Link] Plant wheat;",
                        "        [Link] ControlledEnvironment ci;",
                        "",
                        "        [Display(Type = DisplayType.CultivarName)]",
                        "        [Description(\"Cultivar to be sown\")]",
                        "        public string CultivarName { get; set; }",
                        "        [Description(\"Sowing depth (mm)\")]",
                        "        public double SowingDepth { get; set; }",
                        "        [Description(\"Vernalisation\")]",
                        "        public string Vern { get; set; }",
                        "        [Description(\"Treatment photoperiod (h)\")]",
                        "        public double TreatPp { get; set; }",
                        "        [Description(\"Treatment duration (Weeks)\")]",
                        "        public double TransitionWeek { get; set; }",
                        "        private double DAS {get; set;}",
                        "        private bool FirstDay = true;",
                        "        [Description(\"Emergence Date (d-MMM)\")]",
                        "        public string EmergeDate {get; set;}",
                        "",
                        "        [EventSubscribe(\"PreparingNewWeatherData\")]",
                        "        private void OnPreparingNewWeatherData(object sender, EventArgs e)",
                        "        {",
                        "            if (FirstDay)",
                        "            {",
                        "                wheat.Sow(population: 100, cultivar: CultivarName, depth: SowingDepth, rowSpacing: 150);    ",
                        "                wheat.Phenology.SetPhaseCompletionDate(EmergeDate,\"Emerging\");",
                        "                FirstDay = false;",
                        "            }",
                        "            DAS += 1;",
                        "            if ((DAS <= 100)&&(Vern==\"Full\"))",
                        "            {",
                        "                ci.MaxT = 1.0;",
                        "                ci.MinT = 1.0;",
                        "                ci.DayLength = 0;",
                        "            }",
                        "            else",
                        "            {",
                        "                ci.MaxT=23.6;",
                        "                ci.MinT=23.6;",
                        "                ci.DayLength = TreatPp;",
                        "                ci.Radn = ((TreatPp - 2) * 3600 * 0.000153 * 2) + (2 * 3600 * 0.000153); //Full light(Hours * s/h * MJ/m2/s * Coeff_PAR->Total) + 2 hour at half light (Hours * s/h * MJ/m2/s) ",
                        "            }",
                        "        }",
                        "    }",
                        "}"
                      ],
                      "Parameters": [
                        {
                          "Key": "CultivarName",
                          "Value": ""
                        },
                        {
                          "Key": "SowingDepth",
                          "Value": "20"
                        },
                        {
                          "Key": "Vern",
                          "Value": ""
                        },
                        {
                          "Key": "TreatPp",
                          "Value": "0"
                        },
                        {
                          "Key": "TransitionWeek",
                          "Value": "0"
                        },
                        {
                          "Key": "EmergeDate",
                          "Value": ""
                        }
                      ],
                      "Name": "Experimental",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Manager, Models",
                      "CodeArray": [
                        "using Models.PMF.Phen;",
                        "using APSIM.Shared.Utilities;",
                        "using Models.Utilities;",
                        "using Models.Soils;",
                        "using Models.PMF;",
                        "using Models.Core;",
                        "using System;",
                        "using Models.Soils.Nutrients;",
                        "",
                        "namespace Models",
                        "{",
                        "    [Serializable]",
                        "    public class Script : Model",
                        "    {",
                        "        [Link] private Plant Wheat;",
                        "        [Link] private Clock clock;",
                        "        [Link(Type = LinkType.Path, Path = \"[Wheat].Phenology\")]",
                        "        private Phenology phenology;",
                        "",
                        "        [EventSubscribe(\"DoManagement\")]",
                        "        private void OnDoManagement(object sender, EventArgs e)",
                        "        {",
                        "            if (phenology.CurrentPhase.Name==\"GrainFilling\")",
                        "            {",
                        "               Wheat.Harvest();",
                        "               Wheat.EndCrop();    ",
                        "               clock.EndDate = clock.Today.Date;",
                        "            }",
                        "        ",
                        "        }",
                        "        ",
                        "    }",
                        "}"
                      ],
                      "Parameters": [],
                      "Name": "HarvestAtFlowering",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
