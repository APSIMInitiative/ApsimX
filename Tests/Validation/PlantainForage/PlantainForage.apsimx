                              "Name": "DefoliationSchedule",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            },
                            {
                              "$type": "Models.Manager, Models",
                              "CodeArray": [
                                "// This script will perform defoliations, i.e remove biomass, from any existing plant (PMF and/or AgPasture) that is alive in a field.",
                                "// General rules for when and how much to defoliate, as well as how to handle the material harvested, are supplied via the GUI.",
                                "// Defoliations can be triggered automatically by this manager, based on given rules, or by calling the 'Defoliate()' method",
                                "//  from another Script or a Schedule model. Note that in this case, some rules are overriden based on the parameters given in Defoliate().",
                                "// Developed by RCichota, last updated in 20/Jan/2025",
                                "",
                                "using APSIM.Core;",
                                "using System;",
                                "using System.Linq;",
                                "using System.Collections.Generic;",
                                "using Newtonsoft.Json;",
                                "using APSIM.Shared.Utilities;",
                                "using Models.Core;",
                                "using Models.PMF;",
                                "using Models.Soils;",
                                "using Models.PMF.Interfaces;",
                                "using Models.AgPasture;",
                                "using Models.ForageDigestibility;",
                                "using APSIM.Numerics;",
                                "",
                                "namespace Models",
                                "{",
                                "    [Serializable]",
                                "    public class Script : Model, IStructureDependency",
                                "    {",
                                "        [Link] private Clock clock;",
                                "        [Link] private Zone myZone;",
                                "        [Link] private IPhysical soilPhysical;",
                                "        [Link(ByName = true)] private ISolute Urea;",
                                "        [Link] private Surface.SurfaceOrganicMatter surfaceOM;",
                                "        [Link] private Forages swardForages;",
                                "        [Link] private ISummary summary;",
                                "        public  event BiomassRemovedDelegate BiomassRemoved;",
                                "        public  event EventHandler DefoliationHappenedToday;",
                                "        private string baseAmountType;",
                                "        private string currentAmountType;",
                                "        private double currentAmountForDefoliation;",
                                "        private double currentMinAmount;",
                                "        private double herbageToRemove;",
                                "        private int durationOfThisDefoliation;",
                                "        private int daysDefoliating;",
                                "        private double cumAmountHarvested;",
                                "        private double currentPostHarvest;",
                                "        private double swardPreviousPhenoStage;",
                                "        private bool aDefoliationHasHappened;",
                                "        ",
                                "        public IStructure Structure { private get; set; }",
                                "",
                                "        //> Links to other Apsim models",
                                "        [Link] private IPlant[] existingCrops;",
                                "",
                                "        //> Events raised by this manager",
                                "        private EventArgs args = new EventArgs();",
                                "",
                                "        //> User inputs from properties tab",
                                "        [Separator(\"Generic defoliation management - removes biomass from all PMF and AgPasture species in the field \\n\"",
                                "                 + \"   this also includes residue management or the return of excreta (dung and urine, uniformly)\")]",
                                "        [Description(\" Allow this manager to control defoliations automatically?\")]",
                                "        public yesNoAnswer AllowAutomaticManagement { get; set; }",
                                "        [Description(\" Date to start the defoliation management (dd/mm/yyyy):\")]",
                                "        public DateTime DefoliationRotationStartDate { get; set; }",
                                "        [Description(\" Date to end the defoliation management (dd/mm/yyyy):\")]",
                                "        public DateTime DefoliationRotationEndDate { get; set; }",
                                "",
                                "        [Separator(\"Parameters defining how the defoliation is managed\")]",
                                "        [Description(\" How the defoliation events should be triggered?\")]",
                                "        public DefoliationTriggerTypes DefoliationTriggerType { get; set; }",
                                "        [Description(\"   Minimum number of days between defoliation events:\")]",
                                "        [Display(VisibleCallback = \"isDefoliationTriggerAnInterval\")]",
                                "        public int IntervalBetweenDefoliations { get; set; }",
                                "        [Description(\"   Minimum standing biomass to trigger a defoliation event (g/m2):\")]",
                                "        [Display(VisibleCallback = \"isDefoliationTriggerAnAmount\")]",
                                "        public double TargetStandingBiomass { get; set; }",
                                "        [Description(\" Duration of each defoliation event (days):\")]",
                                "        public int DurationOfEachDefoliation { get; set; }",
                                "        [Description(\" Which amount is defined to control biomass to be defoliated?\")]",
                                "        public DefoliateAmountTypes RemoveAmountType { get; set; }",
                                "        [Description(\" DM amount to use (g/m2):\")]",
                                "        public double AmountForEachDefoliation { get; set; }",
                                "        [Description(\" Minimum DM amount to remove (g/m2):\")]",
                                "        [Display(VisibleCallback = \"isAmountDMToRemove\")]",
                                "        public double MininumAmountToDefoliate { get; set; }",
                                "",
                                "        [Separator(\" Additional management parameters to control defoliation frequency\")]",
                                "        [Description(\" Suppress defoliations over a period of time within the year?\")]",
                                "        public yesNoAnswer SuppressDefoliationOnWindow { get; set; }",
                                "        [Description(\"   Date to start the defoliation suppression window (dd-mmm):\")]",
                                "        [Display(VisibleCallback = \"suppressingDefoliationOnWindow\")]",
                                "        public string NoDefoliationWindowStartDate { get; set; }",
                                "        [Description(\"   Date to end the defoliation suppression window (dd-mmm):\")]",
                                "        [Display(VisibleCallback = \"suppressingDefoliationOnWindow\")]",
                                "        public string NoDefoliationWindowEndDate { get; set; }",
                                "        [Description(\" Enforce a minimum interval between defoliations?\")]",
                                "        [Display(VisibleCallback = \"isDefoliationTriggerAnAmount\")]",
                                "        public yesNoAnswer EnforceMinimumInterval { get; set; }",
                                "        [Description(\"   Minimum number of days between defoliations:\")]",
                                "        [Display(VisibleCallback = \"minimumIntervalEnforced\")]",
                                "        public int MinimumInterval { get; set; }",
                                "        [Description(\" Enforce a maximum interval between defoliations?\")]",
                                "        [Display(VisibleCallback = \"isTriggerNotFixedInterval\")]",
                                "        public yesNoAnswer EnforceMaximumInterval { get; set; }",
                                "        [Description(\"   Maximum number of days between defoliations:\")]",
                                "        [Display(VisibleCallback = \"maximumIntervalEnforced\")]",
                                "        public int MaximumInterval { get; set; }",
                                "",
                                "        [Separator(\"Parameters defining the management of the defoliated biomass\")]",
                                "        [Description(\" How much of the DM defoliated is to be removed from the field?\")]",
                                "        public DMRemovalTypes DMRemoveType { get; set; }",
                                "        [Description(\"   Fraction of DM to remove off field (0-1):\")]",
                                "        [Display(VisibleCallback = \"userDefinesDMFraction\")]",
                                "        public double FractionDMToRemove { get; set; }",
                                "        [Description(\" How much of the N defoliated is to be removed from the field?\")]",
                                "        public NRemovalTypes NRemoveType { get; set; }",
                                "        [Description(\"   Fraction of N to remove off field (0-1):\")]",
                                "        [Display(VisibleCallback = \"userDefinesNFraction\")]",
                                "        public double FractionNToRemove { get; set; }",
                                "        [Description(\" How the non-removed material is returned to the field?\")]",
                                "        public ReturnAsTypes ReturnType { get; set; }",
                                "",
                                "        [Separator(\"Parameters for partitioning non-removed N into urine and dung\")]",
                                "        [Description(\" How the partition of N to dung and urine is defined?\")]",
                                "        [Display(VisibleCallback = \"returningAsDungUrine\")]",
                                "        public DungNContentTypes NDungType { get; set; }",
                                "        [Description(\"   Proportion of N returned in dung (0-1):\")]",
                                "        [Display(VisibleCallback = \"nitrogenInDungIsProportion\")]",
                                "        public double ProportionOfNToDung { get; set; }",
                                "        [Description(\"   The C:N of dung, if using DefineCNratio (typically around 20):\")]",
                                "        [Display(VisibleCallback = \"nitrogenInDungIsCNRatio\")]",
                                "        public double CNRatioDung { get; set; }",
                                "        [Description(\" Soil depth down to which urine should be applied (mm):\")]",
                                "        [Display(VisibleCallback = \"returningAsDungUrine\")]",
                                "        public double UrineDepth { get; set; }",
                                "",
                                "        [Separator(\"Additional parameters to control N returns\")]",
                                "        [Description(\" Use a fixed N amount in each urine deposition?\")]",
                                "        [Display(VisibleCallback = \"returningAsDungUrine\")]",
                                "        public yesNoAnswer SettingUrineNAmount { get; set; }",
                                "        [Description(\"   Amount of N to apply as \\\"urine\\\" (gN/m2)):\")]",
                                "        [Display(VisibleCallback = \"urineNAmountFixed\")]",
                                "        public double UrineNSetAmount { get; set; }",
                                "",
                                "        [Separator(\" Additional parameters to control effects of defoliations\")]",
                                "        [Description(\" Fraction of population decline in each defoliation (0-1) Not Implemented:\")]",
                                "        public double PopulationDeclineRate { get; set; } = 0.0;",
                                "        [Description(\" Consider effects of trampling on surface OM (litter)?\")]",
                                "        public yesNoAnswer ConsiderTrampling { get; set; }",
                                "        [Description(\" Maximum fraction of litter incorporated to the soil (0-1):\")]",
                                "        [Display(VisibleCallback = \"consideringTrampling\")]",
                                "        public double MaximumLitterFractionToSoil { get; set; }",
                                "        [Description(\" Defoliated biomass for maximum rate of incorporation (g/m2): \\n  (e.g. 90 for heavy cattle, 120 for ewes)\")]",
                                "        [Display(VisibleCallback = \"consideringTrampling\")]",
                                "        public double BiomassDefoliatedForMaximumLitterFraction { get; set; }",
                                "",
                                "        [Separator(\"Additional parameters for computing growth rates\")]",
                                "        [Description(\" Interval over which the mean growth rate will be calculated?\")]",
                                "        public MeanGrowthPeriodTypes MeanGrowthPeriodType { get; set; }",
                                "        [Description(\"  Number of days to compute mean growth rate (maximum):\")]",
                                "        [Display(VisibleCallback = \"growthPeriodToBeGiven\")]",
                                "        public int MaxPeriodForMeanGrowth { get; set; }",
                                "",
                                "        //> Outputs from this manager",
                                "        [JsonIgnore][Units(\"g/m2\")] // Pasture DM that can be consume (removed from plants) today",
                                "        public double ConsumableWt { get; set; }",
                                "        [JsonIgnore][Units(\"g/m2\")] // N in the pasture material that can be consumed today",
                                "        public double ConsumableN { get; set; }",
                                "        [JsonIgnore][Units(\"g/m2\")] // Pasture DM defoliated (removed from plants) today",
                                "        public double DefoliatedWt { get; set; }",
                                "        [JsonIgnore][Units(\"g/m2\")] // N in the pasture material defoliated today",
                                "        public double DefoliatedN { get; set; }",
                                "        [JsonIgnore][Units(\"g/m2\")] // Pasture DM harvested (removed from plants minus direct residue) today",
                                "        public double HarvestedWt { get; set; }",
                                "        [JsonIgnore][Units(\"g/m2\")] // N in the pasture material harvested today",
                                "        public double HarvestedN { get; set; }",
                                "        [JsonIgnore][Units(\"g/m2\")] // Pasture DM actually removed from the field",
                                "        public double RemovedWt { get; set; }",
                                "        [JsonIgnore][Units(\"g/m2\")] // N in the pasture material removed from the field",
                                "        public double RemovedN { get; set; }",
                                "        [JsonIgnore][Units(\"g/m2\")] // Pasture DM returned by this manager to the field",
                                "        public double ReturnedWt { get; set; }",
                                "        [JsonIgnore][Units(\"g/m2\")] // N in the pasture material returned by this manager to the field",
                                "        public double ReturnedN { get; set; }",
                                "        [JsonIgnore][Units(\"g/m2\")] // Non-removed N returned as dung (to SurfaceOM)",
                                "        public double NReturnedInDung { get; set; }",
                                "        [JsonIgnore][Units(\"g/m2\")] // Non-removed N returned as urine (soil urea)",
                                "        public double NReturnedInUrine { get; set; }",
                                "        [JsonIgnore][Units(\"days\")] // Number of days since the end of last defoliation event",
                                "        public int DaysSinceLastDefoliation { get; set; }",
                                "        [JsonIgnore][Units(\"g/m2\")] // Total standing aboveground DM before a defoliation",
                                "        public double PreHarvestDM { get; set; }",
                                "        [JsonIgnore][Units(\"g/m2\")] // Total standing aboveground DM after a defoliation",
                                "        public double PostHarvestDM { get; set; }",
                                "        [JsonIgnore][Units(\"g/m2\")] // Total pasture DM harvested over a complete defoliation event",
                                "        public double RotationHarvestedDM { get; set; }",
                                "        [JsonIgnore][Units(\"g/m2\")] // Mean sward growth rate over a given period before each defoliation",
                                "        public double MeanGrowthRateDM { get; set; }",
                                "",
                                "        //> Internal variables",
                                "        private List<ModelWithDigestibleBiomass> existingForageCrops; // links to the forage interface of each plant organ",
                                "        private LinkedList<double> growthQueue;         // list of daily growth rates over the period to compute mean growth rate",
                                "        private double[] urineFraction;                 // fraction of urine N to be applied in each soil layer",
                                "",
                                "",
                                "",
                                "        ",
                                "",
                                "        [EventSubscribe(\"StartOfSimulation\")]",
                                "        private void OnStartOfSimulation(object sender, EventArgs e)",
                                "        {",
                                "            // check the type of amount given",
                                "            if (RemoveAmountType == DefoliateAmountTypes.DMToRemove)",
                                "            {",
                                "                baseAmountType = \"DMToRemove\";",
                                "            }",
                                "            else if (RemoveAmountType == DefoliateAmountTypes.ResidualDM)",
                                "            {",
                                "                baseAmountType = \"ResidualDM\";",
                                "            }",
                                "",
                                "            // check the interval between events",
                                "            if (IntervalBetweenDefoliations < 1)",
                                "            {",
                                "                throw new Exception(\"The interval between defoliation events must be at least one day\");",
                                "            }",
                                "",
                                "            // check the duration for each defoliation",
                                "            if(DurationOfEachDefoliation <= 0)",
                                "            {",
                                "                throw new Exception(\"The duration of defoliations cannot be zero or negative!\");",
                                "            }",
                                "",
                                "            // check the fraction of defoliated material to remove from the field",
                                "            if (DMRemoveType == DMRemovalTypes.RemoveAll)",
                                "            {",
                                "                FractionDMToRemove = 1.0;",
                                "            }",
                                "            else if (DMRemoveType == DMRemovalTypes.RemoveNone)",
                                "            {",
                                "                FractionDMToRemove = 0.0;",
                                "            }",
                                "            else if (DMRemoveType == DMRemovalTypes.BasedOnDigestibility)",
                                "            {",
                                "                FractionDMToRemove = -1.0;  // will be calculated dynamically",
                                "            }",
                                "            else // DMRemoveType == DMRemovalTypes.UserDefinedFraction",
                                "            {",
                                "                if (FractionDMToRemove < 0.0)",
                                "                {",
                                "                    throw new Exception(\"The fraction of DM defoliated to remove from the field cannot be negative!\");",
                                "                }",
                                "            }",
                                "",
                                "            // check the fraction of defoliated N to remove from the field",
                                "            if (NRemoveType == NRemovalTypes.RemoveAll)",
                                "            {",
                                "                FractionNToRemove = 1.0;",
                                "            }",
                                "            else if (NRemoveType == NRemovalTypes.RemoveNone)",
                                "            {",
                                "                FractionNToRemove = 0.0;",
                                "            }",
                                "            else if (NRemoveType == NRemovalTypes.ProportionalToDM)",
                                "            {",
                                "                FractionNToRemove = FractionDMToRemove;",
                                "            }",
                                "            else // NRemoveType == NRemovalTypes.UserDefinedFraction",
                                "            {",
                                "                if (FractionNToRemove < 0.0)",
                                "                {",
                                "                    throw new Exception(\"The fraction of defoliated N to remove from the field cannot be negative!\");",
                                "                }",
                                "            }",
                                "",
                                "            // get links to the forage interface for each platn organ",
                                "            existingForageCrops = swardForages.ModelsWithDigestibleBiomass.ToList();",
                                "",
                                "            // make sure that management starts when RotationStartDate < simulationStartDay",
                                "            DefoliationRotationEndDate = DefoliationRotationEndDate > clock.EndDate? clock.EndDate: DefoliationRotationEndDate;",
                                "            if ((clock.Today > DefoliationRotationStartDate) && (clock.Today < DefoliationRotationEndDate))",
                                "            {",
                                "                DefoliationRotationStartDate = clock.Today;",
                                "            }",
                                "",
                                "            // initialise some variables",
                                "            growthQueue = new LinkedList<double>();",
                                "            swardPreviousPhenoStage = 1.0;",
                                "            DaysSinceLastDefoliation = 0;",
                                "            durationOfThisDefoliation = -1;",
                                "            daysDefoliating = 0;",
                                "            resetMyOutputs();",
                                "",
                                "            // set the fraction of urine for each layer",
                                "            if (ReturnType == ReturnAsTypes.AsDungUrine)",
                                "            {",
                                "                double depthFromSurface = 0.0;",
                                "                double propAtZ0;",
                                "                double propAtZ1;",
                                "                for (int layer = 0; layer < soilPhysical.Thickness.Length; layer++)",
                                "                {",
                                "                    depthFromSurface += soilPhysical.Thickness[layer];",
                                "                    if (depthFromSurface >= UrineDepth)",
                                "                    { // bottom layer found",
                                "                        urineFraction = new double[layer + 1];",
                                "                        double distFactor = 1.5;",
                                "                        double totalProp = UrineDepth * Math.Pow(1.0, distFactor) / (distFactor + 1.0);",
                                "                        depthFromSurface = 0.0;",
                                "                        propAtZ1 = (UrineDepth - depthFromSurface) * Math.Pow(1.0 - depthFromSurface / UrineDepth, distFactor) / (distFactor + 1.0);",
                                "                        for (int z = 0; z < layer+1; z++)",
                                "                        {",
                                "                            propAtZ0 = propAtZ1;",
                                "                            depthFromSurface += soilPhysical.Thickness[z];",
                                "                            propAtZ1 = (UrineDepth - depthFromSurface) * Math.Pow(1.0 - depthFromSurface / UrineDepth, distFactor) / (distFactor + 1);",
                                "                            if (1.0 - (depthFromSurface / UrineDepth) < 0.0)",
                                "                            {",
                                "                                propAtZ1 = 0;",
                                "                            }",
                                "                            urineFraction[z] = (propAtZ0 - propAtZ1) / totalProp;",
                                "                        }",
                                "                        layer = soilPhysical.Thickness.Length;",
                                "                    }",
                                "                }",
                                "            }",
                                "",
                                "            // write message in summary",
                                "            summary.WriteMessage(this,\" Defoliation manager initialisation\", MessageType.Diagnostic);",
                                "            if (automaticManagementAllowed)",
                                "            {",
                                "                summary.WriteMessage(this, \"   Automatic defoliations will happen between \" + DefoliationRotationStartDate.ToShortDateString()",
                                "                                         + \" and \" + DefoliationRotationEndDate.ToShortDateString() + \".\", MessageType.Diagnostic);",
                                "                if (SuppressDefoliationOnWindow == yesNoAnswer.Yes)",
                                "                {",
                                "                    summary.WriteMessage(this, \"    But they will be suppressed between \" + NoDefoliationWindowStartDate  + \" and \"",
                                "                                               + NoDefoliationWindowEndDate + \".\", MessageType.Diagnostic);",
                                "                }",
                                "",
                                "                summary.WriteMessage(this, \"   Biomass from all species in the sward will be removed if criteria are matched.\", MessageType.Diagnostic);",
                                "                if (DefoliationTriggerType == DefoliationTriggerTypes.TargetStandingBiomass)",
                                "                {",
                                "                    summary.WriteMessage(this, \"   Events will happen whenever aboveground biomass surpasses \" + TargetStandingBiomass.ToString(\"#0.0\") + \" g/m2.\", MessageType.Diagnostic);",
                                "                    if(EnforceMinimumInterval == yesNoAnswer.Yes)",
                                "                    {",
                                "                        summary.WriteMessage(this, \"     With a minimum of \" + MinimumInterval + \" days between defoliations\", MessageType.Diagnostic);",
                                "                    }",
                                "                    if(EnforceMaximumInterval == yesNoAnswer.Yes)",
                                "                    {",
                                "                        summary.WriteMessage(this, \"     With a maximum of \" + MaximumInterval + \" days between defoliations\", MessageType.Diagnostic);",
                                "                    }",
                                "                }",
                                "                else",
                                "                {",
                                "                    summary.WriteMessage(this, \"   Events will happen every \" + IntervalBetweenDefoliations + \" days, if there is enough biomass.\", MessageType.Diagnostic);",
                                "                }",
                                "",
                                "                if(baseAmountType == \"ResidualDM\")",
                                "                {",
                                "                    summary.WriteMessage(this, \"   Removing biomass down to a residual amount of \" + AmountForEachDefoliation.ToString(\"#.0\") + \" g/m2 over \"",
                                "                                             + DurationOfEachDefoliation + \" days.\", MessageType.Diagnostic);",
                                "                }",
                                "                else",
                                "                {",
                                "                    summary.WriteMessage(this, \"   Attempting to remove \" + AmountForEachDefoliation.ToString(\"#.0\") + \" g/m2 of biomass per day over \"",
                                "                                             + DurationOfEachDefoliation + \" days.\", MessageType.Diagnostic);",
                                "                }",
                                "            }",
                                "            else",
                                "            {",
                                "                summary.WriteMessage(this,\"   Automatic defoliations are currently disabled, though defoliations can be triggered by another manager\", MessageType.Diagnostic);",
                                "            }",
                                "",
                                "            if(ReturnType == ReturnAsTypes.AsDungUrine)",
                                "            {",
                                "                summary.WriteMessage(this,\"   Non-removed material will be returned as dung and urine. Urine added to soil according to proportions: \"",
                                "                                         + string.Join(\", \",urineFraction), MessageType.Diagnostic);",
                                "            }",
                                "            else",
                                "            {",
                                "                summary.WriteMessage(this,\"   Non-removed material will be returned as residue.\", MessageType.Diagnostic);",
                                "            }",
                                "        }",
                                "",
                                "        [EventSubscribe(\"DoManagement\")]",
                                "        private void OnDoManagement(object sender, EventArgs e)",
                                "        {",
                                "            // get the biomass available for defoliation",
                                "            ConsumableWt = harvestableSwardBiomassWt(\"All\");",
                                "            ConsumableN = harvestableSwardBiomassN(\"All\");",
                                "",
                                "            // check whether we need to continue defoliating, i.e. within a multi-day defoliation event (need to check this first in the day)",
                                "            if ((daysDefoliating > 0) && (daysDefoliating < durationOfThisDefoliation))",
                                "            {",
                                "                // reset outputs",
                                "                resetMyOutputs();",
                                "",
                                "                // re-check the amount to defoliate",
                                "                herbageToRemove = 0.0;",
                                "                if (currentAmountType == \"DMToRemove\")",
                                "                {",
                                "                    if(ConsumableWt > currentMinAmount + 0.001)",
                                "                    {",
                                "                        herbageToRemove = Math.Min(ConsumableWt, (currentAmountForDefoliation - cumAmountHarvested) / (durationOfThisDefoliation - daysDefoliating));",
                                "                    }",
                                "                }",
                                "                else if (currentAmountType == \"ResidualDM\")",
                                "                {",
                                "                    double currentDM = standingSwardBiomassWt;",
                                "                    if (currentDM > currentAmountForDefoliation)",
                                "                    {",
                                "                        herbageToRemove = Math.Min(ConsumableWt, (currentDM - currentAmountForDefoliation) / (durationOfThisDefoliation - daysDefoliating));",
                                "                    }",
                                "                }",
                                "",
                                "                // remove plant biomass and return residue",
                                "                if (Math.Abs(herbageToRemove) >= 0.001)",
                                "                {",
                                "                    // set biomass removal",
                                "                    defoliateSward(herbageToRemove);",
                                "",
                                "                    // return residue or excreta",
                                "                    if(ReturnedWt + ReturnedN > 0.0)",
                                "                    {",
                                "                        if (ReturnType == ReturnAsTypes.AsResidue)",
                                "                        {",
                                "                            returnResidues();",
                                "                        }",
                                "                        else",
                                "                        {",
                                "                            returnExcreta();",
                                "                        }",
                                "                    }",
                                "",
                                "                    // consider trampling effect on surface OM",
                                "                    if (consideringTrampling)",
                                "                    {",
                                "                        doTrampling();",
                                "                    }",
                                "",
                                "                    // gather amount removed this event",
                                "                    cumAmountHarvested += HarvestedWt;",
                                "                }",
                                "",
                                "                daysDefoliating += 1;",
                                "            }",
                                "",
                                "            // check whether a defoliation ended yesterday",
                                "            if (daysDefoliating < 0)",
                                "            { // clean up variables",
                                "                resetMyOutputs();",
                                "                daysDefoliating = 0;",
                                "            }",
                                "",
                                "            // check whether automatic defoliations are enabled",
                                "            if (automaticManagementAllowed)",
                                "            {",
                                "                // check whether we are within the period in which defoliation management is allowed",
                                "                if ((clock.Today.Date >= DefoliationRotationStartDate.Date) && (clock.Today.Date <= DefoliationRotationEndDate.Date))",
                                "                {",
                                "                    // check whether the sward has plants alive that could be defoliated",
                                "                    if (swardHasLivingPlants)",
                                "                    {",
                                "                        // check whether the day counter to control defoliation interval needs to be set",
                                "                        if (clock.Today.Date == DefoliationRotationStartDate.Date)",
                                "                        { // set to the maximum interval, so a defoliation is triggered today",
                                "                            if(isDefoliationTriggerAnAmount)",
                                "                            {",
                                "                                if(EnforceMaximumInterval == yesNoAnswer.Yes)",
                                "                                {",
                                "                                    DaysSinceLastDefoliation = MaximumInterval;",
                                "                                }",
                                "                            }",
                                "                            else",
                                "                            {",
                                "                                DaysSinceLastDefoliation = IntervalBetweenDefoliations;",
                                "                            }",
                                "                        }",
                                "",
                                "                        // check whether the day counter to control defoliation interval needs to be set off",
                                "                        double swardCurrentPhenoStage = swardPhenologyStage;",
                                "                        if ((swardPreviousPhenoStage < 1.0) && (swardCurrentPhenoStage >= 1.0))",
                                "                        { // sward was sown and has just emmerged, pretend a defoliation has happened to set the counter going",
                                "                            aDefoliationHasHappened = true;",
                                "                            DaysSinceLastDefoliation -= 30; // give an extra month for the pasture to grow (on top of 'normal' interval)",
                                "                        }",
                                "                        swardPreviousPhenoStage = swardCurrentPhenoStage;",
                                "",
                                "                        // check whether a window for suppressing defoliations has been set",
                                "                        if (suppressingDefoliationOnWindow && DateUtilities.WithinDates(NoDefoliationWindowStartDate, clock.Today, NoDefoliationWindowEndDate))",
                                "                        { // do nothing as we're within the suppression window",
                                "                        }",
                                "                        else",
                                "                        {",
                                "                            // check whether we should start a defoliation event",
                                "                            if (DefoliationTriggerType == DefoliationTriggerTypes.FixedInterval)",
                                "                            {",
                                "                                if (DaysSinceLastDefoliation == IntervalBetweenDefoliations)",
                                "                                {",
                                "                                    Defoliate(AmountForEachDefoliation, baseAmountType, DurationOfEachDefoliation, MininumAmountToDefoliate, \"yes\");",
                                "                                }",
                                "                            }",
                                "                            else if (DefoliationTriggerType == DefoliationTriggerTypes.TargetInterval)",
                                "                            {",
                                "                                if (DaysSinceLastDefoliation >= IntervalBetweenDefoliations)",
                                "                                {",
                                "                                    if(EnforceMaximumInterval == yesNoAnswer.Yes && (DaysSinceLastDefoliation >= MaximumInterval))",
                                "                                    { // start a defoliation even if biomass is insufficient",
                                "                                        Defoliate(AmountForEachDefoliation, baseAmountType, DurationOfEachDefoliation, MininumAmountToDefoliate, \"yes\");",
                                "                                    }",
                                "                                    else",
                                "                                    {",
                                "                                        Defoliate(AmountForEachDefoliation, baseAmountType, DurationOfEachDefoliation, MininumAmountToDefoliate, \"no\");",
                                "                                    }",
                                "                                }",
                                "                            }",
                                "                            else  //DefoliationTriggerType == DefoliationTriggerTypes.TargetStandingBiomass",
                                "                            {",
                                "                                if (standingSwardBiomassWt >= TargetStandingBiomass)",
                                "                                {",
                                "                                    if(EnforceMinimumInterval == yesNoAnswer.Yes)",
                                "                                    { // check interval between defoliations",
                                "                                        if(DaysSinceLastDefoliation >= MinimumInterval)",
                                "                                        { // sufficient days passed since last defoliation",
                                "                                            Defoliate(AmountForEachDefoliation, baseAmountType, DurationOfEachDefoliation, 0.0, \"no\");",
                                "                                        }",
                                "                                        //else wait for minimum interval",
                                "                                    }",
                                "                                    else",
                                "                                    { // no checks, just defoliate",
                                "                                        Defoliate(AmountForEachDefoliation, baseAmountType, DurationOfEachDefoliation, 0.0, \"no\");",
                                "                                    }",
                                "                                }",
                                "                                else",
                                "                                {",
                                "                                    if(EnforceMaximumInterval == yesNoAnswer.Yes && (DaysSinceLastDefoliation >= MaximumInterval))",
                                "                                    { // start a defoliation even if biomass is insufficient",
                                "                                        Defoliate(AmountForEachDefoliation, baseAmountType, DurationOfEachDefoliation, 0.0, \"yes\");",
                                "                                    }",
                                "                                }",
                                "                            }",
                                "                        }",
                                "                    }",
                                "                }",
                                "                //// Note: Only the code above, responsible for triggering automatic events, is limited by 'AllowAutomaticManagement'.",
                                "                ////       The rest of the code is still available to perform one-off defoliations.",
                                "                ////       It can be called from another manager or a schedule thingy via Defoliate().",
                                "            }",
                                "        }",
                                "",
                                "        [EventSubscribe(\"DoManagementCalculations\")]",
                                "        private void OnDoManagementCalculations(object sender, EventArgs e)",
                                "        {",
                                "            // check whether a defoliation event has just been completed",
                                "            if (daysDefoliating == durationOfThisDefoliation)",
                                "            {",
                                "                // get amount of biomass remaining and zero counters",
                                "                PostHarvestDM = currentPostHarvest;",
                                "                RotationHarvestedDM = cumAmountHarvested;",
                                "                aDefoliationHasHappened = true;",
                                "                daysDefoliating = -1;",
                                "",
                                "                // compute the mean growth rate for the queued period",
                                "                MeanGrowthRateDM = MathUtilities.Average(growthQueue.ToArray());",
                                "                growthQueue.Clear();",
                                "            }",
                                "",
                                "            // count the days after a defoliation",
                                "            if (aDefoliationHasHappened && (daysDefoliating == 0))",
                                "            {",
                                "                DaysSinceLastDefoliation += 1;",
                                "            }",
                                "",
                                "            // update the list holding growth rates",
                                "            updateGrowthQueue();",
                                "        }",
                                "",
                                "        [EventSubscribe(\"EndOfDay\")]",
                                "        private void OnEndOfDay(object sender, EventArgs e)",
                                "        {",
                                "            // send a 'message' to let models know that a defoliation has ended today (mostly for report)",
                                "            if ((daysDefoliating < 0) && (DefoliationHappenedToday != null))",
                                "            {",
                                "                DefoliationHappenedToday.Invoke(this, args);",
                                "            }",
                                "        }",
                                "",
                                "        /// <summary>Sets up a defoliation event.</summary>",
                                "        /// <param name=\"amountDM\">Amount of biomass to use (g/m2)</param>",
                                "        /// <param name=\"amountType\">How the DM amount is interpreted (DMToRemove, ResidualDM)</param>",
                                "        /// <param name=\"duration\">Number of days to defoliate over</param>",
                                "        /// <param name=\"minAmount\">Minimum amount that can be removed, if using DMToRemove</param>",
                                "        /// <param name=\"mustDo\">Flag whether a defoliation must be counted as such even if there is no biomass</param>",
                                "        public void Defoliate(double amountDM, string amountType, int duration = 1, double minAmount = 0.0, string mustDo = \"yes\")",
                                "        {",
                                "            // check whether there are plants in the sward that can be defoliated",
                                "            if (swardHasLivingPlants)",
                                "            {",
                                "                // check DM amount given",
                                "                if (amountDM < 0.0)",
                                "                {",
                                "                    throw new Exception(\"Amount to defoliate cannot be negative!\");",
                                "                }",
                                "                else",
                                "                {",
                                "                    currentAmountForDefoliation = amountDM;",
                                "                }",
                                "                currentMinAmount = Math.Max(minAmount, 0.0);",
                                "",
                                "                // check the type of amount given",
                                "                if (amountType.ToLower() == \"dmtoremove\")",
                                "                {",
                                "                    currentAmountType = \"DMToRemove\";",
                                "                }",
                                "                else if (amountType.ToLower() == \"residualdm\")",
                                "                {",
                                "                    currentAmountType = \"ResidualDM\";",
                                "                }",
                                "                else",
                                "                {",
                                "                    throw new Exception(\"Amount type should be \\\"DMToRemove\\\" or \\\"ResidualDM\\\"!\");",
                                "                }",
                                "",
                                "                // check duration given",
                                "                if (duration <= 0)",
                                "                {",
                                "                    throw new Exception(\"Duration of defoliation cannot be zero or negative!\");",
                                "                }",
                                "                else",
                                "                {",
                                "                    durationOfThisDefoliation = duration;",
                                "                }",
                                "",
                                "                // check existing biomass and amount to remove",
                                "                PreHarvestDM = standingSwardBiomassWt;",
                                "                herbageToRemove = 0.0;",
                                "                double harvestableBiomass = harvestableSwardBiomassWt(\"All\");",
                                "                if (currentAmountType == \"DMToRemove\")",
                                "                {",
                                "                    if (currentAmountForDefoliation > 0.001)",
                                "                    { // a meaningful amount was given, check how much can be removed",
                                "                        if (harvestableBiomass > minAmount + 0.001)",
                                "                        {",
                                "                            herbageToRemove = Math.Min(harvestableBiomass, currentAmountForDefoliation / durationOfThisDefoliation);",
                                "                        }",
                                "",
                                "                        summary.WriteMessage(this, \"   Defoliation triggered, attempting to remove \" + currentAmountForDefoliation.ToString(\"#0.0\") + \" g/m2 of biomass over \" + durationOfThisDefoliation + \" days\", MessageType.Diagnostic);",
                                "                    }",
                                "                }",
                                "                else if (currentAmountType == \"ResidualDM\")",
                                "                {",
                                "                    // check how much biomass will be removed",
                                "                    if (PreHarvestDM > currentAmountForDefoliation)",
                                "                    {",
                                "                        herbageToRemove = Math.Min(harvestableBiomass, (PreHarvestDM - currentAmountForDefoliation) / durationOfThisDefoliation);",
                                "                    }",
                                "",
                                "                    summary.WriteMessage(this, \"   Defoliation triggered, attempting to remove biomass down to \" + currentAmountForDefoliation.ToString(\"#0.0\") + \" g/m2 over \" + durationOfThisDefoliation + \" days\", MessageType.Diagnostic);",
                                "                }",
                                "",
                                "                // can defoliation begin?",
                                "                if (Math.Abs(herbageToRemove) >= 0.001)",
                                "                {",
                                "                    // set off first defoliation",
                                "                    defoliateSward(herbageToRemove);",
                                "",
                                "                    // return residue or excreta",
                                "                    if(ReturnedWt + ReturnedN > 0.0)",
                                "                    {",
                                "                        if (ReturnType == ReturnAsTypes.AsResidue)",
                                "                        {",
                                "                            returnResidues();",
                                "                        }",
                                "                        else",
                                "                        {",
                                "                            returnExcreta();",
                                "                        }",
                                "                    }",
                                "",
                                "                    // consider trampling effect on surface OM",
                                "                    if (consideringTrampling)",
                                "                    {",
                                "                        doTrampling();",
                                "                    }",
                                "",
                                "                    // gather values for this event",
                                "                    cumAmountHarvested = HarvestedWt;",
                                "                    currentPostHarvest = standingSwardBiomassWt;",
                                "                    daysDefoliating = 1;",
                                "                    DaysSinceLastDefoliation = 0;",
                                "                }",
                                "                else",
                                "                {",
                                "                    // abort command as there is not enough biomass, except...",
                                "                    if (mustDo.ToLower() == \"yes\")",
                                "                    { // count the event as if it did happen",
                                "                        cumAmountHarvested = 0.0;",
                                "                        currentPostHarvest = standingSwardBiomassWt;",
                                "                        daysDefoliating = 1;",
                                "                        DaysSinceLastDefoliation = 0;",
                                "                        summary.WriteMessage(this, \"   Defoliation triggered but no biomass was removed (total harvestable = \" + harvestableBiomass.ToString(\"#0.0\") + \" g/m2)\", MessageType.Diagnostic);",
                                "                    }",
                                "                    else",
                                "                    {",
                                "                        summary.WriteMessage(this, \"   Defoliation did not happen because current biomass (\" + PreHarvestDM.ToString(\"#0.0\") + \" g/m2) is too low (total harvestable = \" + harvestableBiomass.ToString(\"#0.0\") + \" g/m2)\", MessageType.Diagnostic);",
                                "                    }",
                                "                }",
                                "            }",
                                "            else",
                                "            {",
                                "                summary.WriteMessage(this, \"   Defoliation did not happen because there is no growing plants in the sward\", MessageType.Diagnostic);",
                                "            }",
                                "        }",
                                "",
                                "        /// <summary>Resets the values of outputs.</summary>",
                                "        private void resetMyOutputs()",
                                "        {",
                                "            DefoliatedWt = 0.0;",
                                "            DefoliatedN = 0.0;",
                                "            HarvestedWt = 0.0;",
                                "            HarvestedN = 0.0;",
                                "            RemovedWt = 0.0;",
                                "            RemovedN = 0.0;",
                                "            ReturnedWt = 0.0;",
                                "            ReturnedN = 0.0;",
                                "            NReturnedInDung = 0.0;",
                                "            NReturnedInUrine = 0.0;",
                                "            RotationHarvestedDM = 0.0;",
                                "            MeanGrowthRateDM = 0.0;",
                                "        }",
                                "",
                                "        /// <summary>Updates the lists holding data to compute mean growth rate.</summary>",
                                "        private void updateGrowthQueue()",
                                "        {",
                                "            growthQueue.AddFirst(todaysBiomassGrowthWt);",
                                "            if (MeanGrowthPeriodType != MeanGrowthPeriodTypes.BetweenDefoliations)",
                                "            {",
                                "               if (growthQueue.Count > MaxPeriodForMeanGrowth)",
                                "               { // Max period reached, need to remove last value in the queue",
                                "                   growthQueue.RemoveLast();",
                                "               }",
                                "            }",
                                "        }",
                                "",
                                "        /// <summary>Flags whether there is any living plant in the sward.</summary>",
                                "        private bool swardHasLivingPlants",
                                "        {",
                                "            get",
                                "            {",
                                "                bool result = false;",
                                "                foreach (IPlant species in existingCrops)",
                                "                {",
                                "                    result |= species.IsAlive;",
                                "                }",
                                "",
                                "                return result;",
                                "            }",
                                "        }",
                                "",
                                "        /// <summary>Gets the phenology stage of the most developed plant in the sward.</summary>",
                                "        private double swardPhenologyStage",
                                "        {",
                                "            get",
                                "            {",
                                "                double result = 0.0;",
                                "                foreach (Plant species in   Structure.FindChildren<Plant>(relativeTo: (INodeModel)myZone).OfType<IModel>().ToList())",
                                "                {",
                                "                    if (species.IsAlive)",
                                "                    {",
                                "                        result = Math.Max(result, (double)Structure.Get(species.Name+\".Phenology.Stage\", relativeTo: myZone));",
                                "                    }",
                                "                }",
                                "",
                                "                foreach (AgPasture.PastureSpecies species in   Structure.FindChildren<AgPasture.PastureSpecies>(relativeTo: (INodeModel)myZone).OfType<IModel>().ToList())",
                                "                {",
                                "                    if (species.IsAlive)",
                                "                    {",
                                "                        result = Math.Max(result, species.Stage);",
                                "                    }",
                                "                }",
                                "",
                                "                return result;",
                                "            }",
                                "        }",
                                "",
                                "        /// <summary>Amount of plant biomass aboveground (g/m2).</summary>",
                                "        private double standingSwardBiomassWt",
                                "        {",
                                "            get",
                                "            {",
                                "                double result = 0.0;",
                                "                foreach (IPlant species in existingCrops)",
                                "                {",
                                "                   result += species.AboveGround.Wt;",
                                "                }",
                                "",
                                "                return result;",
                                "            }",
                                "        }",
                                "",
                                "        /// <summary>Amount of N in plant's biomass aboveground (g/m2).</summary>",
                                "        private double standingSwardBiomassN",
                                "        {",
                                "            get",
                                "            {",
                                "                double result = 0.0;",
                                "                foreach (IPlant species in existingCrops)",
                                "                {",
                                "                    result += species.AboveGround.N;",
                                "                }",
                                "",
                                "                return result;",
                                "            }",
                                "        }",
                                "",
                                "        /// <summary>Amount of plant biomass from all organs available for defoliation (g/m2).</summary>",
                                "        /// <remarks>Uses the fractions set in 'Forages' model.</remarks>",
                                "        /// <param name=\"plantName\">The name of the plant to retrieve its biomass</param>",
                                "        private double harvestableSwardBiomassWt(string plantName)",
                                "        {",
                                "            double amountWt = 0.0;",
                                "            foreach (var forage in existingForageCrops) ",
                                "            {",
                                "                foreach (var forageMaterial in forage.Material)",
                                "                {",
                                "                    string forageName = forageMaterial.Name.Split('.')[0];",
                                "                    if ((plantName == \"All\") || (forageName == plantName))",
                                "                    {",
                                "                        amountWt += forageMaterial.Consumable.Wt;",
                                "                    }",
                                "                }",
                                "            }",
                                "",
                                "            return amountWt;",
                                "        }",
                                "",
                                "        /// <summary>Amount of N in plant biomass available for defoliation (g/m2).</summary>",
                                "        /// <remarks>Uses the fractions set in 'Forages' model.</remarks>",
                                "        /// <param name=\"plantName\">The name of the plant to retrieve its biomass</param>",
                                "        private double harvestableSwardBiomassN(string plantName)",
                                "        {",
                                "            double amountN = 0.0;",
                                "            foreach (var forage in existingForageCrops) ",
                                "            {",
                                "                foreach (var forageMaterial in forage.Material)",
                                "                {",
                                "                    string forageName = forageMaterial.Name.Split('.')[0];",
                                "                    if ((plantName == \"All\") || (forageName == plantName))",
                                "                    {",
                                "                        amountN += forageMaterial.Consumable.N;",
                                "                    }",
                                "                }",
                                "            }",
                                "",
                                "            return amountN;",
                                "        }",
                                "",
                                "        /// <summary>Gets the sward growth rate of aboveground biomass for today (g/m2).</summary>",
                                "        private double todaysBiomassGrowthWt",
                                "        {",
                                "            get",
                                "            {",
                                "                double result = 0.0;",
                                "                foreach (IPlant species in existingCrops)",
                                "                {",
                                "                    if (species.GetType().ToString().Contains(\"PMF\"))",
                                "                    { // a PMF plant",
                                "                        foreach (IOrgan organ in Structure.FindChildren<IOrgan>(relativeTo: species as INodeModel, recurse: true).OfType<IModel>().ToList())                        ",
                                "                        {",
                                "                            string speciesName = (species as Plant).Name;",
                                "                            if ((bool)Structure.Get(speciesName + \".\" + organ.Name + \".IsAboveGround\", relativeTo: myZone))",
                                "                            {",
                                "                                result += (double)Structure.Get(speciesName + \".\" + organ.Name + \".Allocated.Wt\", relativeTo: myZone);",
                                "                                result -= (double)Structure.Get(speciesName + \".\" + organ.Name + \".Detached.Wt\", relativeTo: myZone);",
                                "                            }",
                                "                        }",
                                "                    }",
                                "                    else",
                                "                    { // an AgPasture plant",
                                "                        result += (species as PastureSpecies).HerbageGrowthWt*0.1;",
                                "                    }",
                                "                }",
                                "",
                                "                return result;",
                                "            }",
                                "        }",
                                "",
                                "        /// <summary>Triggers the actual biomass removal and gather DM and N amounts.</summary>",
                                "        /// <param name=\"amountToRemove\">The total DM amount to remove (g/m2)</param>",
                                "        private void defoliateSward(double amountToRemove)",
                                "        {",
                                "            // get the amounts of biomass and N before today's defoliation",
                                "            double preRemovalDM = standingSwardBiomassWt;",
                                "            double preRemovalN = standingSwardBiomassN;",
                                "            double totalHarvestableAmount = harvestableSwardBiomassWt(\"All\");",
                                "",
                                "            // zero the outputs, just in case",
                                "            DefoliatedWt = 0.0;",
                                "            DefoliatedN = 0.0;",
                                "            HarvestedWt = 0.0;",
                                "            HarvestedN = 0.0;",
                                "            RemovedWt = 0.0;",
                                "            RemovedN = 0.0;",
                                "",
                                "            // go over each forage species and organ and remove biomass",
                                "            foreach (var forage in existingForageCrops)",
                                "            {",
                                "                if(forage.Material.Count() > 0)",
                                "                {",
                                "                    // do the biomass removal/harvest",
                                "                    double speciesOrganFraction = forage.Material.Sum(m => m.Consumable.Wt)*0.1/totalHarvestableAmount;",
                                "                    double removeAmount = amountToRemove*speciesOrganFraction*10.0;",
                                "",
                                "                    if (removeAmount > 0.0)",
                                "                    {",
                                "                        var forageDefoliated = forage.RemoveBiomass(amountToRemove: removeAmount);",
                                "",
                                "                        // gather the amounts harvested (i.e. defoliated minus returned to residues)",
                                "                        HarvestedWt += forageDefoliated.Wt*0.1;",
                                "                        HarvestedN += forageDefoliated.N*0.1;",
                                "",
                                "                        // check the fraction of defoliated biomass to be taken off field",
                                "                        double removeFractionDM = FractionDMToRemove;",
                                "                        double removeFractionN = FractionNToRemove;",
                                "                        if(FractionDMToRemove < 0.0)",
                                "                        { // use digestibility to define the fraction",
                                "                            removeFractionDM = forageDefoliated.Digestibility;",
                                "",
                                "                            // check whether N fraction is proportional to DM",
                                "                            if (FractionNToRemove < 0.0)",
                                "                            {",
                                "                                removeFractionN = removeFractionDM;",
                                "                            }",
                                "                        }",
                                "",
                                "                        // get the amounts actually removed from the field",
                                "                        RemovedWt += forageDefoliated.Wt*0.1*removeFractionDM;",
                                "                        RemovedN += forageDefoliated.N*0.1*removeFractionN;",
                                "                    }",
                                "                }",
                                "            }",
                                "",
                                "            // get the amounts of biomass and N after today's defoliation",
                                "            double postRemovalDM = standingSwardBiomassWt;",
                                "            double postRemovalN = standingSwardBiomassN;",
                                "",
                                "            // get total defoliation (total plant stuff lost)",
                                "            DefoliatedWt = preRemovalDM - postRemovalDM;",
                                "            DefoliatedN = preRemovalN - postRemovalN;",
                                "",
                                "            // get amounts harvested, removed, and returned",
                                "            manageDefoliatedBiomass();",
                                "        }",
                                "",
                                "        /// <summary>Gathers the DM and N amounts harvested, to be removed, and to be returned.</summary>",
                                "        private void manageDefoliatedBiomass()",
                                "        {",
                                "            if (HarvestedWt > 0.0)",
                                "            {",
                                "                // get the amounts to be returned to the field (as residue or dung+urine)",
                                "                ReturnedWt = HarvestedWt - RemovedWt;",
                                "                ReturnedN = HarvestedN - RemovedN;",
                                "                if (returningAsDungUrine)",
                                "                {",
                                "                    if (nitrogenInDungIsProportion)",
                                "                    {",
                                "                        NReturnedInDung = ReturnedN * ProportionOfNToDung;",
                                "                    }",
                                "                    else",
                                "                    {",
                                "                        NReturnedInDung = Math.Min(ReturnedN, ReturnedWt * 0.4 / CNRatioDung);",
                                "                    }",
                                "",
                                "                    NReturnedInDung = Math.Min(NReturnedInDung, ReturnedN);",
                                "                    NReturnedInUrine = ReturnedN - NReturnedInDung;",
                                "",
                                "                    if(urineNAmountFixed)",
                                "                    { // urine N to return is set in UI",
                                "                        NReturnedInUrine = UrineNSetAmount;",
                                "                    }",
                                "                }",
                                "                else",
                                "                {",
                                "                    NReturnedInDung = 0.0;",
                                "                    NReturnedInUrine = 0.0;",
                                "                }",
                                "            }",
                                "        }",
                                "",
                                "        /// <summary>Returns the material not removed off field as residue.</summary>",
                                "        private void returnResidues()",
                                "        {",
                                "            if ((ReturnedWt > 0.0) || (ReturnedN > 0.0))",
                                "            {",
                                "                PMF.BiomassRemovedType BiomassResidue = new PMF.BiomassRemovedType();",
                                "                string[] type = new string[] { \"Grass\" };",
                                "                float[] dltdm = new float[] { (float)(10.0 * ReturnedWt) };",
                                "                float[] dltn = new float[] { (float)(10.0 * ReturnedN) };",
                                "                float[] dltp = new float[] { 0.0f };",
                                "                float[] fraction = new float[] { 1.0f };     // fraction is always 1.0 here",
                                "",
                                "                BiomassResidue.crop_type = \"Grass\";",
                                "                BiomassResidue.dm_type = type;",
                                "                BiomassResidue.dlt_crop_dm = dltdm;",
                                "                BiomassResidue.dlt_dm_n = dltn;",
                                "                BiomassResidue.dlt_dm_p = dltp;",
                                "                BiomassResidue.fraction_to_residue = fraction;",
                                "                BiomassRemoved.Invoke(BiomassResidue);",
                                "            }",
                                "        }",
                                "",
                                "        /// <summary>Returns the material not removed off field as dung and urine).</summary>",
                                "        private void returnExcreta()",
                                "        {",
                                "            if ((ReturnedWt > 0.0) || (NReturnedInDung > 0.0))",
                                "            {",
                                "                PMF.BiomassRemovedType BiomassDung = new PMF.BiomassRemovedType();",
                                "                string[] type = new string[] { \"RuminantDung_PastureFed\" };",
                                "                float[] dltdm = new float[] { (float)(10.0 * ReturnedWt) };",
                                "                float[] dltn = new float[] { (float)(10.0 * NReturnedInDung) };",
                                "                float[] dltp = new float[] { 0.0f };",
                                "                float[] fraction = new float[] { 1.0f };     // fraction is always 1.0 here",
                                "",
                                "                BiomassDung.crop_type = \"RuminantDung_PastureFed\";",
                                "                BiomassDung.dm_type = type;",
                                "                BiomassDung.dlt_crop_dm = dltdm;",
                                "                BiomassDung.dlt_dm_n = dltn;",
                                "                BiomassDung.dlt_dm_p = dltp;",
                                "                BiomassDung.fraction_to_residue = fraction;",
                                "                BiomassRemoved.Invoke(BiomassDung);",
                                "            }",
                                "",
                                "            if (NReturnedInUrine > 0.0)",
                                "            {",
                                "                double[] myUrineDeposition = new double[soilPhysical.Thickness.Length];",
                                "                for (int z = 0; z < urineFraction.Length; z++)",
                                "                {",
                                "                    myUrineDeposition[z] = NReturnedInUrine * 10.0 * urineFraction[z];",
                                "                }",
                                "",
                                "                Urea.AddKgHaDelta(SoluteSetterType.Fertiliser, myUrineDeposition);",
                                "            }",
                                "        }",
                                "",
                                "        /// <summary>Incorporate a fraction of surface OM material to the soil surface layer.</summary>",
                                "        /// <remarks>Assumes that trampling is proportional to the amount defoliated.</remarks>",
                                "        private void doTrampling(double fractionToIncorporate = 0.0)",
                                "        {",
                                "            if (DefoliatedWt > 0.0)",
                                "            {",
                                "                fractionToIncorporate = Math.Min(BiomassDefoliatedForMaximumLitterFraction/DefoliatedWt, MaximumLitterFractionToSoil);",
                                "                surfaceOM.Incorporate(fraction: fractionToIncorporate, depth: 100);",
                                "            }",
                                "        }",
                                "",
                                "        // Auxiliary boolead for UI  - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -",
                                "",
                                "        private bool automaticManagementAllowed",
                                "        { get { return AllowAutomaticManagement == yesNoAnswer.Yes; } }",
                                "        private bool isDefoliationTriggerAnInterval",
                                "        { get { return DefoliationTriggerType != DefoliationTriggerTypes.TargetStandingBiomass; } }",
                                "        private bool isTriggerNotFixedInterval",
                                "        { get { return DefoliationTriggerType != DefoliationTriggerTypes.FixedInterval; } }",
                                "        private bool isDefoliationTriggerAnAmount",
                                "        { get { return DefoliationTriggerType == DefoliationTriggerTypes.TargetStandingBiomass; } }",
                                "        private bool isAmountDMToRemove",
                                "        { get { return RemoveAmountType == DefoliateAmountTypes.DMToRemove; } }",
                                "        private bool suppressingDefoliationOnWindow",
                                "        { get { return SuppressDefoliationOnWindow == yesNoAnswer.Yes; } }",
                                "        private bool minimumIntervalEnforced",
                                "        { get { return isDefoliationTriggerAnAmount && (EnforceMinimumInterval == yesNoAnswer.Yes); } }",
                                "        private bool maximumIntervalEnforced",
                                "        { get { return isTriggerNotFixedInterval && (EnforceMaximumInterval == yesNoAnswer.Yes); } }",
                                "        private bool userDefinesDMFraction",
                                "        { get { return DMRemoveType == DMRemovalTypes.UserDefinedFraction; } }",
                                "        private bool userDefinesNFraction",
                                "        { get { return NRemoveType == NRemovalTypes.UserDefinedFraction; } }",
                                "        private bool returningAsDungUrine",
                                "        { get { return ReturnType == ReturnAsTypes.AsDungUrine; } }",
                                "        private bool nitrogenInDungIsProportion",
                                "        { get { return returningAsDungUrine && (NDungType == DungNContentTypes.DefineProportion); } }",
                                "        private bool nitrogenInDungIsCNRatio",
                                "        { get { return returningAsDungUrine && (NDungType == DungNContentTypes.DefineCNratio); } }",
                                "        private bool urineNAmountFixed",
                                "        { get { return SettingUrineNAmount == yesNoAnswer.Yes; } }",
                                "        private bool growthPeriodToBeGiven",
                                "        { get { return MeanGrowthPeriodType != MeanGrowthPeriodTypes.BetweenDefoliations; } }",
                                "        private bool consideringTrampling",
                                "        { get { return ConsiderTrampling == yesNoAnswer.Yes;} }",
                                "",
                                "        // Auxiliary bits and pieces  - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -",
                                "",
                                "        /// <summary>Flag for a positive or negative answer.</summary>",
                                "        public enum yesNoAnswer",
                                "        {",
                                "            /// <summary>Positive answer.</summary>",
                                "            Yes,",
                                "            /// <summary>Negative answer.</summary>",
                                "            No",
                                "        }",
                                "",
                                "        /// <summary>Flag how defoliations will be triggered.</summary>",
                                "        public enum DefoliationTriggerTypes",
                                "        {",
                                "            /// <summary>Setting a fixed interval.</summary>",
                                "            FixedInterval,",
                                "            /// <summary>Setting a target (minimum) interval.</summary>",
                                "            TargetInterval,",
                                "            /// <summary>Setting a target (maximum) standing biomass.</summary>",
                                "            TargetStandingBiomass",
                                "        }",
                                "",
                                "        /// <summary>How the DM amount given is interpreted.</summary>",
                                "        public enum DefoliateAmountTypes",
                                "        {",
                                "            /// <summary>Setting a DM amount to remove.</summary>",
                                "            DMToRemove,",
                                "            /// <summary>Setting the residual DM amount.</summary>",
                                "            ResidualDM",
                                "        }",
                                "",
                                "        /// <summary>Fraction of defoliated DM to remove from field.</summary>",
                                "        public enum DMRemovalTypes",
                                "        {",
                                "            /// <summary>Remove all DM.</summary>",
                                "            RemoveAll,",
                                "            /// <summary>Remove no DM.</summary>",
                                "            RemoveNone,",
                                "            /// <summary>Remove a user-defined fraction.</summary>",
                                "            UserDefinedFraction,",
                                "            /// <summary>Remove a fraction based on plant digestibility.</summary>",
                                "            BasedOnDigestibility",
                                "        }",
                                "",
                                "        /// <summary>Fraction of N in the defoliated material to remove from field.</summary>",
                                "        public enum NRemovalTypes",
                                "        {",
                                "            /// <summary>Remove all N.</summary>",
                                "            RemoveAll,",
                                "            /// <summary>Remove no N.</summary>",
                                "            RemoveNone,",
                                "            /// <summary>Remove a user-defined fraction.</summary>",
                                "            UserDefinedFraction,",
                                "            /// <summary>Remove a fraction equal to DM removed.</summary>",
                                "            ProportionalToDM",
                                "        }",
                                "",
                                "        /// <summary>Define how the non-removed material is returned to the field.</summary>",
                                "        public enum ReturnAsTypes",
                                "        {",
                                "            /// <summary>Return plant material as residue.</summary>",
                                "            AsResidue,",
                                "            /// <summary>Return material as dung and urine.</summary>",
                                "            AsDungUrine",
                                "        }",
                                "",
                                "        /// <summary>Define how the proportion of N in dung is defined.</summary>",
                                "        public enum DungNContentTypes",
                                "        {",
                                "            /// <summary>Define the proportion of N returned as dung.</summary>",
                                "            DefineProportion,",
                                "            /// <summary>Define the C:N of dung.</summary>",
                                "            DefineCNratio",
                                "        }",
                                "",
                                "        /// <summary>Options for the period over which mean growth is computed.</summary>",
                                "        public enum MeanGrowthPeriodTypes",
                                "        {",
                                "            /// <summary>Compute over the period between defoliations.</summary>",
                                "            BetweenDefoliations,",
                                "            /// <summary>Compute over a fixed number of days.</summary>",
                                "            FixedPeriod,",
                                "            /// <summary>Compute over the period between defoliations, but limited to a maximum.</summary>",
                                "            BetweenDefoliationsOrMaxPeriod",
                                "        }",
                                "    }",
                                "}"
                              ],
                              "Parameters": [
                                {
                                  "Key": "AllowAutomaticManagement",
                                  "Value": "No"
                                },
                                {
                                  "Key": "DefoliationRotationStartDate",
                                  "Value": "01/01/1900 00:00:00"
                                },
                                {
                                  "Key": "DefoliationRotationEndDate",
                                  "Value": "12/31/2100 00:00:00"
                                },
                                {
                                  "Key": "DefoliationTriggerType",
                                  "Value": "TargetStandingBiomass"
                                },
                                {
                                  "Key": "IntervalBetweenDefoliations",
                                  "Value": "15"
                                },
                                {
                                  "Key": "TargetStandingBiomass",
                                  "Value": "250"
                                },
                                {
                                  "Key": "DurationOfEachDefoliation",
                                  "Value": "1"
                                },
                                {
                                  "Key": "RemoveAmountType",
                                  "Value": "ResidualDM"
                                },
                                {
                                  "Key": "AmountForEachDefoliation",
                                  "Value": "125"
                                },
                                {
                                  "Key": "MininumAmountToDefoliate",
                                  "Value": "75"
                                },
                                {
                                  "Key": "SuppressDefoliationOnWindow",
                                  "Value": "No"
                                },
                                {
                                  "Key": "NoDefoliationWindowStartDate",
                                  "Value": "1-Jun"
                                },
                                {
                                  "Key": "NoDefoliationWindowEndDate",
                                  "Value": "30-Jul"
                                },
                                {
                                  "Key": "EnforceMinimumInterval",
                                  "Value": "No"
                                },
                                {
                                  "Key": "MinimumInterval",
                                  "Value": "15"
                                },
                                {
                                  "Key": "EnforceMaximumInterval",
                                  "Value": "No"
                                },
                                {
                                  "Key": "MaximumInterval",
                                  "Value": "90"
                                },
                                {
                                  "Key": "DMRemoveType",
                                  "Value": "UserDefinedFraction"
                                },
                                {
                                  "Key": "FractionDMToRemove",
                                  "Value": "0.99"
                                },
                                {
                                  "Key": "NRemoveType",
                                  "Value": "UserDefinedFraction"
                                },
                                {
                                  "Key": "FractionNToRemove",
                                  "Value": "0.99"
                                },
                                {
                                  "Key": "ReturnType",
                                  "Value": "AsResidue"
                                },
                                {
                                  "Key": "NDungType",
                                  "Value": "DefineCNratio"
                                },
                                {
                                  "Key": "ProportionOfNToDung",
                                  "Value": "0.4"
                                },
                                {
                                  "Key": "CNRatioDung",
                                  "Value": "17.5"
                                },
                                {
                                  "Key": "UrineDepth",
                                  "Value": "250"
                                },
                                {
                                  "Key": "SettingUrineNAmount",
                                  "Value": "No"
                                },
                                {
                                  "Key": "UrineNSetAmount",
                                  "Value": "2"
                                },
                                {
                                  "Key": "PopulationDeclineRate",
                                  "Value": "0"
                                },
                                {
                                  "Key": "ConsiderTrampling",
                                  "Value": "No"
                                },
                                {
                                  "Key": "MaximumLitterFractionToSoil",
                                  "Value": "0.01"
                                },
                                {
                                  "Key": "BiomassDefoliatedForMaximumLitterFraction",
                                  "Value": "120"
                                },
                                {
                                  "Key": "MeanGrowthPeriodType",
                                  "Value": "BetweenDefoliations"
                                },
                                {
