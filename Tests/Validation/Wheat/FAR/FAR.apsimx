                          "CodeArray": [
                            "using Newtonsoft.Json;",
                            "using System.Data;",
                            "using System.Xml.Serialization;",
                            "using Models;",
                            "using System.Text;",
                            "using System.Collections.Generic;",
                            "using Models.Interfaces;",
                            "using System;",
                            "using Models.Core;",
                            "using Models.PMF;",
                            "using Models.Soils;",
                            "using Models.Utilities;",
                            "using APSIM.Shared.Utilities;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable]",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] Clock Clock;",
                            "        [Link] Fertiliser Fertiliser;",
                            "        [Link] Summary Summary;",
                            "        [Link] Soil Soil;",
                            "        [Link(ByName = true)] Plant Wheat;",
                            "        [Link] Simulation Simulation;",
                            "        Accumulator accumulatedRain;",
                            "        ",
                            "        [Description(\"Sowing date (d-mmm)\")]",
                            "        public string SowDate { get; set; }",
                            "        [Description(\"Treatment Name\")]",
                            "        public string Treat { get; set; }",
                            "        [Display(Type = DisplayType.CultivarName)]",
                            "        [Description(\"Cultivar to be sown\")]",
                            "        public string CultivarName { get; set; }",
                            "        [Description(\"Sowing depth (mm)\")]",
                            "        public double SowingDepth { get; set; }",
                            "        [Description(\"Row spacing (mm)\")]",
                            "        public double RowSpacing { get; set; }",
                            "        [Description(\"Plant population (/m2)\")]",
                            "        public double Population { get; set; }",
                            "",
                            "",
                            "",
                            "        [EventSubscribe(\"DoManagement\")]",
                            "        private void OnDoManagement(object sender, EventArgs e)",
                            "        {",
                            "",
                            "            if (DateUtilities.WithinDates(SowDate, Clock.Today, SowDate))",
                            "            {",
                            "               Wheat.Sow(population: Population, cultivar: CultivarName, depth: SowingDepth, rowSpacing: RowSpacing);    ",
                            "            }            ",
                            "        ",
                            "        }",
                            "        ",
                            "    }",
                            "}"
                          ],
                          "Parameters": [
                            {
                              "Key": "SowDate",
                              "Value": "26-apr"
                            },
                            {
                              "Key": "Treat",
                              "Value": ""
                            },
                            {
                              "Key": "CultivarName",
                              "Value": ""
                            },
                            {
                              "Key": "SowingDepth",
                              "Value": "30"
                            },
                            {
                              "Key": "RowSpacing",
                              "Value": "225"
                            },
                            {
                              "Key": "Population",
                              "Value": "180"
                            }
                          ],
                          "Name": "Sowing",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "using Models.Soils;",
                            "using System;",
                            "using System.Linq;",
                            "using Models.Core;",
                            "using Models.PMF;",
                            "namespace Models",
                            "{",
                            "    [Serializable]",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] Clock Clock;",
                            "        [Link] Fertiliser Fertiliser;",
                            "        [Link(ByName = true)] Plant Wheat;",
                            "                ",
                            "        [Description(\"Type of fertiliser to apply? \")] ",
                            "        [Display(Type = DisplayType.FertiliserType)]public string FertiliserType { get; set; }",
                            "    ",
                            "        [Description(\"Amount of fertiliser to be applied (kg/ha)\")]",
                            "        public double Amount { get; set; }",
                            "        ",
                            "        [EventSubscribe(\"Sowing\")]",
                            "        private void OnSowing(object sender, EventArgs e)",
                            "        {",
                            "            Model crop = sender as Model;",
                            "            if (Wheat != null && crop.Name.ToLower() == (Wheat as IModel).Name.ToLower())",
                            "                Fertiliser.Apply(amount: Amount, type: FertiliserType);",
                            "        }",
                            "    }",
                            "}"
                          ],
                          "Parameters": [
                            {
                              "Key": "FertiliserType",
                              "Value": "MAP"
                            },
                            {
                              "Key": "Amount",
                              "Value": "100"
                            }
                          ],
                          "Name": "FertSow",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "using APSIM.Core;",
                            "using Models.PMF;",
                            "using Models.Core;",
                            "using System.Linq;",
                            "using System;",
                            "using Models.Soils;",
                            "namespace Models",
                            "{",
                            "    [Serializable] ",
                            "    public class Script : Model, IStructureDependency",
                            "    {",
                            "        [Link] private Clock Clock;",
                            "        [Link] private Fertiliser Fertiliser;",
                            "        [Link] private Summary Summary;",
                            "        [Link(ByName = true)] private Plant Wheat;",
                            "        public IStructure Structure { private get; set; }",
                            " ",
                            "        private bool hasFertilised = false;",
                            "",
                            "        [Description(\"Fertilise once crop reaches stage:\")]",
                            "        public double Stage { get; set; }",
                            "",
                            "        [Description(\"Type of fertiliser to apply? \")] ",
                            "        [Display(Type = DisplayType.FertiliserType)]public string FertiliserType { get; set; }",
                            "",
                            "        [Description(\"Amount of fertiliser to be applied (kg/ha)\")] ",
                            "        public double Amount { get; set; }",
                            "     ",
                            "",
                            "        ",
                            "",
                            "        [EventSubscribe(\"DoManagement\")] ",
                            "        private void OnDoManagement(object sender, EventArgs e)",
                            "        { ",
                            "            double zadok = (double)Structure.GetObject(\"Phenology.Zadok.Stage\", relativeTo: Wheat).Value; ",
                            " ",
                            "            if (zadok >= Stage && !hasFertilised)",
                            "            { ",
                            "                Summary.WriteMessage(this, \"Fertilising!!\", MessageType.Diagnostic); ",
                            "                Fertiliser.Apply(amount: Amount, type: FertiliserType);",
                            "                hasFertilised = true; ",
                            "            } ",
                            "        }",
                            "",
                            "        [EventSubscribe(\"Sowing\")]",
                            "        private void OnSowing(object sender, EventArgs e)",
                            "        {",
                            "            hasFertilised = false;",
                            "        }",
                            "    }",
                            "}"
                          ],
                          "Parameters": [
                            {
                              "Key": "Stage",
                              "Value": "30"
                            },
                            {
                              "Key": "FertiliserType",
                              "Value": "UreaN"
                            },
                            {
                              "Key": "Amount",
                              "Value": "0"
                            }
                          ],
                          "Name": "FertStage",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "using APSIM.Core;",
                            "using Models.Soils.Nutrients;",
                            "using System;",
                            "using Models.Core;",
                            "using System.Collections.Generic;",
                            "using System.Text;",
                            "using Models.Soils;",
                            "using Models.PMF;",
                            "using Models;",
                            "using System.Xml.Serialization;",
                            "using APSIM.Shared.Utilities;",
                            "using Models.PMF.Phen;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable]",
                            "    public class Script : Model, IStructureDependency",
                            "    {",
                            "        [Link(ByName = true)] private Plant Wheat;",
                            "        [Link] private Simulation sim;",
                            "        [Link] private Clock clock;",
                            "        [Link] private Summary summary;",
                            "        public IStructure Structure { private get; set; }",
                            "        ",
                            "        [Description(\"Prevent harvesting before: \")]",
                            "        public string NoHarvestBefore {get; set;}",
                            "        ",
                            "",
                            "        ",
                            "",
                            "        [EventSubscribe(\"DoManagement\")]",
                            "        private void OnDoManagement(object sender, EventArgs e)",
                            "        {",
                            "            if (Wheat.IsReadyForHarvesting && DateUtilities.CompareDates(NoHarvestBefore, clock.Today) > 0)",
                            "            {",
                            "                Wheat.Harvest();",
                            "                Wheat.EndCrop();",
                            "            }",
                            "        }",
                            "        ",
                            "        [EventSubscribe(\"EndOfDay\")]",
                            "        private void OnEndOfDay(object sender, EventArgs e)",
                            "        {",
                            "            if ((clock.Today.Equals(clock.EndDate))&&(Wheat.IsAlive))",
                            "            {",
                            "                Wheat.Harvest();",
                            "                Wheat.EndCrop();",
                            "                Structure.Set(\"Clock.EndDate\", clock.Today, relativeTo: sim);",
                            "            }",
                            "        }",
                            "    }",
                            "}"
                          ],
                          "Parameters": [
                            {
                              "Key": "NoHarvestBefore",
                              "Value": "18-January-2024"
                            }
                          ],
                          "Name": "HarvestAfter",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
