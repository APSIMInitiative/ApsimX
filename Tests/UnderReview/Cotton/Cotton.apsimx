                            "[Cotton].Lint.Wt",
                            "[Cotton].Seed.Wt",
                            "[Cotton].Phenology.CurrentStageName",
                            "sum([Soil].Water.MM[1:4]) as TotalSW90cm",
                            "[Cotton].Leaf.Fw",
                            "[Cotton].Leaf.Fn",
                            "sum([Soil].NO3.kgha)"
                          ],
                          "EventNames": [
