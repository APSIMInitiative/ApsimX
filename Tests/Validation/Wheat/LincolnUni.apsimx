      "ResourceName": null,
      "Children": [
        {
          "$type": "Models.Memo, Models",
          "Text": "The purpose of this experiment is to test model predictions of canopy development, biomass accumulation and partition.  The cultivars used do not have sufficient data with different sowing dates to allow accurate fitting of phenology parameters.  However, detailed observtions of the timing of phenological stages were conducted for this experiment.  As such, the timing of phenology stages was set (using the SetModelParamsBySimulation model in the base simulation) to ensure good alignment of the models phenology with the experiment so model comparisons of biomass could be made without confunding of poor phenology predictions.",
          "Name": "Phenology Not modeled",
          "ResourceName": null,
          "Children": [],
          "Enabled": true,
          "ReadOnly": false
        },
