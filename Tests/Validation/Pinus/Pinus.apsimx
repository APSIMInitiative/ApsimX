                          "$type": "Models.Factorial.Factor, Models",
                          "Specification": "[TreeManagement].Script.CultivarName = caribaea, elliottii, PEE, elliottiiIMPAC, elliottiiQLD, elliottiiXcaribaeaF1, elliottiiXcaribaeaF2, taeda, taedaIMPAC, BFG, GF7, TowerHill",
