            {
              "$type": "Models.Factorial.Experiment, Models",
              "DisabledSimNames": null,
              "Name": "FAR HYC W17-02-2",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Memo, Models",
                  "Text": "# Field Applied Research (FAR) Australia trial FAR HYC W17-02-2 at Hagley in 2017. \r\n\r\nThis trial has been selected because it contained 7 cultivars of interest, and had up to 10 Greenseeker (NDVI), 1 biomass, 0 N concentration or 2 growth stage measurements. \r\n\r\n*Grazing/defolation treatments have been excluded.* \r\n\r\nTrial description: **European and new lines wheat cultivar trial� Time of Sowing 2** \r\n\r\n[Some trial details may be found here](https://faraustralia.com.au/resource) \r\n\r\n",
                  "Name": "Description",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Factorial.Factors, Models",
                  "Name": "Factors",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Factorial.Permutation, Models",
                      "Name": "Permutation",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Factorial.Factor, Models",
                          "Specification": "[Sowing].Script.CultivarName = Manning, Revenue, Relay, Trojan, Adv08_0008, Kittyhawk, Einstein",
                          "Name": "Cv",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        }
                      ],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
