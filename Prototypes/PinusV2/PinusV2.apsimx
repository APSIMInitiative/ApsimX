            },
            {
              "$type": "Models.Functions.ProtectedDivideFunction, Models",
              "NumeratorErrVal": 0.0,
              "DenominatorErrVal": 0.0,
              "Name": "IndividualTreeStemWt",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Functions.VariableReference, Models",
                  "VariableName": "[Pinus].Stem.Wt",
                  "Name": "StemWt",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.VariableReference, Models",
                  "VariableName": "[Pinus].Population",
                  "Name": "Population",
                  "ResourceName": null,
                  "Children": [],
