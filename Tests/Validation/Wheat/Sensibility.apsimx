                    {
                      "$type": "Models.Manager, Models",
                      "CodeArray": [
                        "using APSIM.Core;",
                        "using Models.Factorial;",
                        "using Models.Core.Run;",
                        "using Models.Core;",
                        "using Models.Storage;",
                        "using System.Data;",
                        "using System.IO;",
                        "using System.Collections.Generic;",
                        "using System;",
                        "",
                        "namespace Models",
                        "{",
                        "    [Serializable]",
                        "    public class Script : Model, IStructureDependency, IPostSimulationTool",
                        "    {",
                        "        [Link] private DataStore dataStore;",
                        "        ",
                        "        public IStructure Structure { private get; set; }",
                        "        ",
                        "        //The two values of the factor for this experiment",
                        "        private string[] co2 = {\"350ppm\", \"700ppm\"};",
                        "        ",
                        "        //The test variable",
                        "        private double[] avgYield = {0.0, 0.0};",
                        "",
                        "         ",
                        "         //number of rows that should be in the table",
                        "         private int requiredRows = 11;",
                        "        ",
                        "        public void Run()",
                        "        {",
                        "            Experiment exp =   Structure.FindParent<Experiment>(recurse: true);",
                        "            for(int i = 0; i < co2.Length; i++)",
                        "            {",
                        "                string filter = \"Experiment == \\\"\" + exp.Name + \"\\\" AND CO2 == \\\"\" + co2[i] + \"\\\"\";",
                        "                DataTable dt = dataStore.Reader.GetData(\"SensibilityReport\", filter: filter);",
                        "                ",
                        "                if (dt.Rows.Count != requiredRows)",
                        "                    throw new Exception(\"Sensibility test failed: CO2=\" + co2[i] + \". Expected \" + requiredRows.ToString() + \" rows in table, but \" + dt.Rows.Count.ToString() + \" were found.\" );        ",
                        "                ",
                        "                  foreach (DataRow row in dt.Rows)",
                        "                    avgYield[i] += (double)row[\"Wheat.Grain.Wt\"];",
                        "",
                        "                avgYield[i] = avgYield[i] / dt.Rows.Count;",
                        "                    ",
                        "            }                ",
                        "            ",
                        "            if (avgYield[1] < avgYield[0])",
                        "                throw new Exception(\"Sensibility test failed because average wheat yield decreased with increasing atmospheric CO2\" );",
                        "            ",
                        "        }",
                        "    }",
                        "}"
                      ],
                      "Parameters": [],
                      "Name": "CheckResults",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
