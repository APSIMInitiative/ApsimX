                        "                ",
                        "        [EventSubscribe(\"StartOfSimulation\")]",
                        "        private void OnSimulationCommencing(object sender, EventArgs e)",
                        "        {",
                        "          ",
                        "          zone.Set(\"Grapevine.Structure.HeightModel.ShootHeight.ShootLength.SeasonalPattern.XYPairs.Y[1]\", 2000);",
                        "          zone.Set(\"Grapevine.Structure.HeightModel.ShootHeight.ShootLength.SeasonalPattern.XYPairs.Y[2]\", 2000);",
                        "          zone.Set(\"Grapevine.Structure.HeightModel.ShootHeight.ShootLength.SeasonalPattern.XYPairs.Y[3]\", 2400);",
                        "          zone.Set(\"Grapevine.Structure.HeightModel.ShootHeight.ShootLength.SeasonalPattern.XYPairs.Y[4]\", 2400);",
                        "          zone.Set(\"Grapevine.Structure.HeightModel.ShootHeight.ShootLength.SeasonalPattern.XYPairs.Y[5]\", 2000);",
                        "          zone.Set(\"Grapevine.Structure.HeightModel.ShootHeight.TrimShootHeight.FixedValue\", 2400);",
                        "          ",
                        "          zone.Set(\"Grapevine.Berry.YieldComponent.BerryNum.PostEventValue.BerryNumFun.Minimum.FixedValue\", 1);",
                        "          zone.Set(\"Grapevine.Berry.YieldComponent.BunchesPerShoot.PostEventValue.MaximumFunc.one.FixedValue\", 0);",
                        "          zone.Set(\"Grapevine.Berry.YieldComponent.BerryMass.PostEventValue.BerryMassFun.LowerLimit.FixedValue\", 1.8);",
                        "        }",
                        "     }",
                        "}",
                        "",
                        "       ",
