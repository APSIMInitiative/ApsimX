                    {
                      "$type": "Models.Report, Models",
                      "VariableNames": [
                        "[Clock].Today",
                        "[CottonZone].Cotton.Phenology.CurrentStageName",
                        "sum([CottonZone].Soil.Water.MM[1:4]) as CottonTotSW90",
                        "sum([SkipZone].Soil.Water.MM[1:4]) as SkipTotSW90",
                        "sum([CottonZone].Soil.Physical.LL15mm[1:4]) as CottonLL90"
                      ],
