                        "                ",
                        "        [EventSubscribe(\"StartOfSimulation\")]",
                        "        private void OnSimulationCommencing(object sender, EventArgs e)",
                        "        {",
                        "          ",
                        "          zone.Set(\"Grapevine.Structure.HeightModel.ShootHeight.ShootLength.SeasonalPattern.XYPairs.Y[1]\", 1000);",
                        "          zone.Set(\"Grapevine.Structure.HeightModel.ShootHeight.ShootLength.SeasonalPattern.XYPairs.Y[2]\", 1000);",
                        "          zone.Set(\"Grapevine.Structure.HeightModel.ShootHeight.ShootLength.SeasonalPattern.XYPairs.Y[3]\", 1500);",
                        "          zone.Set(\"Grapevine.Structure.HeightModel.ShootHeight.ShootLength.SeasonalPattern.XYPairs.Y[4]\", 1500);",
                        "          zone.Set(\"Grapevine.Structure.HeightModel.ShootHeight.ShootLength.SeasonalPattern.XYPairs.Y[5]\", 1000);",
                        "          zone.Set(\"Grapevine.Structure.HeightModel.ShootHeight.TrimShootHeight.FixedValue\", 1500);",
                        "",
                        "      ",
                        "          zone.Set(\"Grapevine.Berry.YieldComponent.BerryNum.PostEventValue.BerryNumFun.Minimum.FixedValue\", 1);",
                        "          zone.Set(\"Grapevine.Berry.YieldComponent.BunchesPerShoot.PostEventValue.MaximumFunc.one.FixedValue\", 0);",
                        "          zone.Set(\"Grapevine.Berry.YieldComponent.BerryMass.PostEventValue.BerryMassFun.LowerLimit.FixedValue\", 1.8);",
                        "        }",
                        "     }",
                        "}",
                        "",
                        "       ",
                        ""
                      ],
