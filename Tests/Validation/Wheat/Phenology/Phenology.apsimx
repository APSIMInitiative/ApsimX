                    },
                    {
                      "$type": "Models.Manager, Models",
                      "CodeArray": [
                        "",
                        "using Models.Soils;",
                        "using System;",
                        "using Models.Core;",
                        "using Models.PMF;",
                        "namespace Models",
                        "{",
                        "           ",
                        "    [Serializable] ",
                        "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                        "    public class Script : Model",
                        "    {",
                        "    ",
                        "        [Link] Plant Wheat;",
                        "        [Link] Clock Clock;",
                        "            ",
                        "        [Description(\"Time of Sowing\")]",
                        "        public int TOS { get; set; }",
                        "",
                        "        [Description(\"Cultivar\")]",
                        "        public String Cultivar { get; set; }",
                        "        ",
                        "        [EventSubscribe(\"DoManagement\")]",
                        "        private void OnDoManagement(object sender, EventArgs e)",
                        "        {",
                        "            if ((Clock.Today.DayOfYear == 133) && (TOS == 1)) ",
                        "            {",
                        "                Wheat.Sow(population: 100, cultivar: Cultivar, depth: 30, rowSpacing: 250);",
                        "                Wheat.Phenology.SetPhaseCompletionDate(\"28-May\",\"Emerging\");",
                        "            }",
                        "            if ((Clock.Today.DayOfYear == 179) && (TOS == 2))",
                        "            {",
                        "                Wheat.Sow(population: 100, cultivar: Cultivar, depth: 30, rowSpacing: 250);",
                        "                Wheat.Phenology.SetPhaseCompletionDate(\"15-Jul\",\"Emerging\");",
                        "            }",
                        "",
                        "        }",
                        "",
                        "",
                        "    }",
                        "}",
                        "                "
                      ],
                      "Parameters": [
                        {
                          "Key": "TOS",
                          "Value": "1"
                        },
                        {
                          "Key": "Cultivar",
                          "Value": "Hartog"
                        }
