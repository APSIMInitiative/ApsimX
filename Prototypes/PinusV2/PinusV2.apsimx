                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.MultiplyFunction, Models",
                  "Name": "SpecificLeafAreaFunction",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "  \r\nSome SLA data were for some of the datasets inlcuded in this validation, but rarely accurately enough to estimate  average canopy SLA. So high model skill for this attribute cannot be expeced.    \n\n\n",
                      "Name": "Memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.LinearInterpolationFunction, Models",
                      "Name": "CO2Modifier",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Functions.XYPairs, Models",
                          "X": [
                            350.0,
                            850.0
                          ],
                          "Y": [
                            1.0,
                            0.8
                          ],
                          "Name": "XYPairs",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
