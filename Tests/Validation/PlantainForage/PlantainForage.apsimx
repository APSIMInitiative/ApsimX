          "ReadOnly": false
        },
        {
          "$type": "Models.Report, Models",
          "VariableNames": [
            "[Clock].Today as Date",
            "",
            "// surface OM",
            "([PlantainForage].Leaf.Detached.Wt+[PlantainForage].Stem.Detached.Wt+[PlantainForage].Inflorescence.Detached.Wt)*0.4/([PlantainForage].Leaf.Detached.N+[PlantainForage].Stem.Detached.N+[PlantainForage].Inflorescence.Detached.N+0.00000001) as Litter.CN",
            "([PlantainForage].Root.Detached.Wt+[PlantainForage].Taproot.Detached.Wt)*0.4/([PlantainForage].Root.Detached.N+[PlantainForage].Taproot.Detached.N+0.00000001) as RootDetached.CN",
            "//[DefoliationManager].Script.ReturnedWt*0.4/([DefoliationManager].Script.NReturnedInDung+0.00000001) as Dung.CN",
            "[SurfaceOrganicMatter].Wt",
            "([SurfaceOrganicMatter].C/[SurfaceOrganicMatter].N) as SurfaceOrganicMatter.CN",
            "",
            "// soil water",
            "(sum([Soil].Water.MM)-sum([Soil].Physical.LL15mm))/(sum([Soil].Physical.DULmm)-sum([Soil].Physical.LL15mm)) as ProfileWaterStatus",
            "[Weather].VP as VapourPressure",
            "[Weather].VPD as VapoutPressureDeficit",
            "",
            "// soil nitrogen",
            "[Soil].Nutrient.FOM.C/0.4 as Soil.FOM.Wt",
            "[Soil].Nutrient.FOM.C/[Soil].Nutrient.FOM.N as Soil.FOM.CN",
            "([Soil].Nutrient.Microbial.C + [Soil].Nutrient.Humic.C)*100.0/([Soil].Physical.BD * [Soil].Physical.Thickness * 10000.0) as Soil.OC",
            "//[Soil].Nutrient.Microbial.C/[Soil].Nutrient.Humic.C as FBiom",
            "[Soil].Nutrient.Microbial.C/([Soil].Nutrient.Humic.C - [Soil].Nutrient.Inert.C) as FBiom",
            "[Soil].Nutrient.Inert.C/([Soil].Nutrient.Microbial.C + [Soil].Nutrient.Humic.C) as FInert",
            "",
            "[PlantainForage].Root.SoilWaterStatus as SoilWaterStatus",
            "[PlantainForage].Root.WetRootFraction as SaturatedSoilFactor"
          ],
          "EventNames": [
            "[Clock].DoReport"
          ],
          "GroupByVariableName": null,
          "Name": "DiagnosisReport",
          "ResourceName": null,
          "Children": [],
          "Enabled": true,
          "ReadOnly": false
        }
      ],
      "Enabled": true,
      "ReadOnly": false
    },
