                              "$type": "Models.Factorial.CompositeFactor, Models",
                              "Specifications": [
                                "[Sowing].Script.Treat = None",
                                "[FertDate0].Script.FertiliserType = UreaN",
                                "[FertDate0].Script.FertiliserDates = 11-sep",
                                "[FertDate0].Script.Amount = 0"
                              ],
                              "Paths": null,
                              "Values": null,
                              "Name": "None",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            },
                            {
                              "$type": "Models.Factorial.CompositeFactor, Models",
                              "Specifications": [
                                "[Sowing].Script.Treat = 40N",
                                "[FertDate0].Script.FertiliserType = UreaN",
                                "[FertDate0].Script.FertiliserDates = 11-sep",
                                "[FertDate0].Script.Amount = 40"
                              ],
                              "Paths": null,
