                            "                    SoluteAdded = 0;",
                            "                    LayersAdded = 0;",
                            "                    for (int i=0; i<kgha.Length; i++) {",
                            "                        if (i<solute.kgha.Length) {",
                            "                            if (kgha[i]>0) {",
                            "                                solute.kgha[i]=kgha[i];",
                            "                                SoluteAdded += solute.kgha[i];",
                            "                                LayersAdded += 1;",
                            "                                }",
                            "                            }",
                            "                    }",
                            "                }",
                            "            }",
                            "        }",
                            "    }",
                            "}"
                          ],
                          "Parameters": [
                            {
                              "Key": "SoluteName",
                              "Value": "NH4"
                            },
                            {
                              "Key": "DateCsvString",
                              "Value": "2019/09/9"
                            },
                            {
                              "Key": "ValueCsvString",
                              "Value": "6.08,4.1,4.72"
                            },
                            {
                              "Key": "ThicknessCsvString",
                              "Value": "299,300,300"
                            }
                          ],
                          "Name": "NH4Initialise2",
                          "ResourceName": null,
                          "Children": [],
