                {
                  "$type": "Models.Manager, Models",
                  "CodeArray": [
                    "using Models.Soils;",
                    "using System.Linq;",
                    "using System;",
                    "using Models.Core;",
                    "using System.Collections.Generic;",
                    "using System.Text;",
                    "using Models.PMF;",
                    "using Models;",
                    "using System.Xml.Serialization;",
                    "using APSIM.Shared.Utilities;",
                    "using System.Data;",
                    "using Models.PMF.Interfaces;",
                    "using Models.Surface;",
                    "",
                    "namespace Models",
                    "{",
                    "    [Serializable] ",
                    "    //[System.Xml.Serialization.XmlInclude(typeof(Model))]",
                    "    public class Script : Model",
                    "    {",
                    "        [Link(ByName = true)] Plant FodderBeet;",
                    "        [Link] Clock Clock;",
                    "        [Link] Zone zone;",
                    "        [Link] Simulation Simulation;",
                    "        [Link] SurfaceOrganicMatter SurfOM;",
                    "        ",
                    "                ",
                    "        [Description(\"Initial Root Depth\")]",
                    "        public double InitialRootDepth { get; set; }",
                    "        [Description(\"Sown Crop\")]",
                    "        [Display(Type=DisplayType.CultivarName, PlantName = \"FodderBeet\")]",
                    "        public string CropToSow { get; set; }",
                    "        [Description(\"Sowing Date\")]",
                    "        public DateTime SowingDate { get; set; }",
                    "        ",
                    "        ",
                    "        ",
                    "        [EventSubscribe(\"DoManagement\")]",
                    "        private void OnDoManagement(object sender, EventArgs e)",
                    "        {",
                    "            if (Clock.Today.Date == SowingDate)",
                    "            {",
                    "                FodderBeet.Sow(cultivar: CropToSow, population: 9, depth: InitialRootDepth, rowSpacing: 500);",
                    "                ",
                    "            }",
                    "                        ",
                    "            ",
                    "        }",
                    "    }",
                    "}",
                    "                "
                  ],
                  "Parameters": [
                    {
                      "Key": "InitialRootDepth",
                      "Value": "2"
                    },
                    {
                      "Key": "CropToSow",
                      "Value": "Rivage"
                    },
                    {
                      "Key": "SowingDate",
                      "Value": "10/29/2012 00:00:00"
                    }
                  ],
                  "Name": "SowDateCv",
                  "ResourceName": null,
