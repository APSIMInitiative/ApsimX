                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "using Models.Soils.Nutrients;",
                            "using System;",
                            "using Models.Core;",
                            "using Models.PMF;",
                            "using Models.Soils;",
                            "using Models.Soils.Nutrients;",
                            "using Models.Utilities;",
                            "using APSIM.Shared.Utilities;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable]",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] Clock Clock;",
                            "        [Link] Fertiliser Fertiliser;",
                            "        [Link] Summary Summary;",
                            "        [Link] Plant Wheat;",
                            "        [Link] Soil Soil;",
                            "        Accumulator accumulatedRain;",
                            "        ",
                            "        [Description(\"Sowing date (d-mmm)\")]",
                            "        public string SowDate { get; set; }",
                            "        [Description(\"Emergence date (d-mmm)\")]",
                            "        public string EmergeDate { get; set; }",
                            "        [Description(\"Cultivar to be sown\")]",
                            "        public string CultivarName { get; set; }",
                            "        [Description(\"Sowing depth (mm)\")]",
                            "        public double SowingDepth { get; set; }",
                            "        [Description(\"Row spacing (mm)\")]",
                            "        public double RowSpacing { get; set; }",
                            "        [Description(\"Plant population (/m2)\")]",
                            "        public double Population { get; set; }",
                            "        ",
                            "        ",
                            "",
                            "",
                            "        [EventSubscribe(\"DoManagement\")]",
                            "        private void OnDoManagement(object sender, EventArgs e)",
                            "        {",
                            "        ",
                            "            ",
                            "            if (DateUtilities.WithinDates(SowDate, Clock.Today, SowDate))",
                            "            {",
                            "                Wheat.Sow(population: Population, cultivar: CultivarName, depth: SowingDepth, rowSpacing: RowSpacing);    ",
                            "                Wheat.Phenology.SetPhaseCompletionDate(EmergeDate,\"Emerging\");",
                            "            }",
                            "        ",
                            "        }",
                            "        ",
                            "    }",
                            "}"
                          ],
                          "Parameters": [
                            {
                              "Key": "SowDate",
                              "Value": ""
                            },
                            {
                              "Key": "EmergeDate",
                              "Value": ""
                            },
                            {
                              "Key": "CultivarName",
                              "Value": ""
                            },
                            {
                              "Key": "SowingDepth",
                              "Value": "30"
                            },
                            {
                              "Key": "RowSpacing",
                              "Value": "250"
                            },
                            {
                              "Key": "Population",
                              "Value": "150"
                            }
                          ],
                          "Name": "Sowing",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "using Models.Soils;",
                            "using System.Xml.Serialization;",
                            "using Models;",
                            "using Models.PMF;",
                            "using System.Text;",
                            "using System.Collections.Generic;",
                            "using APSIM.Shared.Utilities;",
                            "using Models.Core;",
                            "using System;",
                            "using Models.Climate;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable] ",
                            "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] Weather Met;",
                            "        [Link] Clock Clock;",
                            "    ",
                            "        [Description(\"Start Date\")]",
                            "        public DateTime StartDate { get; set; }",
                            "        ",
                            "        [Description(\"End Date\")]",
                            "        public DateTime EndDate { get; set; }",
                            " ",
                            "    ",
                            "        [EventSubscribe(\"PreparingNewWeatherData\")]",
                            "        private void OnPreparingNewWeatherData(object sender, EventArgs e)",
                            "        {",
                            "            if ((Clock.Today.Date >= StartDate) && (Clock.Today.Date <= EndDate))",
                            "                Met.MaxT = 4.0;",
                            "                Met.MinT = 4.0;        ",
                            "        }",
                            "    }",
                            "}"
                          ],
                          "Parameters": [
                            {
                              "Key": "StartDate",
                              "Value": "04/24/2014 00:00:00"
                            },
                            {
                              "Key": "EndDate",
                              "Value": "06/18/2014 00:00:00"
                            }
                          ],
                          "Name": "PreSowVernalisation",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "using Models.Soils;",
                            "using System.Xml.Serialization;",
                            "using Models;",
                            "using Models.PMF;",
                            "using System.Text;",
                            "using System.Collections.Generic;",
                            "using APSIM.Shared.Utilities;",
                            "using Models.Core;",
                            "using System;",
                            "using Models.Climate;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable] ",
                            "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] Weather Met;",
                            "        [Link] Clock Clock;",
                            "    ",
                            "        [Description(\"Start Date\")]",
                            "        public DateTime StartDate { get; set; }",
                            "        ",
                            "        [Description(\"End Date\")]",
                            "        public DateTime EndDate { get; set; }",
                            " ",
                            "        [Description(\"Photoperiod extension (hours)\")]",
                            "        public double ExtraHours { get; set; }",
                            "        [EventSubscribe(\"PreparingNewWeatherData\")]",
                            "        private void OnPreparingNewWeatherData(object sender, EventArgs e)",
                            "        {",
                            "            if ((Clock.Today.Date >= StartDate) && (Clock.Today.Date <= EndDate))",
                            "                Met.DayLength = Met.CalculateDayLength(-6) + ExtraHours;",
                            "        }",
                            "    }",
                            "}"
                          ],
                          "Parameters": [
                            {
                              "Key": "StartDate",
                              "Value": "04/20/2014 00:00:00"
                            },
                            {
                              "Key": "EndDate",
                              "Value": "11/01/2014 00:00:00"
                            },
                            {
                              "Key": "ExtraHours",
                              "Value": "NaN"
                            }
                          ],
                          "Name": "PhotoperiodExtension",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        }
                      ],
                      "Enabled": true,
                      "ReadOnly": false
