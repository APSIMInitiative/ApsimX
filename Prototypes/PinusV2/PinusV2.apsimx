                }
              ],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Core.Group, Models",
              "Name": "Partitioning",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Memo, Models",
                  "Text": "Partitioning of daily growth into the various plant parts is calculated using partitioning fractions.  The sum of all partitioning fractions should equal zero.  To ensure this, a simple staged approach is used here based on primary, secondary and (where required) tertiary partitioning.\n\n1) partitioning to below and above ground growth is calculated.\n2) Below ground growth is partitioned between fine and coarse root material (the sum of which should equal the below ground partition fraction)\n3) Above ground growth is partitioned into woody material.  The remainder is partitioned to foliage.\n4) The above ground woody partition fraction is then partitioned to stem and branch.  The partitioning to cone is calculated as the remainder of woody growth.\n5) The net result of all partitioning calculation should be a value of 1.",
                  "Name": "Memo",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.ExpressionFunction, Models",
                  "Units": "0-1",
                  "Expression": "1 - [Pinus].Partitioning.BelowGround",
                  "Name": "AboveGround",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "Above ground growth is simply set to the complement of the below ground partitioning.",
                      "Name": "Memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.ExpressionFunction, Models",
                      "Units": "0-1",
                      "Expression": "[WoodyFraction].Juvenile + ([WoodyFraction].Mature - [WoodyFraction].Juvenile) * [Pinus].IndividualTreeStemWt / ([Pinus].Partitioning.AboveGround.WoodyFraction.SizeParameter + [Pinus].IndividualTreeStemWt)",
                      "Name": "WoodyFraction",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Memo, Models",
                          "Text": "Above ground growth is simply set to the complement of the below ground partitioning.",
                          "Name": "Memo",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Functions.Constant, Models",
                          "FixedValue": 0.5,
                          "Units": null,
                          "Name": "Juvenile",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Functions.Constant, Models",
                          "FixedValue": 0.84,
                          "Units": null,
                          "Name": "Mature",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Functions.Constant, Models",
                          "FixedValue": 10000.0,
                          "Units": null,
                          "Name": "SizeParameter",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Functions.Constant, Models",
                          "FixedValue": 0.25,
                          "Units": null,
                          "Name": "BranchFraction",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Functions.ExpressionFunction, Models",
                          "Units": null,
                          "Expression": "1 - [Pinus].Partitioning.AboveGround.WoodyFraction.BranchFraction",
                          "Name": "StemFraction",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        }
                      ],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.ExpressionFunction, Models",
                  "Units": "0-1",
                  "Expression": "[Pinus].Partitioning.BelowGround * [Pinus].Partitioning.BelowGround.CoarseRootFraction",
                  "Name": "CoarseRootFraction",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "Above ground growth is simply set to the complement of the below ground partitioning.",
                      "Name": "Memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.ExpressionFunction, Models",
                  "Units": "0-1",
                  "Expression": "[Pinus].Partitioning.BelowGround * [Pinus].Partitioning.BelowGround.FineRootFraction",
                  "Name": "FineRootFraction",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "Above ground growth is simply set to the complement of the below ground partitioning.",
                      "Name": "Memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.ExpressionFunction, Models",
                  "Units": "0-1",
                  "Expression": "[Pinus].Partitioning.AboveGround * (1 - [Pinus].Partitioning.AboveGround.WoodyFraction)",
                  "Name": "LeafFraction",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "Above ground growth is simply set to the complement of the below ground partitioning.",
                      "Name": "Memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.ExpressionFunction, Models",
                  "Units": "0-1",
                  "Expression": "[Pinus].Partitioning.AboveGround * [Pinus].Partitioning.AboveGround.WoodyFraction * [Pinus].Partitioning.AboveGround.WoodyFraction.BranchFraction",
                  "Name": "BranchFraction",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "Above ground growth is simply set to the complement of the below ground partitioning.",
                      "Name": "Memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.ExpressionFunction, Models",
                  "Units": "0-1",
                  "Expression": "[Pinus].Partitioning.AboveGround * [Pinus].Partitioning.AboveGround.WoodyFraction * [Pinus].Partitioning.AboveGround.WoodyFraction.StemFraction",
                  "Name": "StemFraction",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "Above ground growth is simply set to the complement of the below ground partitioning.",
                      "Name": "Memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.Constant, Models",
                  "FixedValue": 0.0,
                  "Units": "0-1",
                  "Name": "ConeFraction",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.ExpressionFunction, Models",
                  "Units": "0-1",
                  "Expression": "[Pinus].Partitioning.FineRootFraction + [Pinus].Partitioning.CoarseRootFraction + [Pinus].Partitioning.LeafFraction + [Pinus].Partitioning.StemFraction + [Pinus].Partitioning.BranchFraction + + [Pinus].Partitioning.ConeFraction",
                  "Name": "TotalFraction",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "Above ground growth is simply set to the complement of the below ground partitioning.",
                      "Name": "Memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.ExpressionFunction, Models",
                  "Units": "0-1",
                  "Expression": "max([Pinus].Partitioning.BelowGround.Mature, [Pinus].Partitioning.BelowGround.Juvenile - ([Pinus].Partitioning.BelowGround.Juvenile - [Pinus].Partitioning.BelowGround.Mature) * [Pinus].Stem.Ht / [Pinus].Partitioning.BelowGround.HeightAtMature)",
                  "Name": "BelowGround",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "Fraction of daily growth allocated below ground, no Age: max(Mature, Juvenile - (Juvenile - Mature) x Height / HeightAtMature). Falls from 0.45 for seedlings to 0.18 once trees are 3.5 m tall, so fast-growing stands shift to above-ground growth sooner than slow ones. Replaces max(0.2, 0.45 - 0.0625 x Age) (2026-11-14). The floor was lowered from 0.20 to 0.18 because SETRES below-ground biomass (the only root data; taeda, ages 8-16) was over-predicted by 22-42%: with the 0.18 floor below-ground biomass NSE rose from 0.85 to 0.93 and above-ground mass and wood weight improved. Tested heights at which the floor is reached: 2.0-8.0 m; faster declines over-predict young above-ground growth (EM88, Tarpeena), slower ones over-predict SETRES roots. The Age-based form with the same 0.18 floor scored slightly higher (mean NSE 0.838 vs 0.835). Fine/coarse split below ground is set by Leaf.Fn (CoarseRootFraction). Stress effects on allocation (3-PG style) not yet included.",
                      "Name": "Memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.Constant, Models",
                      "FixedValue": 0.45,
                      "Units": null,
                      "Name": "Juvenile",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.Constant, Models",
                      "FixedValue": 0.18,
                      "Units": null,
                      "Name": "Mature",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.Constant, Models",
                      "FixedValue": 3.5,
                      "Units": "m",
                      "Name": "HeightAtMature",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.ExpressionFunction, Models",
                      "Units": "0-1",
                      "Expression": "1.0 - [Pinus].Partitioning.BelowGround.CoarseRootFraction",
                      "Name": "FineRootFraction",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Memo, Models",
                          "Text": "Above ground growth is simply set to the complement of the below ground partitioning.",
                          "Name": "Memo",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        }
                      ],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.ExpressionFunction, Models",
                      "Units": "0-1",
                      "Expression": "0.5 + 0.4*[Leaf].Fn",
                      "Name": "CoarseRootFraction",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Memo, Models",
                          "Text": "Coarse root allocations go down in favour of fine roots when N is limited",
                          "Name": "Memo",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        }
                      ],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                }
              ],
              "Enabled": true,
              "ReadOnly": false
