                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "using Models.Soils.Nutrients;",
                            "using System;",
                            "using Models.Core;",
                            "using Models.PMF;",
                            "using Models.Soils;",
                            "using Models.Soils.Nutrients;",
                            "using Models.Utilities;",
                            "using APSIM.Shared.Utilities;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable]",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] Clock Clock;",
                            "        [Link] Summary Summary;",
                            "        [Link] Soil Soil;",
                            "        [Link] Plant Wheat;",
                            "        Accumulator accumulatedRain;",
                            "        ",
                            "        [Description(\"Sowing date (d-mmm)\")]",
                            "        public string SowDate { get; set; }",
                            "        [Description(\"Cultivar to be sown\")]",
                            "        public string CultivarName { get; set; }",
                            "        [Description(\"Sowing depth (mm)\")]",
                            "        public double SowingDepth { get; set; }",
                            "        [Description(\"Row spacing (mm)\")]",
                            "        public double RowSpacing { get; set; }",
                            "        [Description(\"Plant population (/m2)\")]",
                            "        public double Population { get; set; }",
                            "        ",
                            "",
                            "",
                            "        [EventSubscribe(\"DoManagement\")]",
                            "        private void OnDoManagement(object sender, EventArgs e)",
                            "        {",
                            "            if (DateUtilities.WithinDates(SowDate, Clock.Today, SowDate))",
                            "            {",
                            "                Wheat.Sow(population: Population, cultivar: CultivarName, depth: SowingDepth, rowSpacing: RowSpacing);    ",
                            "            }",
                            "                if(SowDate == \"09-Mar\")",
                            "                {",
                            "                    Wheat.Phenology.SetPhaseCompletionDate(\"16-Mar\",\"Emerging\");",
                            "                }",
                            "                if(SowDate == \"30-Mar\")",
                            "                {",
                            "                    Wheat.Phenology.SetPhaseCompletionDate(\"11-Apr\",\"Emerging\");",
                            "                }",
                            "                if(SowDate == \"19-Apr\")",
                            "                {",
                            "                    Wheat.Phenology.SetPhaseCompletionDate(\"30-Apr\",\"Emerging\");",
                            "                }",
                            "        }",
                            "        ",
                            "    }",
                            "}"
                          ],
                          "Parameters": [
                            {
                              "Key": "SowDate",
                              "Value": ""
                            },
                            {
                              "Key": "CultivarName",
                              "Value": "Wakanui"
                            },
                            {
                              "Key": "SowingDepth",
                              "Value": "50"
                            },
                            {
                              "Key": "RowSpacing",
                              "Value": "150"
                            },
                            {
                              "Key": "Population",
                              "Value": "150"
                            }
                          ],
                          "Name": "Sowing",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Operations, Models",
                          "OperationsList": [
                            {
                              "$type": "Models.Operation, Models",
                              "Enabled": true,
                              "Date": "2018-02-04",
                              "Action": "[Wheat].Harvest();",
                              "Line": "2018-02-04 [Wheat].Harvest();"
                            },
                            {
                              "$type": "Models.Operation, Models",
                              "Enabled": true,
                              "Date": "2018-02-04",
                              "Action": "[Wheat].EndCrop();",
                              "Line": "2018-02-04 [Wheat].EndCrop();"
                            }
                          ],
                          "Name": "HarvestEvents",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "",
                            "using APSIM.Core;",
                            "using Models.Soils;",
                            "using System.Xml.Serialization;",
                            "using Models.PMF;",
                            "using Models.Core;",
                            "using System.Collections.Generic;",
                            "using System;",
                            "using Newtonsoft.Json;",
                            "using Models.PMF.Interfaces;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable] ",
                            "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                            "    public class Script : Model, IStructureDependency",
                            "    {",
                            "        [Link] private Plant Wheat;",
                            "        [Link] private Clock Clock;",
                            "        ",
                            "        public IStructure Structure { private get; set; }",
                            "",
                            "        [Description(\"Date that mouse damage event occurs\")]",
                            "        public DateTime NibblingDate { get; set; }",
                            "        [Description(\"Proportion of the crop removed by mice\")]",
                            "        public double ProportionNibbled { get; set; }",
                            "        [Description(\"Switch if crop is defoliated\")]",
                            "        public string Defoliated {get; set;}",
                            "        ",
                            "",
                            "        ",
                            "        [EventSubscribe(\"StartOfSimulation\")]",
                            "        private void OnSimulationCommencing(object sender, EventArgs e)",
                            "        {",
                            "            ",
                            "        }",
                            "        ",
                            "        [EventSubscribe(\"DoManagement\")]",
                            "        private void OnDoManagement(object sender, EventArgs e)",
                            "        {",
                            "            //Set up  array of remove fractions to send with Cut method.  Each member in the array corresponds to an organ in the same order they are set up in.",
                            "",
                            "            if (Clock.Today.Date == NibblingDate)",
                            "            {",
                            "                //Harvest with manager specified removal fractions",
                            "                Wheat.structure?.DoThin(ProportionNibbled);",
                            "                var Grain =   Structure.FindChild<IHasDamageableBiomass>(\"Grain\", relativeTo: (INodeModel)Wheat);",
                            "                var Leaf =   Structure.FindChild<IHasDamageableBiomass>(\"Leaf\", relativeTo: (INodeModel)Wheat);",
                            "                var Stem =   Structure.FindChild<IHasDamageableBiomass>(\"Stem\", relativeTo: (INodeModel)Wheat);",
                            "                var Spike =   Structure.FindChild<IHasDamageableBiomass>(\"Spike\", relativeTo: (INodeModel)Wheat);",
                            "                var Root =   Structure.FindChild<IHasDamageableBiomass>(\"Root\", relativeTo: (INodeModel)Wheat);",
                            "                Grain.RemoveBiomass(liveToRemove: 0, deadToRemove: 0.0, liveToResidue: ProportionNibbled, deadToResidue: 0.0);",
                            "                Leaf.RemoveBiomass(liveToRemove: 0, deadToRemove: 0.0, liveToResidue: ProportionNibbled, deadToResidue: 0.0);",
                            "                Stem.RemoveBiomass(liveToRemove: 0, deadToRemove: 0.0, liveToResidue: ProportionNibbled, deadToResidue: 0.0);",
                            "                Spike.RemoveBiomass(liveToRemove: 0, deadToRemove: 0.0, liveToResidue: ProportionNibbled, deadToResidue: 0.0);",
                            "                Root.RemoveBiomass(liveToRemove: 0, deadToRemove: 0.0, liveToResidue: 0, deadToResidue: 0.0);",
                            "",
                            "            }",
                            "        }",
                            "    }",
                            "}",
                            "",
                            "                "
                          ],
                          "Parameters": [
                            {
                              "Key": "NibblingDate",
                              "Value": "10/31/2002 00:00:00"
                            },
                            {
                              "Key": "ProportionNibbled",
                              "Value": "0.5"
                            },
                            {
                              "Key": "Defoliated",
                              "Value": "False"
                            }
                          ],
