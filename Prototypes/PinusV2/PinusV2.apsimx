                        }
                      ],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.ExpressionFunction, Models",
                      "Units": null,
                      "Expression": "0.0037+0.0034*2.71828^-([Pinus].Leaf.SpecificLeafAreaFunction.SLAPotential.HeightDecay*[Pinus].Stem.Ht)",
                      "Name": "SLAPotential",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Memo, Models",
                          "Text": "Potential SLA (m2/g), no Age: 0.0037 + 0.0034 x exp(-HeightDecay x Height). Replaces exp(-0.11 x Age) (2026-11-14). SLA falls as trees grow taller (more shaded, higher-light-acclimated and hydraulically limited foliage), so slow stands keep juvenile needles longer and fast stands lose them sooner. HeightDecay 0.16 /m: tested 0.098 (reproduces the old age curve on average), 0.13, 0.16, 0.20; 0.16 best fits BFG canopy SLA (85 obs, ages 10-14, ~0.0045; NSE -1.14 -> -0.28) and improved LAI (0.709 -> 0.732) and leaf mass.",
                          "Name": "Memo",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Functions.Constant, Models",
                          "FixedValue": 0.06,
                          "Units": null,
                          "Name": "Intercept",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Functions.Constant, Models",
                          "FixedValue": 3E-07,
                          "Units": null,
                          "Name": "Slope",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Functions.Constant, Models",
                          "FixedValue": 0.16,
                          "Units": "/m",
                          "Name": "HeightDecay",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        }
                      ],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.LinearInterpolationFunction, Models",
                  "Name": "FLAI",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "SenescenceRate was set to zero above, but here instead leaves are killed on a daily basis if stresses of temperature, nitrogen, water and LAI are high enough. Future model improvements could consider altering the senescence rate using these stresses as cummulative functions, but I have so far not been able to do so.   \r\n\r\n",
                      "Name": "Memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.XYPairs, Models",
                      "X": [
                        0.0,
                        4.0,
                        7.0
                      ],
                      "Y": [
                        1.0,
                        1.0,
                        0.0
                      ],
                      "Name": "XYPairs",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.MovingAverageFunction, Models",
                      "NumberOfDays": 1,
                      "StageToStartMovingAverage": "Emergence",
                      "Name": "XValue",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Functions.VariableReference, Models",
                          "VariableName": "[Leaf].LAI",
                          "Name": "LAI",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        }
                      ],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.MinimumFunction, Models",
                  "Name": "LeafKillFractionFactor",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Functions.VariableReference, Models",
                      "VariableName": "[Leaf].FLAI",
                      "Name": "FLAI",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.ExpressionFunction, Models",
                  "Units": null,
                  "Expression": "0.0+0.0*(1-[Leaf].LeafKillFractionFactor)",
                  "Name": "LeafKillFraction",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.MultiplyFunction, Models",
                  "Name": "LeafDevelopmentRate",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Functions.Constant, Models",
                      "FixedValue": 1.0,
                      "Units": "0-1",
                      "Name": "LDR",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.WeightedTemperatureFunction, Models",
                      "MaximumTemperatureWeighting": 1.0,
                      "Name": "FT",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Functions.XYPairs, Models",
                          "X": [
                            2.0,
                            20.0,
                            33.0,
                            34.0
                          ],
                          "Y": [
                            0.0,
                            1.0,
                            1.0,
                            0.0
                          ],
                          "Name": "XYPairs",
                          "ResourceName": null,
                          "Children": [
                            {
                              "$type": "Models.Memo, Models",
                              "Text": "This is an assumed and tuned function of Leaf development rate in relation to weighted air temperature.\r\n\r\n",
                              "Name": "Memo",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            }
                          ],
                          "Enabled": true,
                          "ReadOnly": false
                        }
                      ],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.Constant, Models",
                  "FixedValue": 0.52,
                  "Units": "g/g",
                  "Name": "CarbonConcentration",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "This value is wtihin the range of 0.50-0.53 reported by [#beets2018carbon] for _P. radiata_ foliage.\r\n\r\n",
                      "Name": "Memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.ExpressionFunction, Models",
                  "Units": null,
                  "Expression": "[Stem].Ht*1000",
                  "Name": "HeightFunction",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "This converts stem height in m to mm for use else where in the model, particularly in relation to competing vegetation.\r\n\r\n\n",
                      "Name": "Memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.PMF.NutrientPoolFunctions, Models",
                  "Name": "DMDemands",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "DM demands are set in a similar ways for each organ, but with different values: structural (default specified), metabolic (value = 0), and storage functions (1 - structural). Values measured range from about 5 to 50% for Pinus leaves ([#quentin2015non]), which also covers the range of 1-20% for other species and plant parts ([#hoch2003non]). Metabolic demand is set to zero, because RUE is a value for net growth for which a respiration calculation is not needed. These values may become an important focus if one attempts to use the model for coppicing, as is already the case in several other APSIM models, e.g. lucerne and gliricidia.  \r\n\r\n",
                      "Name": "Memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.MultiplyFunction, Models",
                      "Name": "Structural",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Functions.DemandFunctions.PartitionFractionDemandFunction, Models",
                          "Name": "DMDemandFunction",
                          "ResourceName": null,
                          "Children": [
                            {
                              "$type": "Models.Functions.VariableReference, Models",
                              "VariableName": "[Partitioning].LeafFraction",
                              "Name": "PartitionFraction",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            }
                          ],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Functions.Constant, Models",
                          "FixedValue": 1.0,
                          "Units": "0-1",
                          "Name": "StructuralFraction",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        }
                      ],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.Constant, Models",
                      "FixedValue": 0.0,
                      "Units": null,
                      "Name": "Metabolic",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.Constant, Models",
                      "FixedValue": 0.0,
                      "Units": null,
                      "Name": "Storage",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.PMF.NutrientPoolFunctions, Models",
                  "Name": "NDemands",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "N demands are set in a similar ways to DM demands, which are described above.  \r\n\r\n",
                      "Name": "Memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.MultiplyFunction, Models",
                      "Name": "Structural",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Functions.VariableReference, Models",
                          "VariableName": "[Leaf].minimumNconc",
                          "Name": "MinNconc",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Functions.VariableReference, Models",
                          "VariableName": "[Leaf].potentialDMAllocation.Structural",
                          "Name": "PotentialDMAllocation",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        }
                      ],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.Constant, Models",
                      "FixedValue": 0.0,
                      "Units": null,
                      "Name": "Metabolic",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.DemandFunctions.StorageNDemandFunction, Models",
                      "Name": "Storage",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Functions.VariableReference, Models",
                          "VariableName": "[Leaf].MaximumNconc",
                          "Name": "MaxNconc",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Functions.Constant, Models",
                          "FixedValue": 1.0,
                          "Units": null,
                          "Name": "NitrogenDemandSwitch",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        }
                      ],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.Constant, Models",
                  "FixedValue": 0.0,
                  "Units": "/d",
                  "Name": "SenescenceRate",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.ExpressionFunction, Models",
                  "Units": null,
                  "Expression": "[CoverGreenFunction].Occupancy * (1 - exp(-[Leaf].ExtinctionCoefficient * [Leaf].LAI / [CoverGreenFunction].Occupancy))",
                  "Name": "CoverGreenFunction",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Functions.ExpressionFunction, Models",
                      "Units": null,
                      "Expression": "([ExtinctionCoefficient].KMatureTrees+([ExtinctionCoefficient].KYoungTrees-[ExtinctionCoefficient].KMatureTrees)*Exp((0-2)*([Pinus].Leaf.LAI/[ExtinctionCoefficient].LAIIntermediateK)^[ExtinctionCoefficient].ShapeCurve))",
                      "Name": "ExtinctionCoefficient",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Memo, Models",
                          "Text": "Typical extinction coefficients for other plant types are provided here.\r\n\r\n\n",
                          "Name": "Memo",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Functions.Constant, Models",
                          "FixedValue": 0.5,
                          "Units": null,
                          "Name": "KYoungTrees",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Functions.Constant, Models",
                          "FixedValue": 0.5,
                          "Units": null,
                          "Name": "KMatureTrees",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Functions.Constant, Models",
                          "FixedValue": 0.7,
                          "Units": null,
                          "Name": "LAIIntermediateK",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Functions.Constant, Models",
                          "FixedValue": 2.0,
                          "Units": null,
                          "Name": "ShapeCurve",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        }
                      ],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.ExpressionFunction, Models",
                      "Units": "0-1",
                      "Expression": "max(0.01, min(1, [Pinus].Population * 3.14159 * ([Occupancy].CrownRadiusCoefficient * max(0.1, [Pinus].Stem.Ht)^[Occupancy].CrownRadiusExponent)^2))",
                      "Name": "Occupancy",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Memo, Models",
                          "Text": "Fraction of ground occupied by crowns, no Age: Population x pi x crown radius^2 (capped at 1), crown radius (m) = CrownRadiusCoefficient x Height^CrownRadiusExponent. 0.30 x H^0.85 (2026-11-17; was 0.55 x H^0.6 from 2026-11-14) gives crown radius 0.8 m at 3 m, 1.2 m at 5 m, 2.1 m at 10 m and 3.8 m at 20 m height, so young stands close their canopy later. With the old form the OFO plots carried LAI 4.4 at age 3 (young radiata ~1-2) and young trees were about twice the observed DBH at the same height. New form: validation young-stand DBH (age <=5) x1.21 -> x1.04, LAI at age 3 ~2.0; crown form alone: validation mean NSE 0.839, OFO BA NSE 0.40 -> 0.475, treatment responses unchanged. Not yet checked against measured pine crown widths.",
                          "Name": "Memo",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Functions.Constant, Models",
                          "FixedValue": 0.3,
                          "Units": "m",
                          "Name": "CrownRadiusCoefficient",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Functions.Constant, Models",
                          "FixedValue": 0.85,
                          "Units": null,
