                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Operations, Models",
                          "OperationsList": [
                            {
                              "$type": "Models.Operation, Models",
                              "Enabled": true,
                              "Date": "2002-05-28",
                              "Action": "[Irrigation].Apply(200);",
                              "Line": "2002-05-28 [Irrigation].Apply(200);"
                            }
