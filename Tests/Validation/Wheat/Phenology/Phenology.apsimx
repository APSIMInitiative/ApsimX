                    {
                      "$type": "Models.Manager, Models",
                      "CodeArray": [
                        "using Models.PMF.Phen;",
                        "using APSIM.Shared.Utilities;",
                        "using Models.Utilities;",
                        "using Models.Soils;",
                        "using Models.PMF;",
                        "using Models.Core;",
                        "using System;",
                        "using Models.Climate;",
                        "using System.Globalization;",
                        "",
                        "namespace Models",
                        "{",
                        "    [Serializable]",
                        "    public class Script : Model",
                        "    {",
                        "        [Link] private Clock clock;",
                        "        [Link] private Summary summary;",
                        "        [Link] private Plant wheat;",
                        "        [Link] private ControlledEnvironment ci;",
                        "        [Link]",
                        "        private Phenology phenology;",
                        "",
                        "        [Display(Type = DisplayType.CultivarName)]",
                        "        [Description(\"Cultivar to be sown\")]",
                        "        public string CultivarName { get; set; }",
                        "        [Description(\"Sowing depth (mm)\")]",
                        "        public double SowingDepth { get; set; }",
                        "        [Description(\"Treatment duration (Weeks)\")]",
                        "        public double TransitionWeek { get; set; }",
                        "        [Description(\"Treatment temperature (oC)\")]",
                        "        public double TreatTemp { get; set; }",
                        "        [Description(\"Treatment photoperiod (h)\")]",
                        "        public double TreatPp { get; set; }",
                        "        private double DAS {get; set;}",
                        "        private bool FirstDay = true;",
                        "        private double Weeks {get; set;}",
                        "        private bool Transitioned = false;",
                        "        private bool Emerged = false;",
                        "",
                        "        [EventSubscribe(\"PreparingNewWeatherData\")]",
                        "        private void OnPreparingNewWeatherData(object sender, EventArgs e)",
                        "        {",
                        "            if (FirstDay)",
                        "            {",
                        "                wheat.Sow(population: 100, cultivar: CultivarName, depth: SowingDepth, rowSpacing: 150);    ",
                        "                FirstDay = false;",
                        "                summary.WriteMessage(this,\"Wheat crop sown\", MessageType.Diagnostic);",
                        "            }",
                        "",
                        "            if((phenology.AccumulatedTT >= 90)&&(Emerged==false))",
                        "            {",
                        "                wheat.Phenology.SetPhaseCompletionDate(clock.Today.ToString(\"dd-MMM\", CultureInfo.InvariantCulture),\"Emerging\");",
                        "                Emerged =true;",
                        "            }",
                        "",
                        "            DAS += 1;",
                        "            Weeks = DAS/7.0;",
                        "            if (Weeks <= TransitionWeek)",
                        "            {",
                        "                ci.MaxT = TreatTemp;",
                        "                ci.MinT = TreatTemp;",
                        "                ci.DayLength = TreatPp;",
                        "                ci.Radn = TreatPp * 3600 * 0.000153 * 2; //Hours * s/h * MJ/m2/s * Coeff_PAR->Total ",
                        "            }",
                        "            else",
                        "            {",
                        "                if (Transitioned = false)",
                        "                {",
                        "                    Transitioned = true;",
                        "                    summary.WriteMessage(this,\"Plants moved to post treatment chamber\", MessageType.Diagnostic);",
                        "                }",
                        "                ci.MaxT=23.6;",
                        "                ci.MinT=23.6;",
                        "                ci.DayLength = 16;",
                        "                ci.Radn = 16 * 3600 * 0.000153 * 2; //Hours * s/h * MJ/m2/s * Coeff_PAR->Total ",
                        "            }",
                        "        }",
                        "    }",
                        "}"
                      ],
                      "Parameters": [
                        {
                          "Key": "CultivarName",
                          "Value": ""
                        },
                        {
                          "Key": "SowingDepth",
                          "Value": "100"
                        },
                        {
                          "Key": "TransitionWeek",
                          "Value": "0"
                        },
                        {
                          "Key": "TreatTemp",
                          "Value": "0"
                        },
                        {
                          "Key": "TreatPp",
                          "Value": "0"
                        }
                      ],
                      "Name": "Experiment",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Manager, Models",
                      "CodeArray": [
                        "using Models.PMF.Phen;",
                        "using APSIM.Shared.Utilities;",
                        "using Models.Utilities;",
                        "using Models.Soils;",
                        "using Models.PMF;",
                        "using Models.Core;",
                        "using System;",
                        "using Models.Soils.Nutrients;",
                        "",
                        "namespace Models",
                        "{",
                        "    [Serializable]",
                        "    public class Script : Model",
                        "    {",
                        "        [Link] private Plant Wheat;",
                        "        [Link] private Clock clock;",
                        "        [Link(Type = LinkType.Path, Path = \"[Wheat].Phenology\")]",
                        "        private Phenology phenology;",
                        "",
                        "        [EventSubscribe(\"DoManagement\")]",
                        "        private void OnDoManagement(object sender, EventArgs e)",
                        "        {",
                        "            if (phenology.CurrentPhase.Name==\"GrainFilling\")",
                        "            {",
                        "               Wheat.Harvest();",
                        "               Wheat.EndCrop();    ",
                        "               clock.EndDate = clock.Today.Date;",
                        "            }",
                        "        ",
                        "        }",
                        "        ",
                        "    }",
                        "}"
                      ],
                      "Parameters": [],
                      "Name": "HarvestAtFlowering",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
