      "$type": "Models.Factorial.Experiment, Models",
      "DisabledSimNames": [
        "Lincoln2023SD19AprCVCesario",
        "Lincoln2023SD27MarCVCesario",
        "Lincoln2023SD19AprCVStockade",
        "Lincoln2023SD27MarCVStockade",
