                                {
                                  "Key": "MinimumInterval",
                                  "Value": "15"
                                },
                                {
                                  "Key": "EnforceMaximumInterval",
                                  "Value": "No"
                                },
                                {
                                  "Key": "MaximumInterval",
                                  "Value": "90"
                                },
                                {
