                                  "Value": "15"
                                },
                                {
                                  "Key": "EnforceMaximumInterval",
                                  "Value": "No"
                                },
                                {
                                  "Key": "MaximumInterval",
                                  "Value": "90"
                                },
                                {
                                  "Key": "DMRemoveType",
                                  "Value": "UserDefinedFraction"
                                },
                                {
                                  "Key": "FractionDMToRemove",
                                  "Value": "0.99"
                                },
                                {
                                  "Key": "NRemoveType",
                                  "Value": "UserDefinedFraction"
                                },
                                {
                                  "Key": "FractionNToRemove",
                                  "Value": "0.99"
                                },
                                {
                                  "Key": "ReturnType",
                                  "Value": "AsResidue"
                                },
                                {
                                  "Key": "NDungType",
                                  "Value": "DefineCNratio"
                                },
                                {
                                  "Key": "ProportionOfNToDung",
                                  "Value": "0.4"
                                },
                                {
                                  "Key": "CNRatioDung",
                                  "Value": "17.5"
                                },
                                {
                                  "Key": "UrineDepth",
                                  "Value": "250"
                                },
                                {
                                  "Key": "SettingUrineNAmount",
                                  "Value": "No"
                                },
                                {
                                  "Key": "UrineNSetAmount",
                                  "Value": "2"
                                },
                                {
