        {
          "$type": "Models.Core.Folder, Models",
          "ShowInDocs": true,
          "Name": "SkipRow",
          "ResourceName": null,
          "Children": [
            {
              "$type": "Models.Factorial.Experiment, Models",
              "DisabledSimNames": null,
              "Name": "SkipRow",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Documentation, Models",
                  "Text": "Skipped rows (ie planting configurations where some plant rows are not planted to delay water stress and therefore minimise terminal water stress) are commonly used to minimise crop risk of drought failure.\nThis simulation includes three simulations for different planting arrangements.\n1) Solid planting - all rows are planted\n2) Single skip - 2 of every 3 rows are planted and one row is skipped (ie not planted)\n3) Double Skip - 2 of every 4 rows are planted and two rows are skipped.\n\nYields in planted rows should be higher than in solid plantings in most years due to the increased water supply for plants from the skipped rows.\n\nYields for the entire field, however, should follow differing trends.  In high yielding years, solid plantings may be highest because radiation interception is higher.  In very dry years, all arrangements may be low.  In intermediate years, there may be benefits in skipped arrangements.",
                  "Name": "Documentation",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Factorial.Factors, Models",
                  "Name": "Factors",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Factorial.Factor, Models",
                      "Specification": "",
                      "Name": "Skip",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Factorial.CompositeFactor, Models",
                          "Specifications": [
                            "[CottonZone].Width=2",
                            "[SkipZone].Width=2"
                          ],
                          "CustomDescriptors": [],
                          "Name": "Double",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
