            {
              "$type": "Models.Factorial.Experiment, Models",
              "DisabledSimNames": null,
              "Name": "FAR RRC W21-03",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Memo, Models",
                  "Text": "# Field Applied Research (FAR) Australia trial FAR RRC W21-03 at Wallendbeen in 2021. \r\n\r\nThis trial has been selected because it contained 7 cultivars of interest, and had up to 6 Greenseeker (NDVI), 3 biomass, 0 N concentration or 13 growth stage measurements. \r\n\r\n*Grazing/defolation treatments have been excluded.* \r\n\r\nTrial description: **Performance of winter and spring wheat germplasm managed under three different levels of management (20th April sown).** \r\n\r\n[Trial write-up](https://faraustralia.com.au/wp-content/uploads/2022/04/HYC-2021-Results-FINAL.pdf) \r\n\r\n",
                  "Name": "Description",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Factorial.Factors, Models",
