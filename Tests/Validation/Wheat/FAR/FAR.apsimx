                              "$type": "Models.Factorial.CompositeFactor, Models",
                              "Specifications": [
                                "[Sowing].Script.Treat = Standard",
                                "[FertDate3].Script.FertiliserType = UreaN",
                                "[FertDate3].Script.FertiliserDates = 6-sep",
                                "[FertDate3].Script.Amount = 0"
                              ],
                              "Paths": null,
