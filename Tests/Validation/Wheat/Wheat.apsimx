                            },
                            {
                              "$type": "Models.Manager, Models",
                              "CodeArray": [
                                "using Newtonsoft.Json;",
                                "using System.Data;",
                                "using System.Xml.Serialization;",
                                "using Models;",
                                "using System.Text;",
                                "using System.Collections.Generic;",
                                "using Models.Interfaces;",
                                "using System;",
                                "using Models.Core;",
                                "using Models.PMF;",
                                "using Models.Soils;",
                                "using Models.Utilities;",
                                "using APSIM.Shared.Utilities;",
                                "",
                                "namespace Models",
                                "{",
                                "    [Serializable]",
                                "    public class Script : Model",
                                "    {",
                                "        [Link] Clock Clock;",
                                "        [Link] Plant Wheat;",
                                "        ",
                                "        [Description(\"Sowing date (d-mmm)\")]",
                                "        public string SowDate { get; set; }",
                                "        [Display(Type = DisplayType.CultivarName)]",
                                "        [Description(\"Cultivar to be sown\")]",
                                "        public string CultivarName { get; set; }",
                                "        [Description(\"Sowing depth (mm)\")]",
                                "        public double SowingDepth { get; set; }",
                                "        [Description(\"Row spacing (mm)\")]",
                                "        public double RowSpacing { get; set; }",
                                "        [Description(\"Plant population (/m2)\")]",
                                "        public double Population { get; set; }",
                                "        [Description(\"Emergence date (d-mmm)\")]",
                                "        public string EmergDate { get; set; }",
                                "        ",
                                "",
                                "",
                                "        [EventSubscribe(\"DoManagement\")]",
                                "        private void OnDoManagement(object sender, EventArgs e)",
                                "        {",
                                "",
                                "            if (DateUtilities.WithinDates(SowDate, Clock.Today, SowDate))",
                                "            {",
                                "                Wheat.Sow(population: Population, cultivar: CultivarName, depth: SowingDepth, rowSpacing: RowSpacing);    ",
                                "                Wheat.Phenology.SetPhaseCompletionDate(EmergDate,\"Emerging\");",
                                "            }",
                                "        ",
                                "        }",
                                "        ",
                                "    }",
                                "}"
                              ],
                              "Parameters": [
                                {
                                  "Key": "SowDate",
                                  "Value": "21-Dec"
                                },
                                {
                                  "Key": "CultivarName",
                                  "Value": "Yecora"
                                },
                                {
                                  "Key": "SowingDepth",
                                  "Value": "50"
                                },
                                {
                                  "Key": "RowSpacing",
                                  "Value": "250"
                                },
                                {
                                  "Key": "Population",
                                  "Value": "186"
                                },
                                {
                                  "Key": "EmergDate",
                                  "Value": "1-Jan"
                                }
                              ],
                              "Name": "Sow",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            },
                            {
                              "$type": "Models.Manager, Models",
                              "CodeArray": [
                                "using Models.PMF.Phen;",
                                "using APSIM.Shared.Utilities;",
                                "using System.Xml.Serialization;",
                                "using Models;",
                                "using Models.PMF;",
                                "using Models.Soils;",
                                "using System.Text;",
                                "using System.Collections.Generic;",
                                "using Models.Core;",
                                "using System;",
                                "using Models.Soils.Nutrients;",
                                "",
                                "namespace Models",
                                "{",
                                "    [Serializable] ",
                                "    public class Script : Model",
                                "    {",
                                "        [Link] private Plant Wheat;",
                                "        [Link(Type = LinkType.Path, Path = \"[Wheat].Phenology\")]",
                                "        private Phenology phenology;",
                                "        [Link] private Clock clock;",
                                "        [EventSubscribe(\"DoManagement\")]",
                                "        private void OnDoManagement(object sender, EventArgs e)",
                                "        {",
                                "            if (DateUtilities.WithinDates(clock.EndDate, clock.Today, clock.EndDate))",
                                "            {",
                                "                Wheat.Harvest();",
                                "                Wheat.EndCrop();",
                                "            }",
                                "        }",
                                "    }",
                                "}",
                                "       "
                              ],
                              "Parameters": [],
                              "Name": "Harvest",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            },
                            {
                              "$type": "Models.Manager, Models",
                              "CodeArray": [
                                "using APSIM.Core;",
                                "using APSIM.Shared.Utilities;",
                                "using System.Xml.Serialization;",
                                "using Models;",
                                "using Models.PMF;",
                                "using System.Text;",
                                "using System.Collections.Generic;",
                                "using Models.Core;",
                                "using System;",
                                "using Models.Soils;",
                                "",
                                "namespace Models",
                                "{",
                                "    [Serializable] ",
                                "    public class Script : Model, IStructureDependency",
                                "    {",
                                "        [Link] private Plant Plant;",
                                "        [Link] private Clock Clock;",
                                "        [Link] private Zone zone;",
                                "        public IStructure Structure { private get; set; }",
                                "        ",
                                "",
                                "        ",
                                "",
                                "        [EventSubscribe(\"Sowing\")]",
                                "        private void OnSowing(object sender, EventArgs e)",
                                "        {",
                                "            double resetvalue = 9;",
                                "            object ResetValue = resetvalue;",
                                "            Structure.Set(\"Wheat.Phenology.CAMP.FLNparams.MinLN\", ResetValue, relativeTo: zone);",
                                "            resetvalue = 0;",
                                "            ResetValue = resetvalue;",
                                "            Structure.Set(\"Wheat.Phenology.CAMP.FLNparams.VrnLN\", ResetValue, relativeTo: zone);",
                                "            resetvalue = 0;",
                                "            ResetValue = resetvalue;",
                                "            Structure.Set(\"Wheat.Phenology.CAMP.FLNparams.PpLN\", ResetValue, relativeTo: zone);",
                                "            resetvalue = 0;",
                                "            ResetValue = resetvalue;",
                                "            Structure.Set(\"Wheat.Phenology.CAMP.FLNparams.VxPLN\", ResetValue, relativeTo: zone);",
                                "            resetvalue = 1.0;",
                                "            ResetValue = resetvalue;",
                                "            Structure.Set(\"Wheat.Leaf.Photosynthesis.FVPD.XYPairs.Y[3]\", ResetValue, relativeTo: zone);",
                                "        }",
                                "    }",
                                "}"
                              ],
                              "Parameters": [],
                              "Name": "ForceCropFits",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            },
