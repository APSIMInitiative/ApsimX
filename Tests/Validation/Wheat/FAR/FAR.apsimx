            {
              "$type": "Models.Factorial.Experiment, Models",
              "DisabledSimNames": null,
              "Name": "FAR WAA W22-01",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Memo, Models",
                  "Text": "# Field Applied Research (FAR) Australia trial FAR WAA W22-01 at Albany in 2022. \r\n\r\nThis trial has been selected because it contained 6 cultivars of interest, and had up to 3 Greenseeker (NDVI), 1 biomass, 0 N concentration or 6 growth stage measurements. \r\n\r\n*Grazing/defolation treatments have been excluded.* \r\n\r\nTrial description: **Compare winter and spring wheat germplasm under different levels of management sown on 20 April.** \r\n\r\n[Trial write-up](https://faraustralia.com.au/wp-content/uploads/2023/03/HRZ-2022-Esperance-Cereal-Results_FINAL.pdf) \r\n\r\n",
                  "Name": "Description",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Factorial.Factors, Models",
                  "Name": "Factors",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Factorial.Permutation, Models",
                      "Name": "Permutation",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Factorial.Factor, Models",
                          "Specification": null,
                          "Name": "Mgmt",
                          "ResourceName": null,
                          "Children": [
                            {
                              "$type": "Models.Factorial.CompositeFactor, Models",
                              "Specifications": [
                                "[Sowing].Script.Treat = Standard",
                                "[FertDate2].Script.FertiliserType = UreaN",
                                "[FertDate2].Script.FertiliserDates = 20-jul",
                                "[FertDate2].Script.Amount = 0"
                              ],
                              "Paths": null,
                              "Values": null,
                              "Name": "Standard",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            },
                            {
                              "$type": "Models.Factorial.CompositeFactor, Models",
                              "Specifications": [
                                "[Sowing].Script.Treat = Grazed",
                                "[FertDate2].Script.FertiliserType = UreaN",
                                "[FertDate2].Script.FertiliserDates = 20-jul",
                                "[FertDate2].Script.Amount = 0"
                              ],
                              "Paths": null,
