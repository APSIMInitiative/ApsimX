                            "[Soil].Water.Volumetric[1:3]",
                            "[Soil].Water.Volumetric",
                            "sum([Soil].SoilWater.ESW) as TotalESW",
                            "[Soil].SoilWater.SW",
                            "([Soil].SoilWater.SWmm[1]+[Soil].SoilWater.SWmm[2]+[Soil].SoilWater.SWmm[3]+[Soil].SoilWater.SWmm[4]+[Soil].SoilWater.SWmm[5]+[Soil].SoilWater.SWmm[6]) as SWmm1800",
                            "([Soil].SoilWater.ESW[1]+[Soil].SoilWater.ESW[2]+[Soil].SoilWater.ESW[3]+[Soil].SoilWater.ESW[4]+[Soil].SoilWater.ESW[5]+[Soil].SoilWater.ESW[6]) as ESW1800",
                            "sum([Soil].NO3.kgha) as TotalSoilNO3",
                            "sum([Soil]..NH4.kgha) as TotalSoilNH4",
                            "sum([Soil].Water.MM) as TotalSW",
                            "sum([Soil].NO3.ppm) as NO3",
                            "sum([Soil].NH4.ppm) as NH4",
                            "sum([Soil].Water.Volumetric) as TotalSWC",
                            "sum([Soil].Water.MM) as TotalWaterMM",
                            "([Soil].Water.MM[1]+[Soil].Water.MM[2]+[Soil].Water.MM[3]+[Soil].Water.MM[4]+[Soil].Water.MM[5]+[Soil].Water.MM[6]+[Soil].Water.MM[7]) as SW1500mm",
                            "([Soil].Water.MM[1]+[Soil].Water.MM[2]+[Soil].Water.MM[3]+[Soil].Water.MM[4]+[Soil].Water.MM[5]+[Soil].Water.MM[6]) as SW1800mm",
                            "([Soil].Water.MM[1]+[Soil].Water.MM[2]+[Soil].Water.MM[3]+[Soil].Water.MM[4]+[Soil].Water.MM[5]) as SW1200mm",
                            "(sum([CottonSoil].PAWmm)/sum([CottonSoil].PAWCmm)) as AvailableSoilMoisture",
                            "([CottonSoil].PAWmm[1]+[CottonSoil].PAWmm[2]+[CottonSoil].PAWmm[3]+[CottonSoil].PAWmm[4]+[CottonSoil].PAWmm[5]) as PAWTop5Layers",
                            "-(([CottonSoil].PAWCmm[1]+[CottonSoil].PAWCmm[2]+[CottonSoil].PAWCmm[3]+[CottonSoil].PAWCmm[4]+[CottonSoil].PAWCmm[5])-([CottonSoil].PAWmm[1]+[CottonSoil].PAWmm[2]+[CottonSoil].PAWmm[3]+[CottonSoil].PAWmm[4]+[CottonSoil].PAWmm[5])) as SoilWaterDeficit120",
                            "[Irrigation].IrrigationApplied",
                            "[Cotton].Boll.Wt",
                            "[Cotton].Lint.Wt",
                            "[Cotton].Seed.Wt",
                            "[Cotton].Bur.Wt",
                            "[Cotton].NitrogenUptake",
                            "sum([Soil].SoilWater.SWmm) as TotalSWmm",
                            "",
                            "",
                            "([Soil].SoilWater.SWmm[1]) as SW1",
                            "([Soil].SoilWater.SWmm[2]) as SW2",
                            "([Soil].SoilWater.SWmm[3]) as SW3",
                            "([Soil].SoilWater.SWmm[4]) as SW4",
                            "([Soil].SoilWater.SWmm[5]) as SW5",
                            "([Soil].SoilWater.SWmm[6]) as SW6",
                            "([Soil].SoilWater.SWmm[1]+[Soil].SoilWater.SWmm[2]+[Soil].SoilWater.SWmm[3]+[Soil].SoilWater.SWmm[4]+[Soil].SoilWater.SWmm[5]+[Soil].SoilWater.SWmm[6]) as SWmm1800",
                            "",
                            "",
                            "//to disable reporting",
                            "",
                            "([Soil].SoilWater.SWmm[7]) as SW7",
                            "([Soil].SoilWater.SWmm[8]) as SW8",
                            "([Soil].SoilWater.SWmm[9]) as SW9",
                            "([Soil].SoilWater.SWmm[1]+[Soil].SoilWater.SWmm[2]+[Soil].SoilWater.SWmm[3]+[Soil].SoilWater.SWmm[4]+[Soil].SoilWater.SWmm[5]+[Soil].SoilWater.SWmm[6]+[Soil].SoilWater.SWmm[7]+[Soil].SoilWater.SWmm[8]) as SWmm2400",
                            "",
