                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "",
                            "using Models.Soils;",
                            "using System;",
                            "using Models.Core;",
                            "using Models.PMF;",
                            "namespace Models",
                            "{",
                            "    [Serializable] ",
                            "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] Plant Plant;",
                            "        [Link] Clock Clock;",
                            "",
                            "        [Description(\"Spacing (m) between plants within rows\")]",
                            "        public double RowSpace { get; set; }",
                            "        [Description(\"Spacing (m) between rows\")]",
                            "        public double RowWidth { get; set; }",
                            "",
                            "        [Description(\"Cultivar\")]",
                            "        [Display(Type=DisplayType.CultivarName)]",
                            "        public string CultivarName { get; set; }",
                            "        [Description(\"Sowing Date\")]",
                            "        public DateTime SowingDate { get; set; }",
                            "",
                            "        [EventSubscribe(\"DoManagement\")]",
                            "        private void OnDoManagement(object sender, EventArgs e)",
                            "        {",
                            "            double PlantPopulation = 1 / (RowWidth * RowSpace);",
                            "",
                            "            if (Clock.Today.Date == SowingDate)",
                            "                Plant.Sow(population: PlantPopulation, ",
                            "                    cultivar: CultivarName, ",
                            "                    depth: 100, ",
                            "                    rowSpacing: 150);",
                            "            //Plant.Sow(... Contains the following arguements:",
                            "            //Population  double  Required  Seeds sowing/m2",
                            "            //Cultivar    string  Required  \"NameOfCultivar\"",
                            "            //Depth       double  Optional  Depth (mm) seed sown.   Default is 100mm ",
                            "            //MaxCover    double  Optional  Proportion (0-1) of the ground row crop will cover.   Default is 1.0",
                            "            //BudNumber   double  Optional  Number of mainstems per seed sown.  Default is 1.0",
                            "            //RowSpacing  double  Optional  Spaceing (mm) between drill rows when crop is sown.  Default is 150mm",
                            "            //CropClass   string  Optional  Crop class to instantiate when crop is sown.  Default is \"Plant\"",
                            "        }",
                            "    }",
                            "}",
                            "                "
                          ],
                          "Parameters": [
                            {
                              "Key": "RowSpace",
                              "Value": "2.67"
                            },
                            {
                              "Key": "RowWidth",
                              "Value": "2.67"
                            },
                            {
                              "Key": "CultivarName",
                              "Value": "BFGCorrImpSCsla"
                            },
                            {
                              "Key": "SowingDate",
                              "Value": "07/15/1936 00:00:00"
                            }
                          ],
                          "Name": "TreeSowingRule",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "using APSIM.Core;",
                            "using Models.Soils;",
                            "using Models.Interfaces;",
                            "using APSIM.Shared.Utilities;",
                            "using System.Xml.Serialization;",
                            "using Models.PMF;",
                            "using Models.Core;",
                            "using System.Collections.Generic;",
                            "using System.Linq;",
                            "using System;",
                            "using Newtonsoft.Json;",
                            "using Models.PMF.Interfaces;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable] ",
                            "    public class Script : Model, IStructureDependency",
                            "    {",
                            "        [Link] private Plant Tree;",
                            "        ",
                            "        public IStructure Structure { private get; set; }",
                            "",
                            "        [Description(\"Bias away from average (e.g. 0.5 for thinning from below, and 2 for thinning from above)\")]",
                            "        public double ThinBias { get; set; } = 0.7;",
                            "",
                            "        ",
                            "        public void DoThin(double ThinFr, double ThinBias)",
                            "        {",
                            "            //Set up  array of remove fractions to send with Cut method.  Each member in the array corresponds to an organ in the same order they are set up in.",
                            "            //Set thinning bias away from average for biomass components (not for population), e.g. 0.5 for thinning from below, and 2 for thinning from above, ",
                            "            //i.e. average individual tree size changes",
                            "",
                            "            //Harvest with manager specified removal fractions",
                            "            Tree.structure?.DoThin(ThinFr*ThinBias);",
                            "            var Leaf =   Structure.FindChild<IHasDamageableBiomass>(\"Leaf\", relativeTo: (INodeModel)Tree);",
                            "            var Stem =   Structure.FindChild<IHasDamageableBiomass>(\"Stem\", relativeTo: (INodeModel)Tree);",
                            "            var Branch =   Structure.FindChild<IHasDamageableBiomass>(\"Branch\", relativeTo: (INodeModel)Tree);",
                            "            var FineRoot =   Structure.FindChild<IHasDamageableBiomass>(\"FineRoot\", relativeTo: (INodeModel)Tree);",
                            "            var CoarseRoot =   Structure.FindChild<IHasDamageableBiomass>(\"CoarseRoot\", relativeTo: (INodeModel)Tree);",
                            "            Leaf.RemoveBiomass(liveToResidue: ThinFr*ThinBias);",
                            "            Stem.RemoveBiomass(liveToResidue: ThinFr*ThinBias);",
                            "            Branch.RemoveBiomass(liveToResidue: ThinFr*ThinBias);",
                            "            FineRoot.RemoveBiomass(liveToResidue: ThinFr*ThinBias);",
                            "            CoarseRoot.RemoveBiomass(liveToResidue: ThinFr*ThinBias);",
                            "",
                            "            Tree.Population = Tree.Population*(1-ThinFr);",
                            "        }",
                            "    }",
                            "}",
                            "",
                            "                "
                          ],
                          "Parameters": [
                            {
                              "Key": "ThinBias",
                              "Value": "0.5"
                            }
                          ],
                          "Name": "TreeThinning",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Operations, Models",
                          "OperationsList": [
                            {
                              "$type": "Models.Operation, Models",
                              "Enabled": true,
                              "Date": "1942-07-15",
                              "Action": "[TreeThinning].Script.DoThin(0.1107, 1.5);",
                              "Line": "1942-07-15 [TreeThinning].Script.DoThin(0.1107, 1.5);"
                            },
                            {
                              "$type": "Models.Operation, Models",
                              "Enabled": true,
                              "Date": "1950-07-15",
                              "Action": "[TreeThinning].Script.DoThin(0.029718876, 1.5);",
                              "Line": "1950-07-15 [TreeThinning].Script.DoThin(0.029718876, 1.5);"
                            },
                            {
                              "$type": "Models.Operation, Models",
                              "Enabled": true,
                              "Date": "1952-07-15",
                              "Action": "[TreeThinning].Script.DoThin(0.171357616, 1.5);",
                              "Line": "1952-07-15 [TreeThinning].Script.DoThin(0.171357616, 1.5);"
