              ],
              "Name": "Harvesting",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Report, Models",
              "VariableNames": [
                "[Simulation].Name",
                "[Clock].Today",
                "[Wheat].SowingDate",
                "[Wheat].SowingData.Cultivar",
                "[Wheat].Phenology.EmergenceDAS",
