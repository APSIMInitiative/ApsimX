            {
              "$type": "Models.Factorial.Experiment, Models",
              "DisabledSimNames": null,
              "Name": "FAR WAG W22-03",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Memo, Models",
                  "Text": "# Field Applied Research (FAR) Australia trial FAR WAG W22-03 at Finley in 2022. \r\n\r\nThis trial has been selected because it contained 2 cultivars of interest, and had up to 3 Greenseeker (NDVI), 0 biomass, 0 N concentration or 3 growth stage measurements. \r\n\r\n*Grazing/defolation treatments have been excluded.* \r\n\r\nTrial description: **The project aims to test the performance of longer season wheat and barley types in cropping regions subject to lower rainfall and higher temperatures. In 2022 the Griffith site was set up to evaluate the response in yield and grain quality of various varieties of wheat and barley sown at 2 sowing times** \r\n\r\n[Some trial details may be found here](https://faraustralia.com.au/resource) \r\n\r\n",
                  "Name": "Description",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Factorial.Factors, Models",
                  "Name": "Factors",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Factorial.Permutation, Models",
                      "Name": "Permutation",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Factorial.Factor, Models",
                          "Specification": "[Sowing].Script.CultivarName = Accroc, Bennett, Illabo, Rockstar, Scepter",
                          "Name": "Cv",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        }
                      ],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
