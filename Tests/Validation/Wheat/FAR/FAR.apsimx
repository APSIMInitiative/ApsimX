                              "Key": "SoluteName",
                              "Value": "NH4"
                            },
                            {
                              "Key": "DateCsvString",
                              "Value": "2019/09/9"
                            },
                            {
                              "Key": "ValueCsvString",
                              "Value": "6.08,4.1,4.72"
                            },
                            {
                              "Key": "ThicknessCsvString",
                              "Value": "299,300,300"
                            }
                          ],
