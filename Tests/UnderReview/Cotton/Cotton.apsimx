                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "using Models.Soils;",
                            "using Models.Functions;",
                            "using APSIM.Shared.Utilities;",
                            "using System.Xml.Serialization;",
                            "using Models;",
                            "using Models.PMF;",
                            "using System.Text;",
                            "using System.Collections.Generic;",
                            "using Models.Core;",
                            "using System;",
                            "using Models.PMF.Organs;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable] ",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] private Plant Cotton;",
                            "        [Link] private Clock Clock;",
                            "        [Link] private Zone zone;",
                            "        [Link(Type = LinkType.Path, Path = \"[Cotton].Root\")]",
                            "        private Root root;",
                            "",
                            "        [Description(\"Use extra root zone\")]",
                            "        public bool UseExtraZone { get; set; }",
                            "",
                            "        ",
                            "        [EventSubscribe(\"StartOfSimulation\")]",
                            "        private void OnSimulationCommencing(object sender, EventArgs e)",
                            "        {",
                            "            if (UseExtraZone)",
                            "            {",
                            "            root.ZoneNamesToGrowRootsIn.Add(\"SkipZone\");",
                            "            root.ZoneRootDepths.Add(50);",
                            "NutrientPoolFunctions InitialDM = new NutrientPoolFunctions();",
                            "Constant InitStruct = new Constant();",
                            "InitStruct.FixedValue = 10;",
                            "InitialDM.Structural = InitStruct;",
                            "Constant InitMetab = new Constant();",
                            "InitMetab.FixedValue = 0;",
                            "InitialDM.Metabolic = InitMetab;",
                            "Constant InitStor = new Constant();",
                            "InitStor.FixedValue = 0;",
                            "InitialDM.Storage = InitStor;",
                            "            root.ZoneInitialDM.Add(InitialDM);",
                            "",
                            "            }",
                            "        }",
                            "    }",
                            "}",
                            "       ",
                            ""
                          ],
                          "Parameters": [
                            {
                              "Key": "UseExtraZone",
                              "Value": "True"
                            }
                          ],
                          "Name": "SetupCottonRootZones",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.PMF.Plant, Models",
                          "PlantType": "Cotton",
                          "Name": "Cotton",
                          "ResourceName": "Cotton",
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "using Models.Soils;",
                            "using System;",
                            "using Models.Core;",
                            "using System.Text;",
                            "using Models.PMF;",
                            "using Models;",
                            "using APSIM.Shared.Utilities;",
                            "using Models.PMF.Phen;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable] ",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] ISummary summary;",
                            "        [Link] private Plant cotton;",
                            "        [Link(Type = LinkType.Path, Path = \"[cotton].Phenology\")]",
                            "        private Phenology phenology;",
                            "                [Link] Clock Clock;",
                            "",
                            "        private bool Harvestable = false;",
                            "",
                            "        [Description(\"Harvest Date (d-mmm)\")]",
                            "        public string HarvestDate { get; set; }   ",
                            "      ",
                            "        [EventSubscribe(\"DoManagement\")]",
                            "        private void OnDoManagement(object sender, EventArgs e)",
                            "        {",
                            "           ",
                            "            if (Harvestable && phenology.CurrentPhase.Name == \"ReadyForHarvesting\")",
                            "            {",
                            "                cotton.Harvest();",
                            "                cotton.EndCrop();                ",
                            "            }",
                            "            ",
                            "            if (DateUtilities.DatesAreEqual(HarvestDate, Clock.Today))",
                            "                Harvestable = true;",
                            "",
                            "        }",
                            "    }",
                            "}",
                            "       "
                          ],
                          "Parameters": [
                            {
                              "Key": "HarvestDate",
                              "Value": "15-Apr"
                            }
                          ],
                          "Name": "HarvestAfterDate",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        }
