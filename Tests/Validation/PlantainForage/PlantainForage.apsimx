{
  "$type": "Models.Core.Simulations, Models",
  "Version": 220,
  "Name": "Simulations",
  "ResourceName": null,
  "Children": [
    {
      "$type": "Models.Core.Folder, Models",
      "ShowInDocs": false,
      "Name": "Replacements",
      "ResourceName": null,
      "Children": [
        {
          "$type": "Models.Report, Models",
          "VariableNames": [
            "[Clock].Today as Date",
            "[Clock].Today.DayOfYear as DayOfYear",
            "",
            "// Water outputs",
            "[Weather].Rain as Rainfall",
            "[Irrigation].IrrigationApplied as Irrigation",
            "[MicroClimate].PrecipitationInterception as PrecipitationInterception",
            "[Soil].SoilWater.Eo as Eo",
            "[Soil].SoilWater.Es as Evaporation",
            "[PlantainForage].Leaf.Transpiration as Transpiration",
            "[Soil].SoilWater.Drainage as Drainage",
            "[Soil].SoilWater.Runoff as Runoff",
            "sum([Soil].SoilWater.LateralOutflow) as LateralFlow",
            "[Soil].SoilWater.pond as PondedWater",
            "sum([Soil].Water.MM) as TotalSWC",
            "sum([Soil].Physical.SATmm) as TotalSAT",
            "sum([Soil].Physical.DULmm) as TotalDUL",
            "sum([Soil].Physical.LL15mm) as TotalLL15",
            "[Soil].Water.Volumetric[1] as TopLayerSWC",
            "[Soil].Physical.DUL[1] as TopLayerDUL",
            "[Soil].Physical.LL15[1] as TopLayerLL15",
            "",
            "// Nitrogen outputs",
            "[Fertiliser].NitrogenApplied as FertiliserN",
            "(0.0) as FixedN",
            "(sum([Soil].Nutrient.MineralisedN) + sum([SurfaceOrganicMatter].SurfaceResidue.Decomposition.MineralisedN)) as NetMineralisedN",
            "sum([Soil].Nutrient.MineralisedN) as MineralisedSoilN",
            "sum([SurfaceOrganicMatter].SurfaceResidue.Decomposition.MineralisedN) as MineralisedSurfOMN",
            "sum([Soil].Nutrient.DenitrifiedN) as DenitrifiedN",
            "([Soil].SoilWater.LeachUrea + [Soil].SoilWater.LeachNH4 + [Soil].SoilWater.LeachNO3) as LeachedN",
            "[PlantainForage].Root.NTakenUp*10.0 as UptakeN",
            "([PlantainForage].Leaf.Detached.N+[PlantainForage].Stem.Detached.N+[PlantainForage].Inflorescence.Detached.N+[PlantainForage].Taproot.Detached.N+[PlantainForage].Root.Detached.N)*10.0 as DetachedPlantN",
            "[DefoliationManager].Script.HarvestedN*10.0 as PlantDefoliatedN",
            "[DefoliationManager].Script.RemovedN*10.0 as PlantRemovedN",
            "([DefoliationManager].Script.NReturnedInDung*10.0 + [DungAndUrine].Script.DungDepositionN) as DungDepositedN",
            "([DefoliationManager].Script.NReturnedInUrine*10.0 + [DungAndUrine].Script.UrineDepositionN) as UrineDepositedN",
            "",
            "(sum([Soil].Urea.kgha) + sum([Soil].NH4.kgha) + sum([Soil].NO3.kgha)) as TotalMineralN",
            "sum([Soil].Urea.kgha) as TotalUrea",
            "sum([Soil].NH4.kgha) as TotalNH4",
            "sum([Soil].NO3.kgha) as TotalNO3",
            "[SurfaceOrganicMatter].N as TotalSurfOMN",
            "sum([Soil].Nutrient.FOM.N) as TotalFOMN",
            "sum([Soil].Nutrient.Humic.N) as TotalHumicN",
            "sum([Soil].Nutrient.Microbial.N) as TotalMicrobialN",
            "",
            "// Crop outputs",
            "[PlantainForage].Total.Wt as TotalPlantWt",
            "[PlantainForage].Total.N as TotalPlantN",
            "([PlantainForage].AboveGroundLive.Wt + [PlantainForage].BelowGroundLive.Wt) as TotalPlantLiveWt",
            "([PlantainForage].Total.Wt - ([PlantainForage].AboveGroundLive.Wt + [PlantainForage].BelowGroundLive.Wt)) as TotalPlantDeadWt",
            "[PlantainForage].AboveGround.Wt as AboveGroundPlantWt",
            "[PlantainForage].BelowGround.Wt as BelowGroundPlantWt",
            "[PlantainForage].AboveGround.NConc as AboveGroundNConc",
            "[PlantainForage].BelowGround.NConc as BelowGroundNConc",
            "[PlantainForage].Leaf.LAI as LAIGreen",
            "[PlantainForage].Leaf.LAIDead as LAIDead",
            "[MicroClimate].CanopyCover as CoverTotal",
            "[PlantainForage].Leaf.Height as CropHeight",
            "[PlantainForage].Root.Depth as RootDepth",
            "",
            "// Harvest outputs",
            "[DefoliationManager].Script.HarvestedWt as DefoliatedWt",
            "[DefoliationManager].Script.HarvestedN as DefoliatedN",
            "[DefoliationManager].Script.RemovedWt as OffTakePlantWt",
            "[DefoliationManager].Script.RemovedN as OffTakePlantN",
            "[DefoliationManager].Script.HarvestedN/([DefoliationManager].Script.HarvestedWt + 0.000000001) as DefoliatedNconc",
            "[DefoliationManager].Script.PreHarvestDM as PreHarvestDM",
            "[DefoliationManager].Script.PostHarvestDM as PostHarvestDM",
            "[DefoliationManager].Script.DaysSinceLastDefoliation as DaysSinceLastDefoliation",
            "[DefoliationManager].Script.MeanGrowthRateDM as MeanGrowthRate",
            "",
            "// Other - Extras",
            "[Weather].Radn as RadiationTotal",
            "[MicroClimate].RadiationInterception as RadiationIntercepted",
            "[Weather].MeanT as MeanAirTemperature",
            "[Soil].Temperature.Value[1] as TopSoilTemperature",
            "",
            "([DefoliationManager].Script.ReturnedWt*10.0 + [DungAndUrine].Script.DungDepositionWt) as DungDepositedWt",
            "[SurfaceOrganicMatter].Wt as TotalSurfaceOMWt",
            "([SurfaceOrganicMatter].C / ([SurfaceOrganicMatter].N + 0.000000001)) as SurfOMCNratio",
            "sum([Soil].Nutrient.FOM.C) / 0.4 as FOMWt",
            "(sum([Soil].Nutrient.FOM.C) / (sum([Soil].Nutrient.FOM.N) + 0.000000001)) as FOMCNratio"
          ],
          "EventNames": [
            "[Clock].DoReport"
          ],
          "GroupByVariableName": null,
          "Name": "BaseReport",
          "ResourceName": null,
          "Children": [],
          "Enabled": true,
          "ReadOnly": false
        },
        {
          "$type": "Models.Report, Models",
          "VariableNames": [
            "[Clock].Today as Date",
            "[Clock].Today.Year as Year",
            "",
            "// Water outputs",
            "Sum of ([Weather].Rain) from 1-Jul to [Clock].Today as RainfallCum",
            "Sum of ([Irrigation].IrrigationApplied) from 1-Jul to [Clock].Today as IrrigationCum",
            "Sum of ([Soil].SoilWater.Es) from 1-Jul to [Clock].Today as EvaporationCum",
            "Sum of ([PlantainForage].Leaf.Transpiration) from 1-Jul to [Clock].Today as TranspirationCum",
            "Sum of ([Soil].SoilWater.Drainage) from 1-Jul to [Clock].Today as DrainageCum",
            "Sum of ([Soil].SoilWater.Runoff) from 1-Jul to [Clock].Today as RunoffCum",
            "",
            "// Nitrogen outputs",
            "Sum of ([Fertiliser].NitrogenApplied) from 1-Jul to [Clock].Today as FertiliserNCum",
            "(0.0) as FixedNCum",
            "Sum of ((sum([Soil].Nutrient.MineralisedN) + sum([SurfaceOrganicMatter].SurfaceResidue.Decomposition.MineralisedN))) from 1-Jul to [Clock].Today as NetMineralisedNCum",
            "Sum of (sum([Soil].Nutrient.DenitrifiedN)) from 1-Jul to [Clock].Today as DenitrifiedNCum",
            "Sum of (([Soil].SoilWater.LeachUrea + [Soil].SoilWater.LeachNH4 + [Soil].SoilWater.LeachNO3)) from 1-Jul to [Clock].Today as LeachedNCum",
            "Sum of ([PlantainForage].Root.NTakenUp)*10.0 from 1-Jul to [Clock].Today as UptakeNCum",
            "Sum of ([PlantainForage].Leaf.Detached.N+[PlantainForage].Stem.Detached.N+[PlantainForage].Inflorescence.Detached.N+[PlantainForage].Taproot.Detached.N+[PlantainForage].Root.Detached.N)*10.0 from 1-Jul to [Clock].Today as DetachedPlantNCum",
            "Sum of ([DefoliationManager].Script.HarvestedN)*10.0 from 1-Jul to [Clock].Today as PlantDefoliatedNCum",
            "Sum of ([DefoliationManager].Script.RemovedN)*10.0 from 1-Jul to [Clock].Today as PlantRemovedNCum",
            "Sum of ([DefoliationManager].Script.NReturnedInDung*10.0 + [DungAndUrine].Script.DungDepositionN) from 1-Jul to [Clock].Today as DungDepositedNCum",
            "Sum of ([DefoliationManager].Script.NReturnedInUrine*10.0 + [DungAndUrine].Script.UrineDepositionN) from 1-Jul to [Clock].Today as UrineDepositedNCum",
            "",
            "// Harvest outputs",
            "Sum of ([DefoliationManager].Script.HarvestedWt) from 1-Jul to [Clock].Today as DefoliatedWtCum",
            "Sum of ([DefoliationManager].Script.HarvestedN) from 1-Jul to [Clock].Today as DefoliatedNCum",
            "Sum of ([DefoliationManager].Script.RemovedWt) from 1-Jul to [Clock].Today as OffTakePlantWtCum",
            "Sum of ([DefoliationManager].Script.RemovedN) from 1-Jul to [Clock].Today as OffTakePlantNCum",
            "",
            "// Other - Extras",
            "Sum of ([DefoliationManager].Script.ReturnedWt*10.0 + [DungAndUrine].Script.DungDepositionWt) from 1-Jul to [Clock].Today as DungDepositedWtCum"
          ],
          "EventNames": [
            "[Clock].DoReport"
          ],
          "GroupByVariableName": null,
          "Name": "CumReport",
          "ResourceName": null,
          "Children": [],
          "Enabled": true,
          "ReadOnly": false
        },
