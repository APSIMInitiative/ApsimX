                        "using Models.Soils;",
                        "using Models.Functions;",
                        "using APSIM.Shared.Utilities;",
                        "using System.Xml.Serialization;",
                        "using Models;",
                        "using Models.PMF;",
                        "using System.Text;",
                        "using System.Collections.Generic;",
                        "using Models.Core;",
                        "using System;",
                        "using Models.PMF.Organs;",
                        "",
                        "namespace Models",
                        "{",
                        "    [Serializable] ",
                        "    public class Script : Model",
                        "    {",
                        "        [Link] private Plant Grapevine;",
                        "        [Link] private Clock Clock;",
                        "        [Link] private Zone zone;",
                        "        ",
                        "                ",
                        "        [EventSubscribe(\"StartOfSimulation\")]",
                        "        private void OnSimulationCommencing(object sender, EventArgs e)",
                        "        {",
                        "          zone.Set(\"Grapevine.Structure.BranchingRate.Potential_Branching_Rate.XYPairs.Y[1]\", 0.01 );",
                        "          zone.Set(\"Grapevine.Structure.BranchingRate.Potential_Branching_Rate.XYPairs.Y[2]\", 0.02 );",
                        "          zone.Set(\"Grapevine.Structure.BranchingRate.Potential_Branching_Rate.XYPairs.Y[3]\", 0.02 );",
                        "          zone.Set(\"Grapevine.Structure.BranchingRate.Potential_Branching_Rate.XYPairs.Y[4]\", 0.02 );",
                        "          zone.Set(\"Grapevine.Structure.BranchingRate.Potential_Branching_Rate.XYPairs.Y[5]\", 0.02 );",
                        "          zone.Set(\"Grapevine.Structure.BranchingRate.Potential_Branching_Rate.XYPairs.Y[6]\", 0.01 );",
                        "          zone.Set(\"Grapevine.Berry.YieldComponent.BerryMass.PostEventValue.BerryMassFun.LowerLimit.FixedValue\", 1.8);",
                        "          zone.Set(\"Grapevine.Berry.YieldComponent.BerryNum.PostEventValue.BerryNumFun.Minimum.FixedValue\", 1);",
                        "          zone.Set(\"Grapevine.Berry.YieldComponent.BunchesPerShoot.PostEventValue.MaximumFunc.one.FixedValue\", 0);",
                        "          ",
                        "        }",
                        "     }",
                        "}",
                        "",
                        "       ",
                        ""
                      ],
                      "Parameters": [],
                      "Name": "ReviseCanopyHeight",
                      "ResourceName": null,
                      "Children": [],
