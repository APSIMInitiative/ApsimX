        {
          "$type": "Models.Core.Folder, Models",
          "ShowInDocs": false,
          "Name": "Yarrawonga",
          "ResourceName": null,
          "Children": [
            {
              "$type": "Models.Factorial.Experiment, Models",
              "DisabledSimNames": null,
              "Name": "FAR NEV FRO WB23-01",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Memo, Models",
                  "Text": "# Field Applied Research (FAR) Australia trial FAR NEV FRO WB23-01 at Yarrawonga in 2023. \r\n\r\nThis trial has been selected because it contained 4 cultivars of interest, and had up to 2 Greenseeker (NDVI), 2 biomass, 0 N concentration or 12 growth stage measurements. \r\n\r\n*Grazing/defolation treatments have been excluded.* \r\n\r\nTrial description: **Frost experiment (Max)** \r\n\r\n[Some trial details may be found here](https://faraustralia.com.au/resource) \r\n\r\n",
                  "Name": "Description",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Factorial.Factors, Models",
                  "Name": "Factors",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Factorial.Permutation, Models",
                      "Name": "Permutation",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Factorial.Factor, Models",
                          "Specification": null,
                          "Name": "Def",
                          "ResourceName": null,
                          "Children": [
                            {
