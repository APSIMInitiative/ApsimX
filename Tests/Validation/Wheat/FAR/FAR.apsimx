            {
              "$type": "Models.Factorial.Experiment, Models",
              "DisabledSimNames": null,
              "Name": "FAR SAC W18-02",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Memo, Models",
                  "Text": "# Field Applied Research (FAR) Australia trial FAR SAC W18-02 at Millicent in 2018. \r\n\r\nThis trial has been selected because it contained 12 cultivars of interest, and had up to 10 Greenseeker (NDVI), 1 biomass, 0 N concentration or 1 growth stage measurements. \r\n\r\n*Grazing/defolation treatments have been excluded.* \r\n\r\nTrial description: **Response to fungicide** \r\n\r\n[Some trial details may be found here](https://faraustralia.com.au/resource) \r\n\r\n",
                  "Name": "Description",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
