                        "[LocationInfo].Script.Region"
                      ],
                      "EventNames": [
                        "[Wheat].Sowing"
                      ],
                      "GroupByVariableName": null,
                      "Name": "SowingReport",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
