                    {
                      "$type": "Models.Manager, Models",
                      "CodeArray": [
                        "using System;",
                        "using System.Collections.Generic;",
                        "using Models.Core;",
                        "using Models.Climate;",
                        "using Models.Interfaces;",
                        "using Models.PMF;",
                        "using Models.Soils;",
                        "using APSIM.Shared.Utilities;",
                        "",
                        "namespace Models",
                        "{",
                        "    /// <summary>",
                        "    /// Holds Petri-dish conditions: a constant seed-layer temperature (through constant weather with no",
                        "    /// radiation or rain) and a constant seed-layer water potential (by resetting the seed-layer water",
                        "    /// content just before phenology), then sows the crop.",
                        "    /// </summary>",
                        "    [Serializable]",
                        "    public class Script : Model",
                        "    {",
                        "        [Link] private Clock clock = null;",
                        "        [Link] private Weather weather = null;",
                        "        [Link] private IPhysical physical = null;",
                        "        [Link] private ISoilWater soilWater = null;",
                        "        [Link] private Water water = null;",
                        "        [Link] private ISoilTemperature soilTemperature = null;",
                        "        [Link(Type = LinkType.Path, Path = \"[Wheat]\")] private Plant wheat = null;",
                        "",
                        "        [Description(\"Temperature (oC)\")] public double Temperature { get; set; }",
                        "        [Description(\"Water potential (MPa)\")] public double WaterPotential { get; set; }",
                        "        [Description(\"Sowing date\")] public DateTime SowingDate { get; set; }",
                        "        [Description(\"Sowing depth (mm)\")] public double SowingDepth { get; set; }",
                        "        [Description(\"Cultivar\")] public string CultivarName { get; set; }",
                        "        [Description(\"Population (plants/m2)\")] public double Population { get; set; }",
                        "",
                        "        /// <summary>Volumetric water content of the seed layer that gives the target water potential.</summary>",
                        "        public double TargetWaterContent { get; private set; }",
                        "",
                        "        /// <summary>",
                        "        /// Air temperature applied to the weather (oC). It starts at Temperature and is corrected each day by",
                        "        /// the seed-layer error so that the simulated seed-layer soil temperature settles at Temperature.",
                        "        /// </summary>",
                        "        public double AirTemperature { get; private set; }",
                        "",
                        "        private int seedLayer;",
                        "",
                        "        [EventSubscribe(\"StartOfSimulation\")]",
                        "        private void OnStartOfSimulation(object sender, EventArgs e)",
                        "        {",
                        "            AirTemperature = Temperature;",
                        "            seedLayer = SoilUtilities.LayerIndexOfDepth(physical.Thickness, SowingDepth);",
                        "            TargetWaterContent = ThetaForPotential(WaterPotential);",
                        "        }",
                        "",
                        "        [EventSubscribe(\"PreparingNewWeatherData\")]",
                        "        private void OnPreparingNewWeatherData(object sender, EventArgs e)",
                        "        {",
                        "            // Annual average/amplitude set the soil temperature model's initial profile and lower boundary.",
                        "            weather.Tav = Temperature;",
                        "            weather.Amp = 0;",
                        "            weather.MaxT = AirTemperature;",
                        "            weather.MinT = AirTemperature;",
                        "            weather.Radn = 0;",
                        "            weather.Rain = 0;",
                        "        }",
                        "",
                        "        [EventSubscribe(\"EndOfDay\")]",
                        "        private void OnEndOfDay(object sender, EventArgs e)",
                        "        {",
                        "            AirTemperature += 0.5 * (Temperature - soilTemperature.Value[seedLayer]);",
                        "        }",
                        "",
                        "        [EventSubscribe(\"DoManagement\")]",
                        "        private void OnDoManagement(object sender, EventArgs e)",
                        "        {",
                        "            SetSeedLayerWater();",
                        "            if (clock.Today == SowingDate)",
                        "                wheat.Sow(CultivarName, Population, SowingDepth, 250);",
                        "        }",
                        "",
                        "        [EventSubscribe(\"PrePhenology\")]",
                        "        private void OnPrePhenology(object sender, EventArgs e)",
                        "        {",
                        "            SetSeedLayerWater();",
                        "        }",
                        "",
                        "        private void SetSeedLayerWater()",
                        "        {",
                        "            double[] sw = (double[])soilWater.SW.Clone();",
                        "            sw[seedLayer] = TargetWaterContent;",
                        "            soilWater.SW = sw;",
                        "        }",
                        "",
                        "        /// <summary>",
                        "        /// Seed-layer water content at which the soil water model's own retention curve gives the target",
                        "        /// water potential (MPa), found by bisection on [Soil].Water.Potential. This is the value",
                        "        /// GerminatingWaterPotentialResponse reads, so the simulated seed-layer potential equals the lab treatment.",
                        "        /// </summary>",
                        "        private double ThetaForPotential(double psiTarget)",
                        "        {",
                        "            double sat = physical.SAT[seedLayer];",
                        "            if (psiTarget >= 0)",
                        "                return sat;",
                        "            double[] original = (double[])soilWater.SW.Clone();",
                        "            double[] sw = (double[])original.Clone();",
                        "            double lo = 0, hi = sat;",
                        "            for (int i = 0; i < 60; i++)",
                        "            {",
                        "                double mid = 0.5 * (lo + hi);",
                        "                sw[seedLayer] = mid;",
                        "                soilWater.SW = sw;",
                        "                if (water.Potential[seedLayer] / 1000 < psiTarget)",
                        "                    lo = mid;",
                        "                else",
                        "                    hi = mid;",
                        "            }",
                        "            soilWater.SW = original;",
                        "            return 0.5 * (lo + hi);",
                        "        }",
                        "    }",
                        "}"
                      ],
                      "Parameters": [
                        {
                          "Key": "Temperature",
                          "Value": "20"
                        },
                        {
                          "Key": "WaterPotential",
                          "Value": "0"
                        },
                        {
                          "Key": "SowingDate",
                          "Value": "03/01/2000 00:00:00"
                        },
                        {
                          "Key": "SowingDepth",
                          "Value": "20"
                        },
                        {
                          "Key": "CultivarName",
                          "Value": "Mace"
                        },
                        {
                          "Key": "Population",
                          "Value": "100"
                        }
                      ],
                      "Name": "LabConditions",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Manager, Models",
                      "CodeArray": [
                        "using System;",
                        "using System.Collections.Generic;",
                        "using System.Linq;",
                        "using Models.Core;",
                        "using Models.Functions;",
                        "using Models.PMF;",
                        "using Models.PMF.Phen;",
                        "",
                        "namespace Models",
                        "{",
                        "    /// <summary>",
                        "    /// Records the day of 50% germination (T50) from the germination phase. T50_raw is the fractional day",
                        "    /// on which the accumulated rate reaches 1: (day - 1) + (1 - progress before that day) / rate that day.",
                        "    /// T50 is T50_raw floored at 1 day (daily model), and is NaN when germination takes longer than CensorDays.",
                        "    /// </summary>",
                        "    [Serializable]",
                        "    public class Script : Model",
                        "    {",
                        "        [Link(Type = LinkType.Path, Path = \"[Wheat]\")] private Plant wheat = null;",
                        "        [Link(Type = LinkType.Path, Path = \"[Wheat].Phenology.Germinating\")] private GerminatingPhaseHydroThermal phase = null;",
                        "        [Link(Type = LinkType.Path, Path = \"[Wheat].Phenology.Germinating.GerminatingWaterPotentialResponse\")] private GerminatingWaterPotentialResponse water = null;",
                        "",
                        "        [Description(\"Censor T50 after this many days (experiment length)\")] public double CensorDays { get; set; }",
                        "",
                        "        public bool Germinated { get; private set; }",
                        "        public double T50_raw { get; private set; } = double.NaN;",
                        "        public double T50 { get; private set; } = double.NaN;",
                        "        public int DaysAccumulated { get { return rates.Count; } }",
                        "        public double MeanSeedTemperature { get { return temperatures.Count > 0 ? temperatures.Average() : double.NaN; } }",
                        "        public double MinSeedTemperature { get { return temperatures.Count > 0 ? temperatures.Min() : double.NaN; } }",
                        "        public double MaxSeedTemperature { get { return temperatures.Count > 0 ? temperatures.Max() : double.NaN; } }",
                        "        public double MeanSeedWaterPotential { get { return potentials.Count > 0 ? potentials.Average() : double.NaN; } }",
                        "        public double MeanDailyRate { get { return rates.Count > 0 ? rates.Average() : double.NaN; } }",
                        "",
                        "        private List<double> rates = new List<double>();",
                        "        private List<double> temperatures = new List<double>();",
                        "        private List<double> potentials = new List<double>();",
                        "",
                        "        [EventSubscribe(\"EndOfDay\")]",
                        "        private void OnEndOfDay(object sender, EventArgs e)",
                        "        {",
                        "            if (!wheat.IsAlive || Germinated || phase.DaysSinceSowing <= rates.Count)",
                        "                return;",
                        "",
                        "            // The phase ran today: record today's values.",
                        "            rates.Add(phase.DailyGerminationRate);",
                        "            temperatures.Add(phase.SoilTemperatureSeed);",
                        "            potentials.Add(water.SeedWaterPotential);",
                        "",
                        "            if (phase.ProgressThroughPhase >= phase.Target)",
                        "            {",
                        "                Germinated = true;",
                        "                double progress = 0;",
                        "                for (int day = 1; day <= rates.Count; day++)",
                        "                {",
                        "                    double r = rates[day - 1];",
                        "                    if (progress + r >= 1)",
                        "                    {",
                        "                        T50_raw = (day - 1) + (1 - progress) / r;",
                        "                        break;",
                        "                    }",
                        "                    progress += r;",
                        "                }",
                        "                if (T50_raw <= CensorDays)",
                        "                    T50 = Math.Max(1, T50_raw);",
                        "            }",
                        "        }",
                        "    }",
                        "}"
                      ],
                      "Parameters": [
                        {
                          "Key": "CensorDays",
                          "Value": "14"
                        }
                      ],
                      "Name": "GerminationTracker",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                }
              ],
              "Enabled": true,
              "ReadOnly": false
            },
