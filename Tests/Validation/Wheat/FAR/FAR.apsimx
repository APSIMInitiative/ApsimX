            {
              "$type": "Models.Factorial.Experiment, Models",
              "DisabledSimNames": null,
              "Name": "FAR RRC W22-02",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Memo, Models",
                  "Text": "# Field Applied Research (FAR) Australia trial FAR RRC W22-02 at Wallendbeen in 2022. \r\n\r\nThis trial has been selected because it contained 10 cultivars of interest, and had up to 1 Greenseeker (NDVI), 0 biomass, 0 N concentration or 8 growth stage measurements. \r\n\r\n*Grazing/defolation treatments have been excluded.* \r\n\r\nTrial description: **Genotype 14 elite lines tested under both untreated and HYC High input fungicide management (High input fungicide program = 3 foliar fungicides � GS31** \r\n\r\n[Trial write-up](https://faraustralia.com.au/wp-content/uploads/2023/05/2022-HYC-Results-for-distribution_LOW-RES.pdf) \r\n\r\n",
                  "Name": "Description",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
