                                  "Action": "[DefoliationManager].Script.Defoliate(amountDM: 50, amountType: \"ResidualDM\", duration: 1)",
                                  "Line": "2000-06-14 [DefoliationManager].Script.Defoliate(amountDM: 50, amountType: \"ResidualDM\", duration: 1)"
                                },
