          "ResourceName": null,
          "Children": [
            {
              "$type": "Models.Memo, Models",
              "Text": "Experiment 2: 2002-2003 Narrabri growth Analysis\n\nManagement|Date|DAS|Rate\n-|-|-|-\nN Fertilizer (Ammonium gas)|27 Aug 2002|-44| 120 kg N/ha\nPre-watering|24 Sep 2002|-17|\nStarting soil-N sampling|1 Oct 2002|-9|\nSowing|10 Oct 2002|0|\nIrrigation 1|30 Oct 2002|20|\nIrrigation 2|13 Dec 2002|64|\nIrrigation 3|1 Jan 2003?|85|\nIrrigation 4|17 Jan 2003|99|\nIrrigation 5|30 Jan 2003|112|\nIrrigation 6|14 Feb 2003|127|\n\n=================================================\n\nSoil-N on 1 Oct 2002 - SITE 1:\n\nDepth mm|Initial values ppm\n-|-\n0-150|45.5\n150-300|11.9\n300-600|2.4\n600-900|0.5\n900-1200|0.5\n1200-1500|0.5\n1500-1800|0.5",
              "Name": "Memo",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Memo, Models",
              "Text": "Stage|Date|DAS\n-|-|-\nSowing|10 Oct 2002|0\nEmergence||\nSquaring|2 Dec 2002|53\nFlowering|26 Dec 2002|77\nCutout||\nOpenBolls|10 Feb 2003?|123\nMaturity|7 Mar 2003|148\nHarvestRipe|11 Apr 2003|183\n",
              "Name": "Phenology stages Observed",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Memo, Models",
              "Text": "PHYSIOLOGICAL DETERMINANTS OF YIELD AND MATURITY IN ULTRA-NARROW ROW COTTON. A thesis submitted for the degree of Doctor of Philosophy at The University of Queensland in December 2006 by Rose Roche \n\nPage 52/53: No growth regulators applied",
              "Name": "Growth regulator details",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Factorial.Experiment, Models",
