                                  "Value": "0.99"
                                },
                                {
                                  "Key": "NRemoveType",
                                  "Value": "UserDefinedFraction"
                                },
                                {
                                  "Key": "FractionNToRemove",
                                  "Value": "0.99"
                                },
                                {
