        {
          "$type": "Models.Manager, Models",
          "CodeArray": [
            "using APSIM.Core;",
            "using Models.Core.Run;",
            "using Newtonsoft.Json;",
            "using APSIM.Shared.Utilities;",
            "using Models.Soils.Arbitrator;",
            "using Models.PMF.Organs;",
            "using Models.PMF;",
            "using Models.Interfaces;",
            "using Models.Core;",
            "using System.Xml.Serialization;",
            "using System.Collections.Generic;",
            "using System;",
            "using Models.PMF.Struct;",
            "using Models.Soils;",
            "",
            "namespace Models",
            "{",
            "    [Serializable] ",
            "    public class Script : Model, IStructureDependency",
            "    {",
            "        public  event EventHandler ReportLeafSize;",
            "        [Link] private Zone zone;",
            "        [Link] private Clock clock;",
            "        public IStructure Structure { private get; set; }",
            "        ",
            "        [JsonIgnore] public int NextLeafPosition { get; set; }",
            "        [JsonIgnore] public int LeafPosition { get; set; }",
            "        [JsonIgnore] public double MaxLeafSize { get; set; }",
            "        [JsonIgnore] public double LeafSize { get; set; }",
            "        [JsonIgnore] public int daysForLeaf { get; set; }",
            "        [JsonIgnore] public double sumLeafSize { get; set; }",
            "",
            "        [EventSubscribe(\"[Wheat].Sowing\")]",
            "        private void OnSow(object sender, EventArgs e)",
            "        {",
            "            LeafPosition = 0;",
            "            NextLeafPosition = 0;",
            "            daysForLeaf = 0;",
            "            sumLeafSize = 0;",
            "        }",
            "        ",
            "        [EventSubscribe(\"DoReportCalculations\")]",
            "        private void DoReportCalculations(object sender, EventArgs e)",
            "        {",
            "            double haunStage = (double)Structure.Get(\"Wheat.Phenology.HaunStage.Value()\", relativeTo: zone);",
            "            double maxLeafSize = (double)Structure.Get(\"Wheat.Leaf.MaximumSize.Value()\", relativeTo: zone);",
            "            double leafSizeToday = (double)Structure.Get(\"Wheat.Leaf.Size.Value()\", relativeTo: zone);",
            "            ",
            "            daysForLeaf += 1;",
            "            sumLeafSize += leafSizeToday;",
            "            ",
            "            if (haunStage > NextLeafPosition) ",
            "            {",
            "                LeafPosition = (int)haunStage;",
            "                NextLeafPosition = LeafPosition+1;",
            "                MaxLeafSize = maxLeafSize;",
            "                LeafSize = sumLeafSize/daysForLeaf;",
            "                if (ReportLeafSize != null)",
            "                    ReportLeafSize.Invoke(this, new EventArgs());",
            "                daysForLeaf = 0;",
            "                sumLeafSize = 0;",
            "            }",
            "        }",
            "    }",
            "}"
          ],
          "Parameters": [],
          "Name": "OutputMaxLeafSize",
          "ResourceName": null,
          "Children": [],
          "Enabled": true,
          "ReadOnly": false
        },
        {
          "$type": "Models.Report, Models",
