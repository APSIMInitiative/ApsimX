                          "CodeArray": [
                            "using APSIM.Core;",
                            "using APSIM.Shared.Utilities;",
                            "using System.Xml.Serialization;",
                            "using Models.PMF;",
                            "using Models.Soils;",
                            "using System.Text;",
                            "using System.Collections.Generic;",
                            "using Models.Core;",
                            "using System.Linq;",
                            "using System;",
                            "using Models.Interfaces;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable]",
                            "    public class Script : Model, IStructureDependency",
                            "    {",
                            "        [Link] private Clock clock;",
                            "        [Link] private Irrigation Irrigation;",
                            "        [Link] private Soil Soil;",
                            "        [Link] private IPhysical soilPhysical;",
                            "        [Link] private ISoilWater waterBalance;",
                            "        public double SW_now;",
                            "        public double CLL_now;",
                            "        public double SW_full;",
                            "        public IStructure Structure { private get; set; }",
                            "        // Links",
                            "",
                            "        // Fields",
                            "",
                            "        // Properties",
                            "        [Description(\"Crop to irrigate\")]",
                            "        public IPlant Crop { get; set; }",
                            "        [Description(\"The crop stage when irrigation will start\")]",
                            "        public double IrrigStartStage { get; set; } // Crop stage when irrigation will start",
                            "        [Description(\"The crop stage when irrigation will end\")]",
                            "        public double IrrigEndStage { get; set; } // Crop stage when irrigation will end",
                            "        ",
                            "        [Separator(\"Irrigation application details\")]",
                            "        [Description(\"Number of soil layers used in calculating SW deficit\")]",
                            "        public int asw_depth { get; set; } // Change to int for layer count",
                            "        [Description(\"Fraction of ASW below which irrigation is applied (0-1.0)\")]",
                            "        public double crit_fr_asw { get; set; } // Critical fraction of available soil water before applying irrigation",
                            "        [Description(\"Minimum days between irrigations\")]",
                            "        public double returndays { get; set; }",
                            "        [Description(\"Minimum amount of irrigation to be applied (mm)\")]",
                            "        public double minimumAmount { get; set; }",
                            "",
                            "        // Output variables",
                            "        public double[] inflow_lat { get; set; }",
                            "        public double applied_furrow_irrigation { get; set; }",
                            "        public double AmountToApply { get; set; }",
                            "        public double DaysSinceIrrigation { get; set; }",
                            "",
                            "        // Methods",
                            "",
                            "        // Calculate static soil variables",
                            "",
                            "        ",
                            "",
                            "        [EventSubscribe(\"StartOfSimulation\")]",
                            "        private void OnStartOfSimulation(object sender, EventArgs e)",
                            "        {",
                            "            if (Crop == null)",
                            "                throw new Exception(\"No crop was specified in script \" + Parent.Name);",
                            "",
                            "            // Initialize inflow_lat array",
                            "            inflow_lat = new double[soilPhysical.DULmm.Length];",
                            "        }",
                            "",
                            "        // Determine daily requirement for irrigation",
                            "        [EventSubscribe(\"StartOfDay\")]",
                            "        private void OnStartOfDay(object sender, EventArgs e)",
                            "        {",
                            "            // Reset accumulated irrigation at the beginning of each day",
                            "            applied_furrow_irrigation = 0;",
                            "",
                            "            // Check if the crop is within the irrigation window based on crop stage",
                            "            double stage = (double)Crop.Node.GetObject(\"Phenology.Stage\").Value;",
                            "",
                            "            if (stage >= IrrigStartStage && stage <= IrrigEndStage)",
                            "            {",
                            "                // Calculate soil water variables",
                            "                double[] SW_add = new double[soilPhysical.DULmm.Length];",
                            "                SW_now = 0;",
                            "                CLL_now = 0;",
                            "                SW_full = 0;",
                            "                for (int layer = 0; layer < asw_depth; layer++)",
                            "                {",
                            "                    SW_now += waterBalance.SWmm[layer];",
                            "                    CLL_now += soilPhysical.LL15mm[layer];",
                            "                    SW_full += (soilPhysical.DULmm[layer] - soilPhysical.LL15mm[layer]);",
                            "                    SW_add[layer] = soilPhysical.DULmm[layer] - waterBalance.SWmm[layer];",
                            "                }",
                            "",
                            "                // Is the soil water deficit greater than the critical SW fraction?",
                            "                if ((SW_now - CLL_now) <= (SW_full * crit_fr_asw))",
                            "                {",
                            "                    // Minimum days for irrigation to return?",
                            "                    if (DaysSinceIrrigation >= returndays)",
                            "                    {",
                            "                        // Calculate irrigation requirement based on current day's soil water deficit",
                            "                        double irrigationRequirement = 0;",
                            "                        for (int layer = 0; layer < asw_depth; layer++)",
                            "                        {",
                            "                            double deficit = soilPhysical.DULmm[layer] - waterBalance.SWmm[layer];",
                            "                            irrigationRequirement += Math.Max(deficit, 0); // Accumulate positive deficits",
                            "                        }",
                            "",
                            "                        // Calculate amount to apply based on irrigation requirement and minimum amount",
                            "                        AmountToApply = Math.Max(irrigationRequirement, minimumAmount);",
                            "",
                            "                        // Apply irrigation proportionally to each layer",
                            "                        for (int layer = 0; layer < asw_depth; layer++)",
                            "                        {",
                            "                            double layerIrrigation = AmountToApply * (SW_add[layer] / irrigationRequirement);",
                            "                            Irrigation.Apply(layerIrrigation, depth: soilPhysical.Thickness[layer]);",
                            "                        }",
                            "",
                            "                        DaysSinceIrrigation = 0; // Reset DaysSinceIrrigation since irrigation occurred",
                            "                    }",
                            "                    else",
                            "                    {",
                            "                        for (int layer = 0; layer < soilPhysical.DULmm.Length; layer++)",
                            "                        {",
                            "                            inflow_lat[layer] = 0;",
                            "                            applied_furrow_irrigation = 0;",
                            "                        }",
                            "                        DaysSinceIrrigation += 1; // Increment DaysSinceIrrigation if irrigation did not occur",
                            "                    }",
                            "                }",
                            "            }",
                            "        }",
                            "    }",
                            "}",
                            ""
                          ],
                          "Parameters": [
                            {
                              "Key": "Crop",
                              "Value": "[Cotton]"
                            },
                            {
                              "Key": "IrrigStartStage",
                              "Value": "3"
                            },
                            {
                              "Key": "IrrigEndStage",
                              "Value": "5"
                            },
                            {
                              "Key": "asw_depth",
                              "Value": "7"
                            },
                            {
                              "Key": "crit_fr_asw",
                              "Value": "0.8"
                            },
                            {
                              "Key": "returndays",
                              "Value": "7"
                            },
                            {
                              "Key": "minimumAmount",
                              "Value": "100"
                            }
                          ],
                          "Name": "FurrowIrrigationPreFlowering",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "using APSIM.Core;",
                            "using APSIM.Shared.Utilities;",
                            "using System.Xml.Serialization;",
                            "using Models.PMF;",
                            "using Models.Soils;",
                            "using System.Text;",
                            "using System.Collections.Generic;",
                            "using Models.Core;",
                            "using System.Linq;",
                            "using System;",
                            "using Models.Interfaces;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable]",
                            "    public class Script : Model, IStructureDependency",
                            "    {",
                            "        [Link] private Clock clock;",
                            "        [Link] private Irrigation Irrigation;",
                            "        [Link] private Soil Soil;",
                            "        [Link] private IPhysical soilPhysical;",
                            "        [Link] private ISoilWater waterBalance;",
                            "        public double SW_now;",
                            "        public double CLL_now;",
                            "        public double SW_full;",
                            "        public IStructure Structure { private get; set; }",
                            "        // Links",
                            "",
                            "        // Fields",
                            "",
                            "        // Properties",
                            "        [Description(\"Crop to irrigate\")]",
                            "        public IPlant Crop { get; set; }",
                            "        [Description(\"The crop stage when irrigation will start\")]",
                            "        public double IrrigStartStage { get; set; } // Crop stage when irrigation will start",
                            "        [Description(\"The crop stage when irrigation will end\")]",
                            "        public double IrrigEndStage { get; set; } // Crop stage when irrigation will end",
                            "        ",
                            "        [Separator(\"Irrigation application details\")]",
                            "        [Description(\"Number of soil layers used in calculating SW deficit\")]",
                            "        public int asw_depth { get; set; } // Change to int for layer count",
                            "        [Description(\"Fraction of ASW below which irrigation is applied (0-1.0)\")]",
                            "        public double crit_fr_asw { get; set; } // Critical fraction of available soil water before applying irrigation",
                            "        [Description(\"Minimum days between irrigations\")]",
                            "        public double returndays { get; set; }",
                            "        [Description(\"Minimum amount of irrigation to be applied (mm)\")]",
                            "        public double minimumAmount { get; set; }",
                            "",
                            "        // Output variables",
                            "        public double[] inflow_lat { get; set; }",
                            "        public double applied_furrow_irrigation { get; set; }",
                            "        public double AmountToApply { get; set; }",
                            "        public double DaysSinceIrrigation { get; set; }",
                            "",
                            "        // Methods",
                            "",
                            "        // Calculate static soil variables",
                            "",
                            "        ",
                            "",
                            "        [EventSubscribe(\"StartOfSimulation\")]",
                            "        private void OnStartOfSimulation(object sender, EventArgs e)",
                            "        {",
                            "            if (Crop == null)",
                            "                throw new Exception(\"No crop was specified in script \" + Parent.Name);",
                            "",
                            "            // Initialize inflow_lat array",
                            "            inflow_lat = new double[soilPhysical.DULmm.Length];",
                            "        }",
                            "",
                            "        // Determine daily requirement for irrigation",
                            "        [EventSubscribe(\"StartOfDay\")]",
                            "        private void OnStartOfDay(object sender, EventArgs e)",
                            "        {",
                            "            // Reset accumulated irrigation at the beginning of each day",
                            "            applied_furrow_irrigation = 0;",
                            "",
                            "            // Check if the crop is within the irrigation window based on crop stage",
                            "            double stage = (double)Crop.Node.GetObject(\"Phenology.Stage\").Value;",
                            "",
                            "            if (stage >= IrrigStartStage && stage <= IrrigEndStage)",
                            "            {",
                            "                // Calculate soil water variables",
                            "                double[] SW_add = new double[soilPhysical.DULmm.Length];",
                            "                SW_now = 0;",
                            "                CLL_now = 0;",
                            "                SW_full = 0;",
                            "                for (int layer = 0; layer < asw_depth; layer++)",
                            "                {",
                            "                    SW_now += waterBalance.SWmm[layer];",
                            "                    CLL_now += soilPhysical.LL15mm[layer];",
                            "                    SW_full += (soilPhysical.DULmm[layer] - soilPhysical.LL15mm[layer]);",
                            "                    SW_add[layer] = soilPhysical.DULmm[layer] - waterBalance.SWmm[layer];",
                            "                }",
                            "",
                            "                // Is the soil water deficit greater than the critical SW fraction?",
                            "                if ((SW_now - CLL_now) <= (SW_full * crit_fr_asw))",
                            "                {",
                            "                    // Minimum days for irrigation to return?",
                            "                    if (DaysSinceIrrigation >= returndays)",
                            "                    {",
                            "                        // Calculate irrigation requirement based on current day's soil water deficit",
                            "                        double irrigationRequirement = 0;",
                            "                        for (int layer = 0; layer < asw_depth; layer++)",
                            "                        {",
                            "                            double deficit = soilPhysical.DULmm[layer] - waterBalance.SWmm[layer];",
                            "                            irrigationRequirement += Math.Max(deficit, 0); // Accumulate positive deficits",
                            "                        }",
                            "",
                            "                        // Calculate amount to apply based on irrigation requirement and minimum amount",
                            "                        AmountToApply = Math.Max(irrigationRequirement, minimumAmount);",
                            "",
                            "                        // Apply irrigation proportionally to each layer",
                            "                        for (int layer = 0; layer < asw_depth; layer++)",
                            "                        {",
                            "                            double layerIrrigation = AmountToApply * (SW_add[layer] / irrigationRequirement);",
                            "                            Irrigation.Apply(layerIrrigation, depth: soilPhysical.Thickness[layer]);",
                            "                        }",
                            "",
                            "                        DaysSinceIrrigation = 0; // Reset DaysSinceIrrigation since irrigation occurred",
                            "                    }",
                            "                    else",
                            "                    {",
                            "                        for (int layer = 0; layer < soilPhysical.DULmm.Length; layer++)",
                            "                        {",
                            "                            inflow_lat[layer] = 0;",
                            "                            applied_furrow_irrigation = 0;",
                            "                        }",
                            "                        DaysSinceIrrigation += 1; // Increment DaysSinceIrrigation if irrigation did not occur",
                            "                    }",
