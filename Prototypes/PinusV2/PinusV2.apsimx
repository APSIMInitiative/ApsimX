                      ],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.Constant, Models",
                      "FixedValue": 0.0,
                      "Units": null,
                      "Name": "Zero",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.ExpressionFunction, Models",
                  "Units": "g/m2 per m3/ha (= 10 kg/m3)",
                  "Expression": "([WoodDensityOfGrowth].Juvenile + ([WoodDensityOfGrowth].Mature - [WoodDensityOfGrowth].Juvenile) * [Pinus].Stem.Ht / ([WoodDensityOfGrowth].HeightParameter + [Pinus].Stem.Ht)) * (1 - [WoodDensityOfGrowth].NEffect * [Leaf].Fn)",
                  "Name": "WoodDensityOfGrowth",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "Overbark stem density of new growth, used to convert stem growth to volume. It rises from Juvenile to Mature as the tree grows taller (half-way at HeightParameter), following the idea that juvenile wood is formed within the live crown and density increases as the crown lifts. Replaces an earlier age-based form. Radiata values give model/observed stand density 0.89 (BFG, Tower Hill, Puruki). NEffect lowers density when N is plentiful.",
                      "Name": "Memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.Constant, Models",
                      "FixedValue": 20.0,
                      "Units": null,
                      "Name": "Juvenile",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.Constant, Models",
                      "FixedValue": 62.0,
                      "Units": null,
                      "Name": "Mature",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.Constant, Models",
                      "FixedValue": 17.0,
                      "Units": "m",
                      "Name": "HeightParameter",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.Constant, Models",
                      "FixedValue": 0.0,
                      "Units": "0-1",
                      "Name": "NEffect",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.EndOfDayFunction, Models",
                  "Name": "WoodDensityOfStand",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Functions.ProtectedDivideFunction, Models",
                      "NumeratorErrVal": 0.0,
                      "DenominatorErrVal": 0.0,
                      "Name": "Calculation",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Functions.VariableReference, Models",
