            {
              "$type": "Models.Functions.DivideFunction, Models",
              "Name": "IndividualTreeLiveWt",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Functions.VariableReference, Models",
                  "VariableName": "[Pinus].Aboveground.Wt",
                  "Name": "ABGWt",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.VariableReference, Models",
                  "VariableName": "[Pinus].Population",
                  "Name": "Population",
                  "ResourceName": null,
                  "Children": [],
