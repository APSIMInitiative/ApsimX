                    "[GrazeVineyardAlley].Script.HarvestableBiomass as HarvestableBiomassAlley",
                    "[GrazeVineyardAlley].Script.CurrentLocation as StockLocationAlley",
                    "[PlantainForage].AboveGround.Wt"
                  ],
