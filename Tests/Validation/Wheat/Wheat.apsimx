        {
          "$type": "Models.Core.Folder, Models",
          "ShowInDocs": true,
          "Name": "SE Queensland",
          "ResourceName": null,
          "Children": [
            {
              "$type": "Models.Memo, Models",
              "Text": "South-eastern Queensland has a warm subtropical environment.  Daytime temperatures are moderate due to the relatively low latitudes for wheat growing in Australia, but inland continental conditions can provide cool nights with occaisional frosts.  Many of the datasets used here have been published as part of previous APSIM Wheat model tests.  Further datasets have been added to provide information on phenological development of modern cultivars.",
              "Name": "Memo",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Factorial.Experiment, Models",
              "DisabledSimNames": null,
              "Name": "APS26",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Memo, Models",
                  "Text": "This trial was conducted at Gatton in 1995 using the local variety, Hartog.  It consisted of 4 Nitrogen rates (0,40,80,160) with two irrigation rates (minimal amount for establishment, fully irrigated).  Yields ranged from 1.4 t/ha to 5.4 t/ha.",
                  "Name": "Memo",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Factorial.Factors, Models",
                  "Name": "Factors",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Factorial.Permutation, Models",
                      "Name": "Permutation",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Factorial.Factor, Models",
                          "Specification": "[ApplyFertiliser].Script.Amount=0,40,80,160",
                          "Name": "NRate",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Factorial.Factor, Models",
                          "Specification": "[IrrigationSchedule]",
                          "Name": "Water",
                          "ResourceName": null,
                          "Children": [
                            {
                              "$type": "Models.Operations, Models",
                              "OperationsList": [
                                {
                                  "$type": "Models.Operation, Models",
                                  "Enabled": true,
                                  "Date": "1995-05-31",
                                  "Action": "[Irrigation].Apply(amount:31);",
                                  "Line": "1995-05-31 [Irrigation].Apply(amount:31);"
                                },
                                {
                                  "$type": "Models.Operation, Models",
                                  "Enabled": true,
