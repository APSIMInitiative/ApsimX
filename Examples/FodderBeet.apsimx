                    }
                  ],
                  "Name": "NFertEvents",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Manager, Models",
                  "CodeArray": [
                    "",
                    "using APSIM.Core;",
                    "using System.Xml.Serialization;",
                    "using APSIM.Shared.Utilities;",
                    "using Models.PMF;",
                    "using Models.Core;",
                    "using System;",
                    "using System.Linq;",
                    "using Models.Soils;",
                    "        ",
                    "namespace Models",
                    "{",
                    "    [Serializable] ",
                    "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                    "    public class Script : Model, IStructureDependency",
                    "    {",
                    "        [Link] private Plant FodderBeet;",
                    "        [Link] private Clock Clock;",
                    "        [Link] private Zone zone;",
                    "        [Link] private Summary Summary;",
                    "        public IStructure Structure { private get; set; }",
                    "",
                    "",
                    "        [Description(\" Date of Infection\")]",
                    "        public DateTime InfectionDate { get; set; }",
                    "        [Description(\"Is Infected\")]",
                    "        public bool IsInfected  {get; set;}    ",
                    "",
                    "",
                    "        ",
                    "",
                    "        [EventSubscribe(\"DoManagement\")]",
                    "        private void OnDoManagement(object sender, EventArgs e)",
                    "        {",
                    "            ",
                    "",
                    "            if (IsInfected == true) // an infected crop",
                    "              if (InfectionDate == Clock.Today)",
                    "               {",
                    "                Structure.Set(\"FodderBeet.Leaf.CohortParameters.SenescenceDuration.BaseValue.FixedValue\", 600, relativeTo: zone);",
                    "                Summary.WriteMessage(this,\"Fodder beet infected with fugal disease\", MessageType.Diagnostic);",
                    "                }",
                    "            ",
                    "        }",
                    "        ",
                    "    }",
                    "}",
                    "                "
                  ],
                  "Parameters": [
                    {
                      "Key": "InfectionDate",
                      "Value": "01/03/2015 00:00:00"
                    },
                    {
