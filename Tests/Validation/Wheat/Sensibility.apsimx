                            "[Wheat].Total.N",
                            "[Wheat].Total.Wt",
                            "([Wheat].Leaf.Transpiration + [ISoilWater].Es + [MicroClimate].PrecipitationInterception) as ET",
                            "[IWeather].MeanT",
                            "[Wheat].Phenology.Photoperiod",
                            "[Wheat].Phenology.AccumulatedTT",
                            "[SurfaceOrganicMatter].Wt",
                            "([SurfaceOrganicMatter].N / [SurfaceOrganicMatter].Wt) as StubbleN",
                            "([SurfaceOrganicMatter].C / [SurfaceOrganicMatter].N) as StubbleCNR"
