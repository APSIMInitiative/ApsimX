                              ],
                              "Name": "DefoliationManager",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            },
                            {
                              "$type": "Models.Manager, Models",
                              "CodeArray": [
                                "using APSIM.Core;",
                                "using Models.Interfaces;",
                                "using Models.Soils;",
                                "using Models.PMF;",
                                "using Models.Core;",
                                "using APSIM.Shared.Utilities;",
                                "using Newtonsoft.Json;",
                                "using System;",
                                "",
                                "namespace Models",
                                "{",
                                "    [Serializable]",
                                "    public class Script : Model, IStructureDependency",
                                "    {",
                                "        //> Links to other Apsim models",
                                "        [Link] private Clock clock;",
                                "        [Link] private Zone myZone;",
                                "        [Link] private IPhysical soilPhysical;",
                                "        [Link(ByName = true)] private ISolute Urea;",
                                "        [Link] private ISummary summary;",
                                "        public IStructure Structure { private get; set; }",
                                "",
                                "        //> Events raised by this manager",
                                "        public  event BiomassRemovedDelegate BiomassRemoved;",
                                "",
                                "        //> User inputs from properties tab",
                                "        [Separator(\"Script to add nitrogen and biomass to the soil to mimic excreta depositions (urine and/or dung)\")]",
                                "        [Description(\" Allow this manager to apply urine/dung automatically (linked to defoliations)?\")]",
                                "        public yesNoAnswer AllowDepositions { get; set; }",
                                "",
                                "        [Separator(\"Parameters defining the addition of urine to the soil\")]",
                                "        [Description(\" Amount of N to add to the soil (kg/ha):\")]",
                                "        [Display(VisibleCallback = \"isDepositionAllowed\")]",
                                "        public double UrineNToAdd { get; set; }",
                                "        [Description(\" Soil depth down to which urine is applied (mm):\")]",
                                "        [Display(VisibleCallback = \"isDepositionAllowed\")]",
                                "        public double UrineDepth { get; set; }",
                                "",
                                "        [Separator(\"Parameters defining the addition of dung to the soil surface\")]",
                                "        [Description(\" Amount of dung (dry matter) to add to the soil surface (kg/ha):\")]",
                                "        [Display(VisibleCallback = \"isDepositionAllowed\")]",
                                "        public double DungDMToAdd { get; set; }",
                                "        [Description(\" How the N content in dung is defined?\")]",
                                "        [Display(VisibleCallback = \"isDepositionAllowed\")]",
                                "        public DungNTypes NDungType { get; set; }",
                                "        [Description(\"   Amount of N to return in dung (kg/ha):\")]",
                                "        [Display(VisibleCallback = \"isDungNAmount\")]",
                                "        public double DungNToAdd { get; set; }",
                                "        [Description(\"   The C:N ratio of dung (typically around 20):\")]",
                                "        [Display(VisibleCallback = \"isDungCNratio\")]",
                                "        public double CNRatioDung { get; set; }",
                                "        ",
                                "        //> Outputs from this manager",
                                "        [JsonIgnore][Units(\"kg/ha\")] // DM amount added to the soil surface mimicking dung deposition ",
                                "        public double DungDepositionWt { get; set; }",
                                "        [JsonIgnore][Units(\"kg/ha\")] // N amount added to the soil surface mimicking dung deposition ",
                                "        public double DungDepositionN { get; set; }",
                                "        [JsonIgnore][Units(\"kg/ha\")] // N amount added to the soil mimicking urine deposition",
                                "        public double UrineDepositionN { get; set; }",
                                "",
                                "        //> Internal variables",
                                "        private double baseUrineDepth;           // base depth to apply urine (mm)",
                                "        private double[] urineFraction;          // fraction of urine to be applied in each soil layer",
                                "        private double harvestedWt;              // amount harvested today (g/m2), to check whether a defoliation has happened",
                                "        ",
                                "",
                                "        [EventSubscribe(\"StartOfSimulation\")]",
                                "        private void OnStartOfSimulation(object sender, EventArgs e)",
                                "        {",
                                "            if (isDepositionAllowed)",
                                "            {",
                                "                // check the amount of N to add in dung",
                                "                if (DungDMToAdd > 0.0)",
                                "                {",
                                "                    if (isDungCNratio)",
                                "                    {",
                                "                        if (CNRatioDung <= 0.0)",
                                "                        {",
                                "                            throw new Exception(\"The C:N ratio of dung has to be greater than zero\");",
                                "                        }",
                                "",
                                "                        DungNToAdd = DungDMToAdd * 0.4 / CNRatioDung;",
                                "                    }",
                                "                }",
                                "",
                                "                // set the fraction of urine for each layer",
                                "                if (UrineNToAdd > 0.0)",
                                "                {",
                                "                    if (UrineDepth < 0.0)",
                                "                    {",
                                "                        throw new Exception(\"The depth for adding urine must be greater than zero\");",
                                "                    }",
                                "",
                                "                    baseUrineDepth = UrineDepth;",
                                "                    urineFraction = getUrineFractions(baseUrineDepth);",
                                "                }",
                                "            }",
                                "",
                                "            // write message in summary",
                                "            summary.WriteMessage(this,\" Initialising script to add dung and urine to the soil\", MessageType.Diagnostic);",
                                "            if (isDepositionAllowed)",
                                "            {",
                                "                if(DungDMToAdd > 0.0)",
                                "                {",
                                "                    summary.WriteMessage(this,\"   Dung will be added to the soil surface following each harvest. This includes adding \" + DungDMToAdd.ToString(\"#0.0\")",
                                "                                             + \" kgDM/ha of material with \" + DungNToAdd.ToString(\"#0.0\") + \" kgN/ha\", MessageType.Diagnostic);",
                                "                }",
                                "",
                                "                if(UrineNToAdd > 0.0)",
                                "                {",
                                "                    summary.WriteMessage(this,\"   Urine will be added to the soil following each harvest. This will be mimicked by adding \" + UrineNToAdd.ToString(\"#0.0\")",
                                "                                             + \" kgN/ha to the soil, down to a depth of \" + UrineDepth.ToString(\"#0\") + \"mm\", MessageType.Diagnostic);",
                                "                    summary.WriteMessage(this,\"   Urine will be added over the soil profile according to proportions: \"",
                                "                                             + string.Join(\", \",urineFraction), MessageType.Diagnostic);",
                                "                }",
                                "                else",
                                "                {",
                                "                    summary.WriteMessage(this,\"   Non-removed material will be returned as residue.\", MessageType.Diagnostic);",
                                "                }",
                                "            }",
                                "            else",
                                "            {",
                                "                summary.WriteMessage(this,\"   Excreta will not be added automatically, but it can still happened, triggered by external command (i.e. Operations)\", MessageType.Diagnostic);",
                                "            }",
                                "        }",
                                "",
                                "        [EventSubscribe(\"DoManagement\")]",
                                "        private void OnDoManagement(object sender, EventArgs e)",
                                "        {",
                                "            // zero variables",
                                "            DungDepositionWt = 0.0;",
                                "            DungDepositionN = 0.0;",
                                "            UrineDepositionN = 0.0;",
                                "",
                                "            // check whether a defoliations has happened",
                                "            if (isDepositionAllowed)",
                                "            {",
                                "                harvestedWt = (double)Structure.Get(\"[DefoliationManager].Script.HarvestedWt\", relativeTo: myZone);",
                                "                if (harvestedWt > 0.0)",
                                "                { // a defoliation/harvest happened today, apply some excreta",
                                "                    AddExcreta(urineNToAdd: UrineNToAdd, depthUrine: UrineDepth, dungDMToAdd: DungDMToAdd, dungNToAdd: DungNToAdd);",
                                "                }",
                                "            }",
                                "        }",
                                "",
                                "        private double[] getUrineFractions(double depthToCalculate)",
                                "        {",
                                "            // get layer corresponding to the depth to calculate",
                                "            int bottomLayer = 0;",
                                "            double depthFromSurface = 0.0;",
                                "            for (int layer = 0; layer < soilPhysical.Thickness.Length; layer++)",
                                "            {",
                                "                depthFromSurface += soilPhysical.Thickness[layer];",
                                "                if (depthFromSurface >= depthToCalculate)",
                                "                { // bottom layer found",
                                "                    bottomLayer = layer;",
                                "                    layer = soilPhysical.Thickness.Length;",
                                "                }",
                                "            }",
                                "",
                                "            // compute fractions for each layer",
                                "            double[] fractionsComputed = new double[bottomLayer + 1];",
                                "            double distFactor = 1.5;",
                                "            double totalProp = depthToCalculate * Math.Pow(1.0, distFactor) / (distFactor + 1.0);",
                                "            depthFromSurface = 0.0;",
                                "            double propAtZ0 = 0.0;",
                                "            double propAtZ1 = (depthToCalculate - depthFromSurface) * Math.Pow(1.0 - depthFromSurface / depthToCalculate, distFactor) / (distFactor + 1.0);",
                                "            for (int layer = 0; layer < bottomLayer + 1; layer++)",
                                "            {",
                                "                propAtZ0 = propAtZ1;",
                                "                depthFromSurface += soilPhysical.Thickness[layer];",
                                "                propAtZ1 = (depthToCalculate - depthFromSurface) * Math.Pow(1.0 - depthFromSurface / depthToCalculate, distFactor) / (distFactor + 1.0);",
                                "                if (1.0 - (depthFromSurface / depthToCalculate) < 0.0)",
                                "                {",
                                "                    propAtZ1 = 0;",
                                "                }",
                                "                fractionsComputed[layer] = (propAtZ0 - propAtZ1) / totalProp;",
                                "            }",
                                "            ",
                                "            return fractionsComputed;",
                                "        }",
                                "",
                                "        public void AddExcreta(double urineNToAdd, double depthUrine, double dungDMToAdd, double dungNToAdd)",
                                "        {",
                                "            if (dungDMToAdd > 0.0)",
                                "            {",
                                "                // create data package to pass biomass info to SurfaceOrganicMatter",
                                "                PMF.BiomassRemovedType BiomassDung = new PMF.BiomassRemovedType();",
                                "                string[] type = new string[] { \"RuminantDung_PastureFed\" };",
                                "                float[] dltdm = new float[] { (float)(dungDMToAdd) };",
                                "                float[] dltn = new float[] { (float)(dungNToAdd) };",
                                "                float[] dltp = new float[] { 0.0f };",
                                "                float[] fraction = new float[] { 1.0f };     // fraction is always 1.0 here",
                                "                BiomassDung.crop_type = \"RuminantDung_PastureFed\";",
                                "                BiomassDung.dm_type = type;",
                                "                BiomassDung.dlt_crop_dm = dltdm;",
                                "                BiomassDung.dlt_dm_n = dltn;",
                                "                BiomassDung.dlt_dm_p = dltp;",
                                "                BiomassDung.fraction_to_residue = fraction;",
                                "",
                                "                // add dung biomass and N to surface OM",
                                "                BiomassRemoved.Invoke(BiomassDung);",
                                "                DungDepositionWt = dungDMToAdd;",
                                "                DungDepositionN = dungNToAdd;",
                                "            }",
                                "",
                                "            if (urineNToAdd > 0.0)",
                                "            {",
                                "                // check depth",
                                "                if (Math.Abs(depthUrine - baseUrineDepth) > 0.1)",
                                "                { // new depth, recalculate fractions",
                                "                    baseUrineDepth = depthUrine;",
                                "                    urineFraction = getUrineFractions(baseUrineDepth);",
                                "                }",
                                "",
                                "                // get distribution of N to add ",
                                "                double[] myUrineDeposition = new double[soilPhysical.Thickness.Length];",
                                "                for (int z = 0; z < urineFraction.Length; z++)",
                                "                {",
                                "                    myUrineDeposition[z] = urineNToAdd * urineFraction[z];",
                                "                }",
                                "",
                                "                // add urine N to the soil",
                                "                Urea.AddKgHaDelta(SoluteSetterType.Fertiliser, myUrineDeposition);",
                                "                UrineDepositionN = urineNToAdd;",
                                "            }",
                                "        }",
                                "",
                                "        private bool isDepositionAllowed { get { return AllowDepositions == yesNoAnswer.Yes; } }",
                                "        private bool isDungNAmount { get { return isDepositionAllowed && NDungType == DungNTypes.SetAmount; } }",
                                "        private bool isDungCNratio { get { return isDepositionAllowed && NDungType == DungNTypes.SetCNratio; } }",
                                "",
                                "        /// <summary>Flag for a positive or negative answer.</summary>",
                                "        public enum yesNoAnswer",
                                "        {",
                                "            /// <summary>Positive answer.</summary>",
                                "            Yes,",
                                "            /// <summary>Negative answer.</summary>",
                                "            No",
                                "        }",
                                "",
                                "        /// <summary>Flag how N in dung is defined.</summary>",
                                "        public enum DungNTypes",
                                "        {",
                                "            /// <summary>An amount is given.</summary>",
                                "            SetAmount,",
                                "            /// <summary>Negative answer.</summary>",
                                "            SetCNratio",
                                "        }",
                                "    }",
                                "}",
                                ""
                              ],
                              "Parameters": [
                                {
                                  "Key": "AllowDepositions",
                                  "Value": "No"
                                },
                                {
                                  "Key": "UrineNToAdd",
                                  "Value": "15"
                                },
                                {
                                  "Key": "UrineDepth",
                                  "Value": "150"
                                },
                                {
                                  "Key": "DungDMToAdd",
                                  "Value": "220"
                                },
                                {
                                  "Key": "NDungType",
                                  "Value": "SetCNratio"
                                },
                                {
                                  "Key": "DungNToAdd",
                                  "Value": "0"
                                },
                                {
                                  "Key": "CNRatioDung",
                                  "Value": "17.5"
                                }
                              ],
                              "Name": "DungAndUrine",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            }
                          ],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.MicroClimate, Models",
                          "a_interception": 0.0,
                          "b_interception": 1.0,
                          "c_interception": 0.0,
                          "d_interception": 0.0,
                          "SoilHeatFluxFraction": 0.4,
                          "MinimumHeightDiffForNewLayer": 0.0,
                          "NightInterceptionFraction": 0.5,
                          "ReferenceHeight": 2.0,
                          "Name": "MicroClimate",
