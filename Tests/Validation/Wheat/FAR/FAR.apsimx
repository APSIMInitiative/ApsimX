                              "Value": "14,9.5,19"
                            },
                            {
                              "Key": "ThicknessCsvString",
                              "Value": "100,200,300"
                            }
                          ],
                          "Name": "NO3Initialise2",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
