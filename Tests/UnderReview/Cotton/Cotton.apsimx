        {
          "$type": "Models.Core.Folder, Models",
          "ShowInDocs": true,
          "Name": "Emerald Sowing Time Experiment 2015",
          "ResourceName": null,
          "Children": [
            {
              "$type": "Models.Memo, Models",
              "Text": "\n11/6/2025:\n\nStarting nitrogen in Planting 3 is likely to be lower than P1 & P2\n\n=====================================================================\n\n11/03/2025:\n\nSOURCE: \n\nGrundy, P. R., Spargo, G. M., Yeates, S. J., & Bell, K. L. (2021). Improving subtropical cotton production by using late winter sowing to reduce climatic risk. Field Crops Research, 274. https://doi.org/10.1016/j.fcr.2021.108308 \n\n25/01/2024:\n\nThe very early august sowings got the final irrigation around 10-15 Dec. \n\nThe mid August ones typically got the last one around boxing day or the 27th Dec. \n\nThe Sept sowing would have gotten one more after that about 10 days later.\n",
              "Name": "Memo",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Memo, Models",
              "Text": "Stage|P1|DAS|P2|DAS|P3|DAS\n-|-|-|-|-|-|-\nSowing|1 Aug 2015|0|21 Aug 2015|0|15 Sep 2015|0|\t\nEmergence||||\nSquaring|7 Oct 2015|67|11 Oct 2015|51|3 Nov 2015|49|\nFlowering|27 Oct 2015|87|4 Nov 2015|75|18 Nov 2015|64|\nCutout|2 Dec 2015|123|7 Dec 2015|108|22 Dec 2015|98|\nOpenBolls|17 Dec 2015|138|22 Dec 2015|123|5 Jan 2016|112|\nMaturity|12 Jan 2016|164|13 Jan 2016|145|7 Feb 2016|145|\nHarvestRipe|25 Jan 2016|177|28 Jan 2016|160|12 Mar 2016|179|\n\nPaul Grundy (18/06/2025): For the August sowings cotton was always emerged by 11-13 days and for the mid-Sept it was 6-7 days.",
              "Name": "Phenology stages Observed",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Memo, Models",
              "Text": "Grundy, P. R., Spargo, G. M., Yeates, S. J., & Bell, K. L. (2021). Improving subtropical cotton production by using late winter sowing to reduce climatic risk. Field Crops Research, 274. https://doi.org/10.1016/j.fcr.2021.108308 \n\nI could not identify any details in the paper and therefore assume that none were applied. \n\nNo data on growth regulators were provided with the observed data either.",
              "Name": "Growth regulator details",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Factorial.Experiment, Models",
              "DisabledSimNames": null,
              "Name": "Emerald2015",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Factorial.Factors, Models",
                  "Name": "Factors",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Factorial.CompositeFactor, Models",
                      "Specifications": [
                        "[Reset on date]",
                        "[Operations]",
                        "[FurrowIrrigation]",
                        "[HarvestAfterDate]"
                      ],
                      "CustomDescriptors": [],
                      "Name": "P1",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "using Models.Soils.Nutrients;",
                            "using APSIM.Shared.Utilities;",
                            "using Models.Surface;",
                            "using Models.Utilities;",
                            "using Models.Soils.Nutrients;",
                            "using Models.Soils;",
                            "using Models.PMF;",
                            "using Models.Core;",
                            "using System;",
                            "using System.Linq;",
                            "using Models.Interfaces;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable]",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] private Clock Clock;",
                            "        [Link] private Plant Wheat;",
                            "        [Link] private ISoilWater SoilWater;",
                            "        [Link] private Nutrient nutrient;",
                            "        [Link] private SurfaceOrganicMatter SOM;",
                            "        [Link] private Summary Summary;",
                            "",
                            "        [Description(\"Date to reset on:\")]",
                            "        public string ResetDate {get;set;}",
                            "        ",
                            "        [Description(\"Offset by Days (Negative is Days Before, Positive is Days After):\")]",
                            "        public int OffsetDays {get;set;}",
                            "",
                            "        [Description(\"Reset Water?\")]",
                            "        public bool ResetWater {get;set;}",
                            "",
                            "        [Description(\"Reset Soil Nutrients?\")]",
                            "        public bool ResetNutrients {get;set;}",
                            "",
                            "        [Description(\"Reset Surface Organic Matter?\")]",
                            "        public bool ResetSOM {get;set;}",
                            "",
                            "        [EventSubscribe(\"DoManagement\")]",
                            "        private void OnDoManagement(object sender, EventArgs e)",
                            "        {",
                            "            DateTime offsetDate = DateUtilities.GetDate(ResetDate, Clock.Today).AddDays(OffsetDays);",
                            "            if (offsetDate.Equals(Clock.Today))",
                            "            {",
                            "                if (ResetWater)",
                            "                {",
                            "                    Summary.WriteMessage(this, \"Reset Water\", MessageType.Diagnostic);",
                            "                    SoilWater.Reset();",
                            "                }",
                            "                if (ResetNutrients)",
                            "                {",
                            "                    Summary.WriteMessage(this, \"Reset Nitrogen\", MessageType.Diagnostic);",
                            "                    nutrient.Reset();",
                            "                }",
                            "                if (ResetSOM)",
                            "                {",
                            "                    Summary.WriteMessage(this, \"Reset Surface OM\", MessageType.Diagnostic);",
                            "                    SOM.Reset();",
                            "                }",
                            "            }",
                            "        }",
                            "    }",
                            "}"
                          ],
                          "Parameters": [
                            {
                              "Key": "ResetDate",
                              "Value": "19-June"
                            },
                            {
                              "Key": "OffsetDays",
                              "Value": "0"
                            },
                            {
                              "Key": "ResetWater",
                              "Value": "False"
                            },
                            {
                              "Key": "ResetNutrients",
                              "Value": "True"
                            },
                            {
                              "Key": "ResetSOM",
                              "Value": "False"
                            }
                          ],
                          "Name": "Reset on date",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Operations, Models",
                          "OperationsList": [
                            {
                              "$type": "Models.Operation, Models",
                              "Enabled": true,
                              "Date": "2015-06-20",
                              "Action": "[Fertiliser].Apply(100, \"UreaN\",15); //6-8 weeks prior to sowing",
                              "Line": "2015-06-20 [Fertiliser].Apply(100, \"UreaN\",15); //6-8 weeks prior to sowing"
                            },
                            {
                              "$type": "Models.Operation, Models",
                              "Enabled": true,
                              "Date": "2015-08-01",
                              "Action": "[Cotton].Sow(population: 9.55, cultivar: Sicot_74BRF , depth: 20, rowSpacing: 1000);",
                              "Line": "2015-08-01 [Cotton].Sow(population: 9.55, cultivar: Sicot_74BRF , depth: 20, rowSpacing: 1000);"
                            },
                            {
                              "$type": "Models.Operation, Models",
                              "Enabled": true,
                              "Date": "2015-10-05",
                              "Action": "[Fertiliser].Apply(140, \"UreaN\",15); //during early squaring",
                              "Line": "2015-10-05 [Fertiliser].Apply(140, \"UreaN\",15); //during early squaring"
                            }
                          ],
                          "Name": "Operations",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "using Models.Interfaces;",
                            "using System;",
                            "using System.Linq;",
                            "using Models.Core;",
                            "using System.Collections.Generic;",
                            "using System.Text;",
                            "using Models.Soils;",
                            "using Models.PMF;",
                            "using System.Xml.Serialization;",
                            "using APSIM.Shared.Utilities;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable]",
                            "    public class Script : Model",
                            "    {",
                            "        // Links",
                            "        [Link] Clock clock;",
                            "        [Link] Irrigation Irrigation;",
                            "        [Link] Soil Soil;",
                            "        [Link] IPhysical soilPhysical;",
                            "        [Link] ISoilWater waterBalance;",
                            "",
                            "        // Fields",
                            "        public double SW_now;",
                            "        public double CLL_now;",
                            "        public double SW_full;",
                            "",
                            "        // Properties",
                            "        [Description(\"Enter the irrigation dates as dd-mmm with comma separation (any year information entered will be ignored)\")]",
                            "        public string[] IrrigateDates { get; set; } // Chosen date for irrigation",
                            "        [Description(\"Number of soil layers used in calculating SW deficit\")]",
                            "        public int asw_depth { get; set; } // Change to int for layer count",
                            "        [Description(\"Fraction of ASW below which irrigation is applied (0-1.0)\")]",
                            "        public double crit_fr_asw { get; set; } // Critical fraction of available soil water before applying irrigation",
                            "",
                            "        // Output variables",
                            "        public double[] inflow_lat { get; set; }",
                            "        public double applied_furrow_irrigation { get; set; }",
                            "",
                            "        // Methods",
                            "",
                            "        // Calculate static soil variables",
                            "        [EventSubscribe(\"StartOfSimulation\")]",
                            "        private void OnStartOfSimulation(object sender, EventArgs e)",
                            "        {",
                            "            // Initialize inflow_lat array",
                            "            inflow_lat = new double[soilPhysical.DULmm.Length];",
                            "        }",
                            "",
                            "        // Determine daily requirement for irrigation",
                            "        [EventSubscribe(\"StartOfDay\")]",
                            "        private void OnStartOfDay(object sender, EventArgs e)",
                            "        {",
                            "          foreach (string ddMMM in IrrigateDates)",
                            "          {",
                            "            // Check if today is the chosen irrigation date",
                            "            if (DateUtilities.DatesEqual(ddMMM, clock.Today))",
                            "            {",
                            "                // Calculate soil water variables",
                            "                double[] SW_add = new double[soilPhysical.DULmm.Length];",
                            "                for (int layer = 0; layer < asw_depth; layer++)",
                            "                {",
                            "                    SW_now += waterBalance.SWmm[layer];",
                            "                    CLL_now += soilPhysical.LL15mm[layer];",
                            "                    SW_full += (soilPhysical.DULmm[layer] - soilPhysical.LL15mm[layer]);",
                            "                    SW_add[layer] = soilPhysical.DULmm[layer] - waterBalance.SWmm[layer];",
                            "                }",
                            "",
                            "                // Is the soil water deficit greater than the critical SW fraction?",
                            "                if ((SW_now - CLL_now) <= (SW_full * crit_fr_asw))",
                            "                {",
                            "                    // Calculate irrigation and apply it",
                            "                    for (int layer = 1; layer < asw_depth; layer++)",
                            "                    {",
                            "                        inflow_lat[layer] = SW_add[layer] + (SW_add[0] / (asw_depth - 1));",
                            "                        applied_furrow_irrigation += inflow_lat[layer];",
                            "                        Irrigation.Apply(inflow_lat[layer], depth: soilPhysical.Thickness[layer]);",
                            "                    }",
                            "                }",
                            "                else",
                            "                {",
                            "                    for (int layer = 0; layer < soilPhysical.DULmm.Length; layer++)",
                            "                    {",
                            "                        inflow_lat[layer] = 0;",
                            "                        applied_furrow_irrigation = 0;",
                            "                    }",
                            "                }",
                            "            }",
                            "        }",
                            "    }",
                            "}}",
                            ""
                          ],
                          "Parameters": [
                            {
                              "Key": "IrrigateDates",
                              "Value": "25-jul, 30-aug, 15-sep, 17-oct, 29-oct, 20-nov, 28-nov, 10-dec, 18-dec, 4-jan"
                            },
                            {
                              "Key": "asw_depth",
                              "Value": "9"
                            },
                            {
                              "Key": "crit_fr_asw",
                              "Value": "1"
                            }
                          ],
                          "Name": "FurrowIrrigation",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "using Models.Soils;",
                            "using System;",
                            "using Models.Core;",
                            "using System.Text;",
                            "using Models.PMF;",
                            "using Models;",
                            "using APSIM.Shared.Utilities;",
                            "using Models.PMF.Phen;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable] ",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] ISummary summary;",
                            "        [Link] private Plant cotton;",
                            "        [Link(Type = LinkType.Path, Path = \"[cotton].Phenology\")]",
                            "        private Phenology phenology;",
                            "                [Link] Clock Clock;",
                            "",
                            "        private bool Harvestable = false;",
                            "",
                            "        [Description(\"Harvest Date (d-mmm)\")]",
                            "        public string HarvestDate { get; set; }   ",
                            "      ",
                            "        [EventSubscribe(\"DoManagement\")]",
                            "        private void OnDoManagement(object sender, EventArgs e)",
                            "        {",
                            "           ",
                            "            if (Harvestable && phenology.CurrentPhase.Name == \"ReadyForHarvesting\")",
                            "            {",
                            "                cotton.Harvest();",
                            "                cotton.EndCrop();                ",
                            "            }",
                            "            ",
                            "            if (DateUtilities.DatesAreEqual(HarvestDate, Clock.Today))",
                            "                Harvestable = true;",
                            "",
                            "        }",
                            "    }",
                            "}",
                            "       "
                          ],
                          "Parameters": [
                            {
                              "Key": "HarvestDate",
                              "Value": "25-jan"
                            }
                          ],
                          "Name": "HarvestAfterDate",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        }
                      ],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Factorial.CompositeFactor, Models",
                      "Specifications": [
