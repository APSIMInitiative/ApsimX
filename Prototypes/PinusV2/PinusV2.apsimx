            {
              "$type": "Models.PMF.Organs.PerennialLeaf, Models",
              "DMSupply": null,
              "NSupply": null,
              "DMDemand": null,
              "NDemand": null,
              "MaintenanceRespiration": 0.0,
              "GrowthRespiration": 0.0,
              "Albedo": 0.15,
              "Gsmax350": 0.006,
              "R50": 150.0,
              "LAI": 0.0,
              "Height": 0.0,
              "FRGR": 0.0,
              "PotentialEP": 0.0,
              "WaterDemand": 0.0,
              "LightProfile": null,
              "potentialDMAllocation": null,
              "Name": "Leaf",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Functions.ExpressionFunction, Models",
                  "Units": null,
                  "Expression": "(163 - [IWeather].MeanT)/(5 - 0.1*[IWeather].MeanT)",
                  "Name": "CO2internal",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "Concentrations of CO2 change enough over two or more decades to noticably affect simulated Pinus growth within even one  plantation cycle, as the rotation length for most Pinus plantations is commonly more than one decade. For such simulations we recommend specification in the met file of either the average CO2 during the simulation (if more 1-3 decades) or daily values for longer simulations. \n\nStandard PMF use of CO2 concentration data is provided here.  \r\n\r\n",
                      "Name": "Memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.DivideFunction, Models",
                  "Name": "StomatalConductanceCO2Modifier",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Functions.VariableReference, Models",
                      "VariableName": "[Leaf].Photosynthesis.FCO2",
                      "Name": "FCO2",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.ExpressionFunction, Models",
                      "Units": null,
                      "Expression": "([IWeather].CO2 - [Leaf].CO2internal)/(350 - [Leaf].CO2internal)",
                      "Name": "RelativeCO2Gradient",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.MultiplyFunction, Models",
                  "Name": "InitialWtFunction",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Functions.Constant, Models",
                      "FixedValue": 1.0,
                      "Units": "g/plant",
                      "Name": "InitialPlantWt",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Memo, Models",
                          "Text": "This value is nominally low to reflect the dry weight of leaves on a transplanted seedling. \r\n\r\n",
                          "Name": "Memo",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        }
                      ],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.VariableReference, Models",
                      "VariableName": "[Plant].Population",
                      "Name": "Population",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.Constant, Models",
                  "FixedValue": 0.0,
                  "Units": "m^2/m^2",
                  "Name": "LaiDeadFunction",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.MinimumFunction, Models",
                  "Name": "FRGRFunction",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "The FRGRFunction, as used to calculate water uptake, is sensitive to stresses of temperature, N status and vpd.\r\n\r\n\n",
                      "Name": "Memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.VariableReference, Models",
                      "VariableName": "[Leaf].Photosynthesis.FT.FTDaytime",
                      "Name": "FT",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.VariableReference, Models",
                      "VariableName": "[Leaf].Photosynthesis.FVPD",
                      "Name": "FVPD",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.LinearInterpolationFunction, Models",
                  "Name": "ExtinctionCoefficient",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Functions.XYPairs, Models",
                      "X": [
                        0.0,
                        1.0
                      ],
                      "Y": [
                        0.3,
                        0.5
                      ],
                      "Name": "XYPairs",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.ProtectedDivideFunction, Models",
                      "NumeratorErrVal": 0.0,
                      "DenominatorErrVal": 0.0,
                      "Name": "XValue",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Functions.VariableReference, Models",
                          "VariableName": "[Leaf].Height",
                          "Name": "Height",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Functions.ProtectedDivideFunction, Models",
                          "NumeratorErrVal": 0.0,
                          "DenominatorErrVal": 0.0,
                          "Name": "Spacing",
                          "ResourceName": null,
                          "Children": [
                            {
                              "$type": "Models.Functions.Constant, Models",
                              "FixedValue": 1000.0,
                              "Units": null,
                              "Name": "Numerator",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            },
                            {
                              "$type": "Models.Functions.ExpressionFunction, Models",
                              "Units": null,
                              "Expression": "sqrt([Pinus].Population)",
                              "Name": "Denominator",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            }
                          ],
                          "Enabled": true,
                          "ReadOnly": false
                        }
                      ],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.Constant, Models",
                  "FixedValue": 0.5,
                  "Units": null,
                  "Name": "ExtinctionCoefficientDead",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.Constant, Models",
                  "FixedValue": 0.013,
                  "Units": "g/g",
                  "Name": "MaximumNConc",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "Maximum and minimum N concentration data were guided by those available in some datasets.\r\n\r\n",
                      "Name": "Memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.Constant, Models",
                  "FixedValue": 0.003,
                  "Units": "g/g",
                  "Name": "MinimumNConc",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "This value comes from observed leaf N in validation dataset (radiata 10th percentile 6.95 mg/g)",
                      "Name": "Memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.Constant, Models",
                  "FixedValue": 1.0,
                  "Units": "/d",
                  "Name": "NReallocationFactor",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "A value of zero assumes there is no N reallocation. The value of 0.5 used here ensures rapid reallocation.\r\n\r\n",
                      "Name": "Memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.PMF.Library.BiomassRemoval, Models",
                  "HarvestFractionLiveToRemove": 0.0,
                  "HarvestFractionDeadToRemove": 0.0,
                  "HarvestFractionLiveToResidue": 0.99,
                  "HarvestFractionDeadToResidue": 0.99,
                  "Name": "BiomassRemovalDefaults",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.Constant, Models",
                  "FixedValue": 1.0,
                  "Units": "g/g",
                  "Name": "DMConversionEfficiency",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.Constant, Models",
                  "FixedValue": 14.0,
                  "Units": "d",
                  "Name": "LeafDetachmentTime",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "A value here is the number of days between senescence and detachment. A value of 14 days is assumed. \r\n\r\n",
                      "Name": "Memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.Constant, Models",
                  "FixedValue": 0.0,
                  "Units": "/d",
                  "Name": "DetachmentRateFunction",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "A value for DetachmentRateFunction is required in Leaf, Branch, Stem and CoarseRoot components of the model, but a zero value means that immediate detachment has been triggered. A non-zero option might be useful in the future for defining some genotypes.  \r\n\r\n",
                      "Name": "Memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.Constant, Models",
                  "FixedValue": 0.0,
                  "Units": "/d",
                  "Name": "DMRetranslocationFactor",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "A value of zero assumes there is no dry matter retranslocation. \r\n\r\n",
                      "Name": "Memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.ExpressionFunction, Models",
                  "Units": "/d",
                  "Expression": "0.003*max(0,min(1,([Leaf].Live.NConc-0.009)/0.004))",
                  "Name": "NRetranslocationFactor",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "Daily fraction of labile (storage) leaf N available for retranslocation. Tapers from 0.003 /d at leaf N 1.3% to zero at 0.9%, so stored N is returned for growth without draining the canopy (BFG control leaf N stays ~0.94% vs 1.04% observed; Crane & Banks 1992 found retranslocation from retained foliage equalled or exceeded resorption at senescence).\r\n\r\n",
                      "Name": "Memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.SupplyFunctions.RUEModel, Models",
                  "Name": "Photosynthesis",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "The value of RUE for tree crops is generally in the range 1.3-1.7. Here a value of 1.3 is used, and modified by stresses for temperature, vpd, nitrogen, water and CO2.\r\n\r\n\n",
                      "Name": "Memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.Constant, Models",
