                              "Key": "SoluteName",
                              "Value": "NH4"
                            },
                            {
                              "Key": "DateCsvString",
                              "Value": "2020/07/21"
                            },
                            {
                              "Key": "ValueCsvString",
                              "Value": "4.806,7.27,5.131"
                            },
                            {
                              "Key": "ThicknessCsvString",
                              "Value": "300,300,300"
                            }
                          ],
