              "ReadOnly": false
            },
            {
              "$type": "Models.Core.Folder, Models",
              "ShowInDocs": true,
              "Name": "Australia",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Memo, Models",
                  "Text": "These are the Australian sites of the Tropical and SubTropical datasets.\n\nData come from sites of Forestry Plantations Queensland (FPQ; [#dieters2007productivity]) and Hancocks Queensland Plantations (HQP). \n\n\n",
                  "Name": "Memo",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Core.Folder, Models",
                  "ShowInDocs": true,
                  "Name": "FPQBeerwah",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "These data are from a genetics experiment in south-east Queensland described by [#dieters2007productivity]. Four genotypes are compared: _P. elliottii_ var. elliottii (PEE), _P. caribaea_ var. hondurensis (PCH), the F1 hybrid, and the F2 hybrid. As only stem metrics were provided in the paper, genotypes were not calibrated for biomass components and other physiological attributes. \n\n\n",
                      "Name": "Memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
