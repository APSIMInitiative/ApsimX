                    {
                      "$type": "Models.Manager, Models",
                      "CodeArray": [
                        "using System;",
                        "using Models.Core;",
                        "using Models.PMF;",
                        "using APSIM.Shared.Utilities;",
                        "",
                        "namespace Models",
                        "{",
                        "    /// <summary>Sows the crop on a fixed date (d-mmm) each year.</summary>",
                        "    [Serializable]",
                        "    public class Script : Model",
                        "    {",
                        "        [Link] private Clock clock = null;",
                        "        [Link(Type = LinkType.Path, Path = \"[Wheat]\")] private Plant wheat = null;",
                        "",
                        "        [Description(\"Sowing date (d-mmm)\")] public string SowingDate { get; set; }",
                        "        [Description(\"Sowing depth (mm)\")] public double SowingDepth { get; set; }",
                        "        [Description(\"Cultivar\")] public string CultivarName { get; set; }",
                        "        [Description(\"Population (plants/m2)\")] public double Population { get; set; }",
                        "        [Description(\"Row spacing (mm)\")] public double RowSpacing { get; set; }",
                        "",
                        "        [EventSubscribe(\"DoManagement\")]",
                        "        private void OnDoManagement(object sender, EventArgs e)",
                        "        {",
                        "            if (!wheat.IsAlive && DateUtilities.DatesEqual(SowingDate, clock.Today))",
                        "                wheat.Sow(CultivarName, Population, SowingDepth, RowSpacing);",
                        "        }",
                        "    }",
                        "}"
                      ],
                      "Parameters": [
                        {
                          "Key": "SowingDate",
                          "Value": "1-Jun"
                        },
                        {
                          "Key": "SowingDepth",
                          "Value": "30"
                        },
                        {
                          "Key": "CultivarName",
                          "Value": "Mace"
                        },
                        {
                          "Key": "Population",
                          "Value": "150"
                        },
                        {
                          "Key": "RowSpacing",
                          "Value": "250"
                        }
                      ],
                      "Name": "SowingRule",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
