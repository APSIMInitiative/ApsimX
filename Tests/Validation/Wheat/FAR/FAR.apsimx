            {
              "$type": "Models.Factorial.Experiment, Models",
              "DisabledSimNames": null,
              "Name": "FAR SAC W21-05-1",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Memo, Models",
                  "Text": "# Field Applied Research (FAR) Australia trial FAR SAC W21-05-1 at Millicent in 2021. \r\n\r\nThis trial has been selected because it contained 2 cultivars of interest, and had up to 2 Greenseeker (NDVI), 0 biomass, 0 N concentration or 2 growth stage measurements. \r\n\r\n*Grazing/defolation treatments have been excluded.* \r\n\r\nTrial description: **Value of pre and post GS30 defoliation in spring germplasm grown in HRZ regions of different season lengths using 21st April sowing date.** \r\n\r\n[Trial write-up](https://faraustralia.com.au/wp-content/uploads/2022/04/HYC-2021-Results-FINAL.pdf) \r\n\r\n",
                  "Name": "Description",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
