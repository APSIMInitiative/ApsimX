                    {
                      "$type": "Models.Manager, Models",
                      "CodeArray": [
                        "using Models.Soils;",
                        "using System;",
                        "using Models.Core;",
                        "using Models.PMF;",
                        "using APSIM.Shared.Utilities;",
                        "",
                        "namespace Models",
                        "{",
                        "    [Serializable]",
                        "    public class Script : Model",
                        "    {",
                        "        [Link] Clock Clock;",
                        "        [Link] Fertiliser Fertiliser;",
                        "        [Link] Summary Summary;",
                        "        ",
                        "        [Description(\"Country\")]",
                        "        public string Country { get; set; }",
                        "",
                        "        [Description(\"State\")]",
                        "        public string State { get; set; }",
                        "",
