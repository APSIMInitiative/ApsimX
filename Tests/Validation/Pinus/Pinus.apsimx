                              "ResourceName": "Pinus",
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            },
                            {
                              "$type": "Models.Manager, Models",
                              "CodeArray": [
                                "",
                                "using Models.Soils;",
                                "using System;",
                                "using Models.Core;",
                                "using Models.PMF;",
                                "namespace Models",
                                "{",
                                "    [Serializable] ",
                                "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                                "    public class Script : Model",
                                "    {",
                                "        [Link] Plant Plant;",
                                "        [Link] Clock Clock;",
                                "",
                                "        [Description(\"Spacing (m) between plants within rows\")]",
                                "        public double RowSpace { get; set; }",
                                "        [Description(\"Spacing (m) between rows\")]",
                                "        public double RowWidth { get; set; }",
                                "",
                                "        [Description(\"Cultivar\")]",
                                "        [Display(Type=DisplayType.CultivarName)]",
                                "        public string CultivarName { get; set; }",
                                "        [Description(\"Sowing Date\")]",
                                "        public DateTime SowingDate { get; set; }",
                                "",
                                "        [EventSubscribe(\"DoManagement\")]",
                                "        private void OnDoManagement(object sender, EventArgs e)",
                                "        {",
                                "            double PlantPopulation = 1 / (RowWidth * RowSpace);",
                                "",
                                "            if (Clock.Today.Date == SowingDate)",
                                "                Plant.Sow(population: PlantPopulation, ",
                                "                    cultivar: CultivarName, ",
                                "                    depth: 100, ",
                                "                    rowSpacing: 150);",
                                "            //Plant.Sow(... Contains the following arguements:",
                                "            //Population  double  Required  Seeds sowing/m2",
                                "            //Cultivar    string  Required  \"NameOfCultivar\"",
                                "            //Depth       double  Optional  Depth (mm) seed sown.   Default is 100mm ",
                                "            //MaxCover    double  Optional  Proportion (0-1) of the ground row crop will cover.   Default is 1.0",
                                "            //BudNumber   double  Optional  Number of mainstems per seed sown.  Default is 1.0",
                                "            //RowSpacing  double  Optional  Spaceing (mm) between drill rows when crop is sown.  Default is 150mm",
                                "            //CropClass   string  Optional  Crop class to instantiate when crop is sown.  Default is \"Plant\"",
                                "        }",
                                "    }",
                                "}",
                                "                "
                              ],
                              "Parameters": [
                                {
                                  "Key": "RowSpace",
                                  "Value": "2.4"
                                },
                                {
                                  "Key": "RowWidth",
                                  "Value": "5"
                                },
                                {
                                  "Key": "CultivarName",
                                  "Value": "elliottiiXcaribaeaF1"
                                },
                                {
                                  "Key": "SowingDate",
                                  "Value": "05/05/1999 00:00:00"
                                }
                              ],
                              "Name": "TreeSowingRule",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            },
                            {
                              "$type": "Models.Manager, Models",
                              "CodeArray": [
                                "",
                                "using APSIM.Core;",
                                "using Models.Soils;",
                                "using System.Xml.Serialization;",
                                "using Models.PMF;",
                                "using Models.Core;",
                                "using System.Collections.Generic;",
                                "using System;",
                                "using Newtonsoft.Json;",
                                "using Models.PMF.Interfaces;",
                                "",
                                "namespace Models",
                                "{",
                                "    [Serializable] ",
                                "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                                "    public class Script : Model, IStructureDependency",
                                "    {",
                                "        [Link] private Plant Pinus;",
                                "        [Link] private Clock Clock;",
                                "        ",
                                "        public IStructure Structure { private get; set; }",
                                "",
                                "",
                                "        ",
                                "        [EventSubscribe(\"StartOfSimulation\")]",
                                "        private void OnSimulationCommencing(object sender, EventArgs e)",
                                "        {",
                                "            ",
                                "        }",
                                "        ",
                                "        public void DoThin(double ThinFr)",
                                "        {",
                                "            //Set up  array of remove fractions to send with Cut method.  Each member in the array corresponds to an organ in the same order they are set up in.",
                                "",
                                "                //Harvest with manager specified removal fractions",
                                "                Pinus.structure?.DoThin(ThinFr);",
                                "                var Leaf =   Structure.FindChild<IHasDamageableBiomass>(\"Leaf\", relativeTo: (INodeModel)Pinus);",
                                "                var Stem =   Structure.FindChild<IHasDamageableBiomass>(\"Stem\", relativeTo: (INodeModel)Pinus);",
                                "                var Branch =   Structure.FindChild<IHasDamageableBiomass>(\"Branch\", relativeTo: (INodeModel)Pinus);",
                                "                var FineRoot =   Structure.FindChild<IHasDamageableBiomass>(\"FineRoot\", relativeTo: (INodeModel)Pinus);",
                                "                var CoarseRoot =   Structure.FindChild<IHasDamageableBiomass>(\"CoarseRoot\", relativeTo: (INodeModel)Pinus);",
                                "                Leaf.RemoveBiomass(liveToRemove: 0, deadToRemove: 0.0, liveToResidue: ThinFr, deadToResidue: 0.0);",
                                "                Stem.RemoveBiomass(liveToRemove: 0, deadToRemove: 0.0, liveToResidue: ThinFr, deadToResidue: 0.0);",
                                "                Branch.RemoveBiomass(liveToRemove: 0, deadToRemove: 0.0, liveToResidue: ThinFr, deadToResidue: 0.0);",
                                "                FineRoot.RemoveBiomass(liveToRemove: 0, deadToRemove: 0.0, liveToResidue: ThinFr, deadToResidue: 0.0);",
                                "                CoarseRoot.RemoveBiomass(liveToRemove: 0, deadToRemove: 0.0, liveToResidue: ThinFr, deadToResidue: 0.0);",
                                "",
                                "                Pinus.Population = Pinus.Population*(1-ThinFr);",
                                "        }",
                                "    }",
                                "}",
                                "",
                                "                "
                              ],
                              "Parameters": [],
                              "Name": "TreeThinning",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            },
