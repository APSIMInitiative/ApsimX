                              "Key": "Efficiency",
                              "Value": "1"
                            },
                            {
                              "Key": "WillRunoff",
                              "Value": "False"
                            }
                          ],
                          "Name": "IrrDate",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
