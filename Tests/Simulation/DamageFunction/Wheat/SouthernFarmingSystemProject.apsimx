                  "Enabled": true,
                  "Date": "2019-05-06",
                  "Action": "[Fertiliser].Apply(amount:9, type:\"NO3N\", depth:150);",
                  "Line": "2019-05-06 [Fertiliser].Apply(amount:9, type:\"NO3N\", depth:150);"
                },
