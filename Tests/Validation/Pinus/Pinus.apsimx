            {
              "$type": "Models.Core.Folder, Models",
              "ShowInDocs": true,
              "Name": "Puruki",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Memo, Models",
                  "Text": "These data are from one plot at a highly productive site in New Zealand. Studies at the site included physiology and growth, nutrition, soils and hydrology, which were published. This site was of particular interest for this validation because it had high nutrient availability and high rainfall, and it was well-published. Publications drawn on were [#rijkse1974soils], [#beets1987puruki], [#beets1987uptake], [#beets1987specific], [#beets1987accumulation], [#dyck1987nitrogen], [#beets1996carbon], [#parfitt_nitrogen_2006], [#kimberley2007national], [#oliver2004variation], [#beets2007root], [#beets2011planted], [#beets2018carbon], Beets et al (2018 Puruki field trip - a productive ex-pasture site DOI:10.13140/RG.2.2.16726.50243), [#garrett2019national], and [#beets2020soil].\n\n\n",
                  "Name": "Memo",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
