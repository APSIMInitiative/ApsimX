                    {
                      "$type": "Models.PMF.Plant, Models",
                      "Phenology": null,
                      "Arbitrator": null,
                      "structure": null,
                      "Leaf": null,
                      "Root": null,
                      "AboveGround": null,
                      "Name": "Slurp",
