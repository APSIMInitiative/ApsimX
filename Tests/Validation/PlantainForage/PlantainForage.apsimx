                                  "Line": "2015-12-16 [DefoliationManager].Script.Defoliate(amountDM: 60, amountType: \"ResidualDM\", duration: 1)"
                                },
                                {
                                  "$type": "Models.Operation, Models",
                                  "Enabled": true,
                                  "Date": "2016-01-25",
                                  "Action": "[DefoliationManager].Script.Defoliate(amountDM: 60, amountType: \"ResidualDM\", duration: 1)",
                                  "Line": "2016-01-25 [DefoliationManager].Script.Defoliate(amountDM: 60, amountType: \"ResidualDM\", duration: 1)"
                                },
                                {
                                  "$type": "Models.Operation, Models",
                                  "Enabled": true,
