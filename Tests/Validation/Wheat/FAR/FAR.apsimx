            {
              "$type": "Models.Factorial.Experiment, Models",
              "DisabledSimNames": null,
              "Name": "FAR SAC W19-06",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Memo, Models",
                  "Text": "# Field Applied Research (FAR) Australia trial FAR SAC W19-06 at Millicent in 2019. \r\n\r\nThis trial has been selected because it contained 1 cultivars of interest, and had up to 7 Greenseeker (NDVI), 2 biomass, 0 N concentration or 0 growth stage measurements. \r\n\r\n*Grazing/defolation treatments have been excluded.* \r\n\r\nTrial description: **Seedrate (Crop canopy) x Plant Growth Regulator (PGR) interaction in wheat** \r\n\r\n[Some trial details may be found here](https://faraustralia.com.au/resource) \r\n\r\n",
                  "Name": "Description",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
