                          "Value": "10/03/2002 00:00:00"
                        },
                        {
                          "Key": "FrostDate2",
                          "Value": "11/18/2002 00:00:00"
                        }
                      ],
                      "Name": "HarvestNPruning",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
