                }
              ],
              "Enabled": true,
              "ReadOnly": false
            }
          ],
          "Enabled": true,
          "ReadOnly": false
        },
        {
          "$type": "Models.Manager, Models",
          "CodeArray": [
            "using APSIM.Core;",
            "using Models.Soils;",
            "using Models.Interfaces;",
            "using APSIM.Shared.Utilities;",
            "using System.Xml.Serialization;",
            "using Models.PMF;",
            "using Models.Core;",
            "using System.Collections.Generic;",
            "using System;",
            "using Newtonsoft.Json;",
            "using Models.PMF.Interfaces;",
            "using Models.Functions;",
            "",
            "namespace Models",
            "{",
            "    [Serializable] ",
            "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
            "    public class Script : Model, IStructureDependency",
            "    {",
            "        [Link] private Plant Pinus;",
            "        [Link] private Clock Clock;",
            "        ",
            "        [Link(Type = LinkType.Path, Path = \"[Pinus].Stem.SizeClass\")]",
            "        private Models.Forestry.StemSizeDistribution SizeClass;",
            "        ",
            "        public IStructure Structure { private get; set; }",
            "        /// <summary>",
            "        /// Forest-floor decomposition: fraction of decomposed litter C that enters the soil (microbial and humic pools); the rest is",
            "        /// respired. APSIM uses 0.4 for all residues, so a pine floor demands ~47 kg N per t C decomposed against ~6 kg in needle litter",
            "        /// and ties up soil N in mid-rotation. Little above-ground litter C reaches mineral soil (soil C comes mainly from below-ground",
            "        /// inputs). 0.1 best fitted OFO growth but over-fed unfertilised controls at N-poor sites and collapsed fertiliser responses",
            "        /// (response error 0.19 -> 0.30). Set back to APSIM's 0.4 (2026-11-17) once deep drainage in the OFO and Benyon soils moved the",
            "        /// post-planting N flush deeper and later; kept as a parameter for a forest-floor N-import mechanism under review (real floors",
            "        /// take up soil N and fall to C:N ~26-40; APSIM residue keeps its litter C:N). The floor flow links its efficiency by name to",
            "        /// the Nutrient-level 0.4, so the value is given to the floor flow directly on the first day; soil flows keep 0.4.",
            "        /// </summary>",
            "        [Description(\"Forest-floor decomposition: fraction of decomposed litter C entering the soil (APSIM default 0.4)\")]",
            "        public double FloorCO2Efficiency { get; set; } = 0.4;",
            "        private bool floorSet;",
            "        [EventSubscribe(\"DoManagement\")]",
            "        private void SetFloorDecomposition(object sender, EventArgs e)",
            "        {",
            "            if (floorSet) return; floorSet = true;",
            "            var som = Structure.Find<Models.Surface.SurfaceOrganicMatter>(relativeTo: this);",
            "            var pool = Structure.FindChild<Models.Soils.Nutrients.OrganicPool>(\"SurfaceResidue\", relativeTo: (INodeModel)som);",
            "            var flow = Structure.FindChild<Models.Soils.Nutrients.OrganicFlow>(\"Decomposition\", relativeTo: (INodeModel)pool);",
            "            if (pool == null || flow == null) throw new Exception(\"TreeThinning: cannot find SurfaceResidue decomposition flow\");",
            "            var field = typeof(Models.Soils.Nutrients.OrganicFlow).GetField(\"co2Efficiency\", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);",
            "            field.SetValue(flow, new Models.Functions.Constant() { FixedValue = FloorCO2Efficiency });",
            "            flow.Initialise(Structure.Find<Models.Soils.IPhysical>(relativeTo: this).Thickness.Length);",
            "        }",
            "",
            "        [Link(Type = LinkType.Path, Path = \"[Pinus].StemMortality\")]",
            "        private IFunction StemMortality;",
            "        [Link(Type = LinkType.Path, Path = \"[Pinus].StemMortality.MaximumSDI\")]",
            "        private IFunction MaximumSDI;",
            "        [Link(Type = LinkType.Path, Path = \"[Pinus].Leaf.LeafResidenceTime.DroughtEffect.TimeConstant\")]",
            "        private IFunction SeasonalFwTimeConstant;",
            "        [Link(Type = LinkType.Path, Path = \"[Pinus].Leaf\")]",
            "        private Models.PMF.Organs.PerennialLeaf SeasonalLeaf;",
            "",
            "        /// <summary>Running mean of the leaf water stress factor (time constant TimeConstant days); drives the (dormant) drought shortening of needle residence time.</summary>",
            "        public double SeasonalFw { get; private set; } = 1;",
            "",
            "        [EventSubscribe(\"EndOfDay\")]",
            "        private void OnEndOfDaySeasonalFw(object sender, EventArgs e)",
            "        {",
            "            double fw = Pinus.IsAlive && SeasonalLeaf.LAI > 0 ? Math.Max(0, Math.Min(1, SeasonalLeaf.Fw)) : 1;",
            "            SeasonalFw += (fw - SeasonalFw) / Math.Max(1, SeasonalFwTimeConstant.Value());",
            "        }",
            "        [Link(Type = LinkType.Path, Path = \"[Pinus].Stem.HeightGrowth.InitialHeight\")]",
            "        private IFunction InitialHeight;",
            "        [Link(Type = LinkType.Path, Path = \"[Pinus].Stem.HeightGrowth.MaximumHeight\")]",
            "        private IFunction MaximumHeight;",
            "        [Link(Type = LinkType.Path, Path = \"[Pinus].Stem.HeightGrowth.Rate\")]",
            "        private IFunction HeightRate;",
            "        [Link(Type = LinkType.Path, Path = \"[Pinus].Stem.HeightGrowth.Shape\")]",
            "        private IFunction HeightShape;",
            "        [Link(Type = LinkType.Path, Path = \"[Pinus].Stem.HeightGrowth.ModifierExponent\")]",
            "        private IFunction ModifierExponent;",
            "        [Link(Type = LinkType.Path, Path = \"[Pinus].Stem.HeightGrowth.CoverExponent\")]",
            "        private IFunction CoverExponent;",
            "        [Link(Type = LinkType.Path, Path = \"[Pinus].Stem.HeightGrowth.ThinningExponent\")]",
            "        private IFunction ThinningExponent;",
            "        [Link(Type = LinkType.Path, Path = \"[Pinus].Leaf.Photosynthesis.FT\")]",
            "        private IFunction FT;",
            "        [Link(Type = LinkType.Path, Path = \"[Pinus].Leaf.Photosynthesis.FVPD\")]",
            "        private IFunction FVPD;",
            "        [Link(Type = LinkType.Path, Path = \"[Pinus].Leaf.Photosynthesis.FN\")]",
            "        private IFunction FN;",
            "        [Link(Type = LinkType.Path, Path = \"[Pinus].Leaf.Photosynthesis.FW\")]",
            "        private IFunction FW;",
            "",
            "        /// <summary>Mean tree height (m), an incremental state: age-free Chapman-Richards growth towards MaximumHeight, scaled by the photosynthesis modifiers and canopy cover.</summary>",
            "        public double Height { get; private set; }",
            "",
            "        [Link(Type = LinkType.Path, Path = \"[Pinus].Stem.HeightGrowth.SlendernessOnset\")]",
            "        private IFunction SlendernessOnset;",
            "        [Link(Type = LinkType.Path, Path = \"[Pinus].Stem.HeightGrowth.SlendernessLimit\")]",
            "        private IFunction SlendernessLimit;",
            "        [Link(Type = LinkType.Path, Path = \"[Pinus].Stem.DBH\")]",
            "        private IFunction StemDBH;",
            "        [Link(Type = LinkType.Path, Path = \"[Pinus].Stem.DBH.DBHEquation.TaperExponent\")]",
            "        private IFunction TaperExponent;",
            "        /// <summary>Height/diameter ratio (m/m) of the mean tree, using DBH without the breast-height taper term, so that",
            "        /// it measures stem form rather than how close the tree is to 1.3 m tall.</summary>",
            "        public double Slenderness { get; private set; }",
            "        /// <summary>Height growth multiplier: 1 below SlendernessOnset, falling linearly to 0 at SlendernessLimit (H/D, m/m).</summary>",
            "        private double SlendernessFactor()",
            "        {",
            "            double h = Math.Max(1.4, Height);",
            "            double dbh = StemDBH.Value() / Math.Pow((h - 1.3) / h, TaperExponent.Value());",
            "            Slenderness = dbh > 0 ? Height * 100 / dbh : 0;",
            "            double on = SlendernessOnset.Value(), lim = SlendernessLimit.Value();",
            "            if (Slenderness <= on || lim <= on) return 1;",
            "            return Math.Max(0, Math.Min(1, (lim - Slenderness) / (lim - on)));",
            "        }",
            "        [Link(Type = LinkType.Path, Path = \"[Pinus].Leaf\")] private Models.PMF.Organs.PerennialLeaf HeightLeaf;",
            "        [EventSubscribe(\"EndOfDay\")]",
            "        private void OnEndOfDayHeight(object sender, EventArgs e)",
            "        {",
            "            if (!Pinus.IsAlive || Pinus.Population <= 0) { Height = 0; return; }",
            "            if (Height <= 0) { Height = InitialHeight.Value(); return; }",
            "            double m = Math.Max(0, Math.Min(1, FT.Value() * FVPD.Value() * FN.Value() * FW.Value()));",
            "            double c = HeightShape.Value(), hmax = MaximumHeight.Value();",
            "            if (Height < hmax) Height += HeightRate.Value() / 365.0 * c * Height * (Math.Pow(hmax / Height, 1.0 / c) - 1) * Math.Pow(m, ModifierExponent.Value()) * Math.Pow(Math.Max(0, Math.Min(1, HeightLeaf.CoverGreen)), CoverExponent.Value()) * SlendernessFactor();",
            "        }",
            "        [Link(Type = LinkType.Path, Path = \"[Pinus].DroughtMortality\")]",
            "        private IFunction DroughtMortality;",
            "        [Link(Type = LinkType.Path, Path = \"[Pinus].DroughtMortality.RecentPeriod\")]",
            "        private IFunction RecentPeriod;",
            "        [Link(Type = LinkType.Path, Path = \"[Pinus].DroughtMortality.ReferencePeriod\")]",
            "        private IFunction ReferencePeriod;",
            "        [Link(Type = LinkType.Path, Path = \"[Pinus].DroughtMortality.Selectivity\")]",
            "        private IFunction DroughtSelectivity;",
            "        [Link(Type = LinkType.Path, Path = \"[Pinus].FineRoot\")]",
            "        private Models.PMF.Organs.Root FineRoot;",
            "",
            "        private double recentUse, referenceUse;",
            "        private int useDays;",
            "",
            "        /// <summary>Relative drop in water use (0-1): 1 - recent / reference running mean of daily FineRoot water uptake. Drives [Pinus].DroughtMortality.</summary>",
            "        public double WaterUseDrop { get; private set; }",
            "",
            "        [EventSubscribe(\"EndOfDay\")]",
            "        private void OnEndOfDayWaterUse(object sender, EventArgs e)",
            "        {",
            "            double use = Pinus.IsAlive ? Math.Abs(FineRoot.WaterUptake) : 0;",
            "            useDays++;",
            "            recentUse += (use - recentUse) / Math.Min(Math.Max(1, RecentPeriod.Value()), useDays);",
            "            referenceUse += (use - referenceUse) / Math.Min(Math.Max(1, ReferencePeriod.Value()), useDays);",
            "            WaterUseDrop = useDays > 365 && referenceUse > 0.1 ? Math.Max(0, 1 - recentUse / referenceUse) : 0;",
            "        }",
            "",
            "        /// <summary>",
            "        /// Monthly stem mortality: the annual rate from [Pinus].StemMortality, smallest trees first, then any excess over MaximumSDI, then drought mortality ([Pinus].DroughtMortality, dormant by default).",
            "        /// Removals below 10% of stems use the mortality branch of DoThin (leaves, branches and fine roots to litter, stems off site as standing dead).",
            "        /// </summary>",
            "        [EventSubscribe(\"StartOfMonth\")]",
            "        private void OnStartOfMonth(object sender, EventArgs e)",
            "        {",
            "            if (!Pinus.IsAlive || Pinus.Population <= 0) return;",
            "            double annual = Math.Min(0.5, Math.Max(0, StemMortality.Value()));",
            "            if (annual > 0) DoThinBySize(1 - Math.Pow(1 - annual, 1.0 / 12.0), SizeClass.MaximumRemovalSelectivity);",
            "            double sdi = SizeClass.StandDensityIndex, smax = MaximumSDI.Value();",
            "            if (sdi > smax && sdi > 0) DoThinBySize(Math.Min(0.5, 1 - smax / sdi), SizeClass.MaximumRemovalSelectivity);",
            "            double drought = Math.Min(0.5, Math.Max(0, DroughtMortality.Value()));   // dormant while DroughtMortality.MaximumRate = 0",
            "            if (drought > 1e-6) DoThinBySize(1 - Math.Pow(1 - drought, 1.0 / 12.0), DroughtSelectivity.Value());",
            "        }",
            "",
            "        /// <summary>Move a fraction of coarse roots into soil FOM, distributed like the live fine roots (CoarseRoot is a GenericOrgan, so its residue would otherwise go to the surface).</summary>",
            "        private void CoarseRootToSoil(IHasDamageableBiomass CoarseRoot, IHasDamageableBiomass FineRoot, double fr)",
            "        {",
            "            var cr = (Models.PMF.Organs.GenericOrgan)CoarseRoot;",
            "            var roots = (Models.PMF.Organs.Root)FineRoot;",
            "            double wt0 = cr.Wt, n0 = cr.N;",
            "            CoarseRoot.RemoveBiomass(liveToRemove: fr, deadToRemove: fr, liveToResidue: 0.0, deadToResidue: 0.0);",
            "            double dw = (wt0 - cr.Wt) * 10, dn = (n0 - cr.N) * 10;   // kg/ha",
            "            if (dw <= 0) return;",
            "            var layers = roots.LayerLive;",
            "            double tot = 0; foreach (var b in layers) tot += b.Wt;",
            "            var nutrient = Structure.Find<Models.Soils.Nutrients.INutrient>(relativeTo: (INodeModel)Pinus);",
            "            var L = new Models.Surface.FOMLayerLayerType[layers.Length];",
            "            for (int i = 0; i < layers.Length; i++)",
            "            {",
            "                double f = tot > 0 ? layers[i].Wt / tot : (i == 0 ? 1 : 0);",
            "                L[i] = new Models.Surface.FOMLayerLayerType { FOM = new Models.Surface.FOMType { amount = dw * f, N = dn * f, C = 0.4 * dw * f, P = 0, AshAlk = 0 }, CNR = 0, LabileP = 0 };",
            "            }",
            "            nutrient.DoIncorpFOM(new Models.Surface.FOMLayerType { Type = Pinus.PlantType, Layer = L });",
            "        }",
            "",
            "        ",
            "        /// <summary>Remove a fraction of stems, taking the same fraction of biomass (average trees).</summary>",
            "        public void DoThin(double ThinFr)",
            "        {",
            "            DoThin(ThinFr, ThinFr);",
            "        }",
            "",
            "        /// <summary>",
            "        /// Remove a fraction of stems (StemFr) and a separate fraction of biomass (BiomassFr).",
            "        /// BiomassFr less than StemFr represents thinning from below (smaller trees removed); greater, thinning from above.",
            "        /// StemFr below 0.1 is treated as mortality: leaves and branches go to surface residue, stems are removed (standing dead / coarse woody debris,",
            "        /// not part of the forest floor). Otherwise a commercial thinning (stems removed). In both cases coarse roots go to soil FOM, not the surface.",
            "        /// </summary>",
            "        public void DoThin(double StemFr, double BiomassFr)",
            "        {",
            "            SizeClass.ApplyRemoval(StemFr, BiomassFr);   // infer which sizes were removed and update the DBH distribution",
            "            RemoveStemsAndBiomass(StemFr, BiomassFr);",
            "        }",
            "",
            "        /// <summary>",
            "        /// Remove a fraction of stems chosen by size; the stem size distribution works out the biomass fraction removed.",
            "        /// Selectivity: about 1.8 for thinning from below (BFG 1988 thinning, 7 of 8 plots 1.6-2.0), 0 random, negative from above.",
            "        /// </summary>",
            "        public void DoThinBySize(double StemFr, double Selectivity)",
            "        {",
            "            double BiomassFr = SizeClass.RemoveBySize(StemFr, Selectivity);",
            "            RemoveStemsAndBiomass(StemFr, BiomassFr);",
            "        }",
            "",
            "        private void RemoveStemsAndBiomass(double StemFr, double BiomassFr)",
            "        {",
            "            Pinus.structure?.DoThin(BiomassFr);",
            "            var Leaf =   Structure.FindChild<IHasDamageableBiomass>(\"Leaf\", relativeTo: (INodeModel)Pinus);",
            "            var Stem =   Structure.FindChild<IHasDamageableBiomass>(\"Stem\", relativeTo: (INodeModel)Pinus);",
            "            var Branch =   Structure.FindChild<IHasDamageableBiomass>(\"Branch\", relativeTo: (INodeModel)Pinus);",
            "            var FineRoot =   Structure.FindChild<IHasDamageableBiomass>(\"FineRoot\", relativeTo: (INodeModel)Pinus);",
            "            var CoarseRoot =   Structure.FindChild<IHasDamageableBiomass>(\"CoarseRoot\", relativeTo: (INodeModel)Pinus);",
            "            ",
            "            if (StemFr<0.1)  // small removal: treat as mortality",
            "               {",
            "               Leaf.RemoveBiomass(liveToRemove: 0, deadToRemove: 0.0, liveToResidue: BiomassFr, deadToResidue: BiomassFr);",
            "               Stem.RemoveBiomass(liveToRemove: BiomassFr, deadToRemove: BiomassFr, liveToResidue: 0.0, deadToResidue: 0.0);",
            "               Branch.RemoveBiomass(liveToRemove: 0, deadToRemove: 0.0, liveToResidue: BiomassFr, deadToResidue: BiomassFr);",
            "               FineRoot.RemoveBiomass(liveToRemove: 0, deadToRemove: 0.0, liveToResidue: BiomassFr, deadToResidue: BiomassFr);",
            "               CoarseRootToSoil(CoarseRoot, FineRoot, BiomassFr);",
            "               }",
            "            else",
            "               {",
            "               Leaf.RemoveBiomass(liveToRemove: 0, deadToRemove: 0.0, liveToResidue: BiomassFr, deadToResidue: 0.0);",
            "               Stem.RemoveBiomass(liveToRemove: BiomassFr, deadToRemove: BiomassFr, liveToResidue: 0.0, deadToResidue: 0.0);",
            "               Branch.RemoveBiomass(liveToRemove: 0.0, deadToRemove: 0.0, liveToResidue: BiomassFr, deadToResidue: BiomassFr);",
            "               FineRoot.RemoveBiomass(liveToRemove: 0, deadToRemove: 0.0, liveToResidue: BiomassFr, deadToResidue: BiomassFr);",
            "               CoarseRootToSoil(CoarseRoot, FineRoot, BiomassFr);",
            "               }",
            "",
            "            Pinus.Population = Pinus.Population*(1-StemFr);",
            "            if (Height > 0 && SizeClass.LastRemovalMeanDBHRatio > 0) Height *= Math.Pow(SizeClass.LastRemovalMeanDBHRatio, ThinningExponent.Value());   // removing small trees raises mean height",
            "        }",
            "    }",
            "}",
            ""
          ],
          "Parameters": [],
          "Name": "TreeThinning",
          "ResourceName": null,
          "Children": [],
          "Enabled": true,
          "ReadOnly": false
        },
        {
          "$type": "Models.Manager, Models",
          "CodeArray": [
            "using APSIM.Core;",
            "using APSIM.Shared.Utilities;",
            "using Models.Core;",
            "using Models.Interfaces;",
            "using Models.PMF;",
            "using Models.PMF.Organs;",
            "using Models.Soils;",
            "using System;",
            "using System.Collections.Generic;",
            "using System.Globalization;",
            "using System.IO;",
            "using System.Linq;",
            "",
            "namespace Models",
            "{",
            "    /// <summary>",
            "    /// Groundwater for PinusV2 (rules suggested by Neil and Jim, after Benyon et al. 2006).",
            "    /// To use it, add a Manager named Groundwater to the paddock (this script replaces it) and either set WaterTable (mm) and",
            "    /// Nitrate (mg/L), or FileName and PGP for a driver file, with an Operation on the first day, e.g.",
            "    /// \"[Groundwater].Script.WaterTable = 3500\" (the replacement resets this script's parameters to the defaults below).",
            "    /// 1. At the start of each rotation the water table depth (D0) and groundwater NO3-N are fixed for the rotation (no seasonal",
            "    ///    or year-to-year change): either the WaterTable and Nitrate values, or the driver-file means over the 12 months from sowing.",
            "    /// 2. Groundwater is available only if D0 is no deeper than AccessDepth (6.5 m; Benyon et al. 2006: \"6 m or less\", plus a margin).",
            "    /// 3. Each day lateral inflow refills the saturated zone back towards D0, from the bottom up. Inflow is LateralInflow (mm/yr)",
            "    ///    scaled by recent rain: x (mean annual rain over the previous RainWindow years / the met file's long-term mean). Nitrate",
            "    ///    arrives with the refill (see 6). LateralInflow = -1 restores the old refill (MaxSupply plus base drainage per day).",
            "    /// 4. When the trees use the saturated zone faster than lateral inflow, the local water table falls (drawdown); inflow",
            "    ///    continues, and the table recovers when the trees use less. Rain recharge that",
            "    ///    raises the saturated zone above D0 drains away laterally (with its nitrate), so the table does not rise above D0.",
            "    /// 5. Roots can reach the bottom of the layer holding the local water table (the capillary fringe), not the saturated layers",
            "    ///    below, nor below AccessDepth; live roots in layers wholly saturated for more than AnoxiaDays die and go to soil FOM.",
            "    /// 6. Nitrate in the refill comes first from legacy groundwater, at the rotation NO3-N, until LegacyVolume mm have been taken;",
            "    ///    then from recharge water (profile drainage and lateral discharge, carrying only the nitrate leached or discharged from",
            "    ///    the soil); then from nitrate-free regional water. LegacyVolume = -1 (default) takes the saturated water (SAT) between D0",
            "    ///    and AccessDepth, so water below the access depth never counts; 0 restores unlimited supply at the rotation NO3-N.",
            "    /// Driver file (CSV, header row): PGP,Date,DTW_mm,DTW_unc_mm,NO3N_mgL,NO3N_unc_mgL.",
            "    /// Drawdown with LateralInflow = 40 mm/yr and AccessDepth 6.5 m (2026-11-17). With an unlimited refill the 15 OFO plots with",
            "    /// water tables within 6.5 m (Ning's depths) over-grew by ~40%; observed growth there is no higher than on deeper plots",
            "    /// (BA at age 10-20 34.1 vs 33.1 m2/ha). After deep drainage and floor retention 0.4, lateral inflow 150/100/75/50/25/0 mm/yr gave",
            "    /// those plots BA bias +10/+6/+4/+1/-2/-5% and BA NSE -0.07/0.08/0.12/0.14/0.15/0.15; 40 mm/yr (plantation interiors, little",
            "    /// lateral flow) sits at about zero bias. The Benyon et al. (2006) groundwater-use sites 10-12 measured about 600 mm/yr of net",
            "    /// groundwater use and are given LateralInflow = 800 by Operation, as higher-flow positions.",
            "    /// </summary>",
            "    [Serializable]",
            "    public class Script : Model, IStructureDependency",
            "    {",
            "        [Link] private Clock Clock;",
            "        [Link] private Models.Climate.Weather Weather;",
            "        [Link] private Plant Pinus;",
            "        [Link] private Simulation Simulation;",
            "        [Link] private IPhysical Physical;",
            "        [Link] private ISoilWater WaterBalance;",
            "        [Link(Type = LinkType.Path, Path = \"[Pinus].FineRoot\")] private Root FineRoot;",
            "        public IStructure Structure { private get; set; }",
            "",
            "        [Description(\"Water table depth for the rotation (mm; 0 = no groundwater)\")]",
            "        public double WaterTable { get; set; }",
            "        [Description(\"Groundwater NO3-N concentration (mg/L)\")]",
            "        public double Nitrate { get; set; }",
            "        [Description(\"Optional driver file instead (CSV: PGP,Date,DTW_mm,DTW_unc_mm,NO3N_mgL,NO3N_unc_mgL)\")]",
            "        public string FileName { get; set; }",
            "        [Description(\"Plot (PGP) number in the driver file\")]",
            "        public int PGP { get; set; }",
            "        [Description(\"Driver file: depth offset (standard deviations of DTW uncertainty; + = deeper)\")]",
            "        public double DepthOffsetSD { get; set; }",
            "        [Description(\"Driver file: nitrate offset (standard deviations of NO3-N uncertainty)\")]",
            "        public double NitrateOffsetSD { get; set; }",
            "        [Description(\"Deliver nitrate with the groundwater?\")]",
            "        public bool SupplyNitrate { get; set; } = true;",
            "        [Description(\"Deepest water table the trees can use (mm)\")]",
            "        public double AccessDepth { get; set; } = 6500;",
            "        [Description(\"Maximum net groundwater supply (mm/day)\")]",
            "        public double MaxSupply { get; set; } = 2;",
            "        [Description(\"Days a layer is saturated before its roots die (anoxia)\")]",
            "        public double AnoxiaDays { get; set; } = 10;",
            "        [Description(\"Lateral groundwater inflow (mm/yr); -1 = refill at MaxSupply per day instead\")]",
            "        public double LateralInflow { get; set; } = 40;",
            "        [Description(\"Years of rainfall that drive lateral inflow (inflow scales with their mean annual rain / the long-term mean)\")]",
            "        public double RainWindow { get; set; } = 3;",
            "        /// <summary>Lateral inflow today (mm/day).</summary>",
            "        public double LateralToday { get; private set; }",
            "        private SortedList<DateTime, double> cumRain;",
            "        private double meanAnnualRain;",
            "        /// <summary>Daily rain and its long-term annual mean from the met file (read once).</summary>",
            "        private void LoadRain()",
            "        {",
            "            cumRain = new SortedList<DateTime, double>();",
            "            string path = PathUtilities.GetAbsolutePath(Weather.FileName, Path.GetDirectoryName(Simulation.FileName));",
            "            int iy = -1, id = -1, ir = -1; double total = 0; bool units = false;",
            "            foreach (string raw in File.ReadLines(path))",
            "            {",
            "                string line = raw.Split('!')[0].Trim();",
            "                if (line.Length == 0 || line.StartsWith(\"[\") || line.Contains(\"=\")) continue;",
            "                var f = line.Split(new[] { ' ', '\\t', ',' }, StringSplitOptions.RemoveEmptyEntries);",
            "                if (iy < 0) { var h = f.Select(x => x.ToLower()).ToList(); if (h.Contains(\"year\") && h.Contains(\"rain\")) { iy = h.IndexOf(\"year\"); id = h.IndexOf(\"day\"); ir = h.IndexOf(\"rain\"); units = true; } continue; }",
            "                if (units) { units = false; if (f[0].StartsWith(\"(\")) continue; }",
            "                if (!int.TryParse(f[iy], out int y) || !int.TryParse(f[id], out int doy)) continue;",
            "                total += double.Parse(f[ir], CultureInfo.InvariantCulture);",
            "                cumRain[new DateTime(y, 1, 1).AddDays(doy - 1)] = total;",
            "            }",
            "            double days = (cumRain.Keys[cumRain.Count - 1] - cumRain.Keys[0]).TotalDays + 1;",
            "            meanAnnualRain = total / days * 365.25;",
            "        }",
            "        /// <summary>Lateral inflow for today (mm/day), scaled by recent rainfall.</summary>",
            "        private double Lateral()",
            "        {",
            "            if (cumRain == null) LoadRain();",
            "            DateTime end = Clock.Today.Date.AddDays(-1), start = end.AddDays(-Math.Round(365.25 * RainWindow));",
            "            DateTime first = cumRain.Keys[0], last = cumRain.Keys[cumRain.Count - 1];",
            "            if (start < first) start = first; if (end > last) end = last;",
            "            double years = (end - start).TotalDays / 365.25;",
            "            if (years < 0.5 || meanAnnualRain <= 0) return LateralInflow / 365.25;",
            "            double CumAt(DateTime t) { int i = cumRain.IndexOfKey(t); return i >= 0 ? cumRain.Values[i] : 0; }",
            "            double recent = (CumAt(end) - CumAt(start)) / years;",
            "            return LateralInflow / 365.25 * recent / meanAnnualRain;",
            "        }",
            "        [Description(\"Legacy groundwater carrying the starting nitrate (mm; 0 = unlimited; -1 = saturated water between the rotation water table and AccessDepth)\")]",
            "        public double LegacyVolume { get; set; } = -1;",
            "        /// <summary>Legacy groundwater not yet taken up (mm).</summary>",
            "        public double LegacyRemaining { get; private set; }",
            "        /// <summary>Recharge water in the groundwater store (mm) and its nitrate (kg N/ha).</summary>",
            "        public double RechargeWater { get; private set; }",
            "        public double RechargeN { get; private set; }",
            "        /// <summary>NO3-N concentration of today's groundwater supply (mg/L).</summary>",
            "        public double SupplyConcentration { get; private set; }",
            "        private bool legacySet;",
            "        /// <summary>Legacy groundwater at the start (mm).</summary>",
            "        public double LegacyStart { get; private set; }",
            "",
            "        /// <summary>Water table depth set at the start of the rotation (mm); 0 when groundwater is off.</summary>",
            "        public double RotationDepth { get; private set; }",
            "        /// <summary>Local water table depth today, after tree drawdown (mm); 0 when groundwater is off.</summary>",
            "        public double WaterTableDepth { get; private set; }",
            "        /// <summary>Groundwater NO3-N concentration for the rotation (mg/L).</summary>",
            "        public double NitrateConcentration { get; private set; }",
            "        /// <summary>Water added to the saturated zone today (mm).</summary>",
            "        public double Inflow { get; private set; }",
            "        /// <summary>Inflow less yesterday's drainage from the profile base: net groundwater supply (mm).</summary>",
            "        public double NetInflow { get; private set; }",
            "        /// <summary>Water drained laterally from above the rotation water table today (mm).</summary>",
            "        public double Discharge { get; private set; }",
            "        /// <summary>Groundwater NO3-N delivered today (kg N/ha).</summary>",
            "        public double NitrateSupplied { get; private set; }",
            "        /// <summary>Live root mass killed by anoxia today (g/m2).</summary>",
            "        public double RootsPruned { get; private set; }",
            "",
            "        private double lastDrainage;",
            "        private DateTime rotationStart = DateTime.MinValue;",
            "        private List<DateTime> dates = new List<DateTime>();",
            "        private List<double> dtw = new List<double>(), dtwU = new List<double>(), no3 = new List<double>(), no3U = new List<double>();",
            "        private double[] satDays;",
            "",
            "        [EventSubscribe(\"StartOfSimulation\")]",
            "        private void OnStartOfSimulation(object sender, EventArgs e)",
            "        {",
            "            satDays = new double[Physical.Thickness.Length];",
            "        }",
            "",
            "        /// <summary>Read the driver-file rows for this PGP (on first use, or when FileName or PGP is changed by an operation).</summary>",
            "        private void LoadFile()",
            "        {",
            "            loaded = (FileName, PGP);",
            "            dates.Clear(); dtw.Clear(); dtwU.Clear(); no3.Clear(); no3U.Clear();",
            "            rotationStart = DateTime.MinValue;",
            "            string path = PathUtilities.GetAbsolutePath(FileName, Path.GetDirectoryName(Simulation.FileName));",
            "            if (!File.Exists(path)) throw new Exception($\"Groundwater: cannot find driver file {path}\");",
            "            foreach (string line in File.ReadLines(path).Skip(1))",
            "            {",
            "                var f = line.Split(',');",
            "                if (f.Length < 6 || int.Parse(f[0], CultureInfo.InvariantCulture) != PGP) continue;",
            "                dates.Add(DateTime.Parse(f[1], CultureInfo.InvariantCulture));",
            "                dtw.Add(double.Parse(f[2], CultureInfo.InvariantCulture));",
            "                dtwU.Add(double.Parse(f[3], CultureInfo.InvariantCulture));",
            "                no3.Add(double.Parse(f[4], CultureInfo.InvariantCulture));",
            "                no3U.Add(double.Parse(f[5], CultureInfo.InvariantCulture));",
            "            }",
            "            if (dates.Count == 0) throw new Exception($\"Groundwater: no rows for PGP {PGP} in {path}\");",
            "        }",
            "",
            "        private (string, int) loaded;",
            "        private bool FromFile => dates.Count > 0;",
            "        private bool Active => FromFile || WaterTable > 0;",
            "",
            "        [EventSubscribe(\"EndOfDay\")]",
            "        private void OnEndOfDay(object sender, EventArgs e)",
            "        {",
            "            lastDrainage = Active ? WaterBalance.Drainage : 0;",
            "            if (Active && LegacyVolume != 0) { RechargeWater += WaterBalance.Drainage; RechargeN += WaterBalance.LeachNO3; }",
            "        }",
            "",
            "        /// <summary>Fix the rotation water table and nitrate: the WaterTable and Nitrate values, or the driver-file means over",
            "        /// the 12 months from the start of the rotation (or the nearest 12 months of data).</summary>",
            "        private void SetRotation(DateTime start)",
            "        {",
            "            rotationStart = start;",
            "            inputs = (WaterTable, Nitrate);",
            "            initialise = true;",
            "            if (!FromFile)",
            "            {",
            "                RotationDepth = WaterTable;",
            "                NitrateConcentration = Nitrate;",
            "                return;",
            "            }",
            "            int i0 = dates.FindIndex(d => d >= start);",
            "            if (i0 < 0) i0 = Math.Max(0, dates.Count - 12);",
            "            i0 = Math.Min(i0, Math.Max(0, dates.Count - 12));",
            "            int n = Math.Min(12, dates.Count - i0);",
            "            double Mean(List<double> v) => v.Skip(i0).Take(n).Average();",
            "            RotationDepth = Math.Max(0, Mean(dtw) + DepthOffsetSD * Mean(dtwU));",
            "            NitrateConcentration = Math.Max(0, Mean(no3) + NitrateOffsetSD * Mean(no3U));",
            "        }",
            "        /// <summary>Split today's inflow between legacy, recharge and regional water; returns NO3-N delivered (kg N/ha).</summary>",
            "        private double SupplyNitrogen(double inflow)",
            "        {",
            "            if (LegacyVolume == 0) return NitrateConcentration * inflow * 0.01;",
            "            if (!legacySet)",
            "            {",
            "                LegacyRemaining = LegacyVolume;",
            "                if (LegacyVolume < 0)",
            "                {   // only the groundwater the trees can reach: saturated water (SAT) between the rotation water table and AccessDepth",
            "                    LegacyRemaining = 0; double top = 0;",
            "                    for (int i = 0; i < Physical.Thickness.Length; i++)",
            "                    {",
            "                        double bottom = top + Physical.Thickness[i];",
            "                        double overlap = Math.Max(0, Math.Min(bottom, AccessDepth) - Math.Max(top, RotationDepth));",
            "                        LegacyRemaining += overlap * Physical.SAT[i];",
            "                        top = bottom;",
            "                    }",
            "                }",
            "                LegacyStart = LegacyRemaining; legacySet = true;",
            "            }",
            "            double fromLegacy = Math.Min(inflow, LegacyRemaining); LegacyRemaining -= fromLegacy;",
            "            double rest = inflow - fromLegacy;",
            "            double fromRecharge = Math.Min(rest, RechargeWater);",
            "            double nRecharge = RechargeWater > 0 ? RechargeN * fromRecharge / RechargeWater : 0;",
            "            RechargeWater -= fromRecharge; RechargeN -= nRecharge;",
            "            return NitrateConcentration * fromLegacy * 0.01 + nRecharge;",
            "        }",
            "        private bool initialise;",
            "        private (double, double) inputs = (double.NaN, double.NaN);",
            "",
            "        [EventSubscribe(\"DoManagement\")]",
            "        private void OnDoManagement(object sender, EventArgs e)",
            "        {",
            "            Inflow = 0; NetInflow = 0; Discharge = 0; NitrateSupplied = 0; RootsPruned = 0; WaterTableDepth = 0; SupplyConcentration = 0;",
            "            if (!string.IsNullOrWhiteSpace(FileName) && loaded != (FileName, PGP)) LoadFile();",
            "            if (!Active) return;",
            "            if (rotationStart == DateTime.MinValue) SetRotation(Pinus.IsAlive ? Pinus.SowingDate : Clock.Today);",
            "            else if (Pinus.IsAlive && Pinus.SowingDate > rotationStart) SetRotation(Pinus.SowingDate);",
            "            else if (!FromFile && inputs != (WaterTable, Nitrate)) SetRotation(Clock.Today);   // values set or changed by an operation",
            "",
            "            double[] th = Physical.Thickness;",
            "            double profile = th.Sum();",
            "            if (initialise && RotationDepth > 0 && RotationDepth <= AccessDepth && RotationDepth < profile)",
            "                WaterBalance.WaterTable = RotationDepth;   // start the rotation with the saturated zone in place",
            "            initialise = false;",
            "            double[] sw = (double[])WaterBalance.SWmm.Clone();",
            "            double[] sat = th.Select((t, i) => Physical.SAT[i] * t).ToArray();",
            "            double[] dul = th.Select((t, i) => Physical.DUL[i] * t).ToArray();",
            "            double local = LocalWaterTable(sw, sat, dul, th);",
            "",
            "            bool active = RotationDepth > 0 && RotationDepth <= AccessDepth && RotationDepth < profile;",
            "            // Lateral discharge: rain recharge that raises the saturated zone above the rotation water table drains away",
            "            // (with its nitrate), so the water table does not rise above its rotation level.",
            "            if (active && local < RotationDepth)",
            "            {",
            "                double[] remove = new double[th.Length];",
            "                double layerBottom = 0;",
            "                for (int i = 0; i < th.Length; i++)",
            "                {",
            "                    double top = layerBottom; layerBottom += th[i];",
            "                    if (layerBottom <= local || top >= RotationDepth) continue;",
            "                    double target = RotationDepth <= top ? sat[i] : RotationDepth < layerBottom ? dul[i] + (layerBottom - RotationDepth) / th[i] * (sat[i] - dul[i]) : dul[i];",
            "                    remove[i] = Math.Max(0, sw[i] - target);",
            "                }",
            "                if (remove.Sum() > 0)",
            "                {",
            "                    var no3Solute = Structure.Find<ISolute>(\"NO3\", relativeTo: (INodeModel)Physical);",
            "                    double[] nLoss = remove.Select((w, i) => -no3Solute.kgha[i] * w / sw[i]).ToArray();",
            "                    no3Solute.AddKgHaDelta(SoluteSetterType.Other, nLoss);",
            "                    for (int i = 0; i < th.Length; i++) sw[i] -= remove[i];",
            "                    WaterBalance.SW = sw.Select((w, i) => w / th[i]).ToArray();",
            "                    Discharge = remove.Sum();",
            "                    if (LegacyVolume != 0) { RechargeWater += Discharge; RechargeN += -nLoss.Sum(); }",
            "                    local = LocalWaterTable(sw, sat, dul, th);",
            "                }",
            "            }",
            "",
            "            // Refill towards the rotation water table, bottom up, at most MaxSupply (net of base drainage) per day.",
            "            if (active)",
            "            {",
            "                LateralToday = LateralInflow >= 0 ? Lateral() : 0;",
            "                double budget = LateralInflow >= 0 ? LateralToday : MaxSupply + lastDrainage;",
            "                double[] add = new double[th.Length];",
            "                double bottom = profile;",
            "                for (int i = th.Length - 1; i >= 0 && budget > 0; i--)",
            "                {",
            "                    double top = bottom - th[i];",
            "                    double target = RotationDepth <= top ? sat[i]",
            "                                  : RotationDepth < bottom ? dul[i] + (bottom - RotationDepth) / th[i] * (sat[i] - dul[i])",
            "                                  : 0;",
            "                    add[i] = Math.Min(budget, Math.Max(0, target - sw[i]));",
            "                    budget -= add[i];",
            "                    sw[i] += add[i];",
            "                    bottom = top;",
            "                }",
            "                Inflow = add.Sum();",
            "                if (Inflow > 0)",
            "                {",
            "                    WaterBalance.SW = sw.Select((w, i) => w / th[i]).ToArray();",
            "                    double nTotal = SupplyNitrate ? SupplyNitrogen(Inflow) : 0;",
            "                    SupplyConcentration = Inflow > 0 ? nTotal / Inflow * 100 : 0;",
            "                    if (nTotal > 0)",
            "                    {",
            "                        double[] n = add.Select(w => nTotal * w / Inflow).ToArray();   // spread over the refilled layers",
            "                        Structure.Find<ISolute>(\"NO3\", relativeTo: (INodeModel)Physical).AddKgHaDelta(SoluteSetterType.Other, n);",
            "                        NitrateSupplied = n.Sum();",
            "                    }",
            "                }",
            "                local = LocalWaterTable(sw, sat, dul, th);",
            "            }",
            "            NetInflow = Inflow - lastDrainage - Discharge;",
            "            if (LateralInflow >= 0 && Pinus.IsAlive && FineRoot.PlantZone != null && FineRoot.PlantZone.Depth > AccessDepth)",
            "                FineRoot.PlantZone.Depth = AccessDepth;   // roots at groundwater sites stay above AccessDepth",
            "            if (local >= profile) { Array.Clear(satDays, 0, satDays.Length); return; }",
            "            WaterTableDepth = local;",
            "",
            "            // Anoxia: roots stop at the local water table and die in layers saturated for more than AnoxiaDays.",
            "            var zone = FineRoot.PlantZone;",
            "            bool rooted = Pinus.IsAlive && zone?.LayerLive != null;",
            "            double layerTop = 0;",
            "            for (int i = 0; i < th.Length; i++)",
            "            {",
            "                satDays[i] = layerTop >= local ? satDays[i] + 1 : 0;",
            "                if (rooted && satDays[i] > AnoxiaDays && zone.LayerLive[i].Wt > 0)",
            "                    RootsPruned += KillLayerRoots(i);",
            "                layerTop += th[i];",
            "            }",
            "            // Roots may occupy the layer holding the water table (the capillary fringe) but not the fully saturated layers below.",
            "            double fringeBottom = 0;",
            "            foreach (double t in th) { fringeBottom += t; if (fringeBottom > local) break; }",
            "            if (rooted && zone.Depth > fringeBottom) zone.Depth = fringeBottom;",
            "        }",
            "",
            "        /// <summary>Top of the saturated zone, scanning up from the profile base (mm); profile depth if the base is not saturated.</summary>",
            "        private static double LocalWaterTable(double[] sw, double[] sat, double[] dul, double[] th)",
            "        {",
            "            double bottom = th.Sum();",
            "            for (int i = th.Length - 1; i >= 0; i--)",
            "            {",
            "                double frac = sat[i] > dul[i] ? Math.Min(1, Math.Max(0, (sw[i] - dul[i]) / (sat[i] - dul[i]))) : 0;",
            "                if (frac < 0.999)",
            "                    return bottom - frac * th[i];",
            "                bottom -= th[i];",
            "            }",
            "            return 0;",
            "        }",
            "",
            "        /// <summary>Move the live roots in one layer to soil FOM in that layer; returns g/m2 killed.</summary>",
            "        private double KillLayerRoots(int i)",
            "        {",
            "            var b = FineRoot.PlantZone.LayerLive[i];",
            "            double wt = b.Wt, n = b.N;   // g/m2",
            "            b.Clear();",
            "            var nutrient = Structure.Find<Models.Soils.Nutrients.INutrient>(relativeTo: (INodeModel)Pinus);",
            "            var L = new Models.Surface.FOMLayerLayerType[Physical.Thickness.Length];",
            "            for (int j = 0; j < L.Length; j++)",
            "                L[j] = new Models.Surface.FOMLayerLayerType { FOM = new Models.Surface.FOMType { amount = j == i ? wt * 10 : 0, N = j == i ? n * 10 : 0, C = j == i ? 0.4 * wt * 10 : 0, P = 0, AshAlk = 0 }, CNR = 0, LabileP = 0 };",
            "            nutrient.DoIncorpFOM(new Models.Surface.FOMLayerType { Type = Pinus.PlantType, Layer = L });",
            "            return wt;",
            "        }",
            "    }",
            "}",
            ""
          ],
          "Parameters": [
            {
              "Key": "WaterTable",
              "Value": "0"
            },
            {
              "Key": "Nitrate",
              "Value": "0"
            },
            {
              "Key": "FileName",
              "Value": ""
            },
            {
              "Key": "PGP",
              "Value": "0"
            },
            {
              "Key": "DepthOffsetSD",
              "Value": "0"
            },
            {
              "Key": "NitrateOffsetSD",
              "Value": "0"
            },
            {
              "Key": "SupplyNitrate",
              "Value": "True"
            },
            {
              "Key": "AccessDepth",
              "Value": "6500"
            },
            {
              "Key": "MaxSupply",
              "Value": "2"
            },
            {
              "Key": "AnoxiaDays",
              "Value": "10"
            },
            {
              "Key": "LegacyVolume",
              "Value": "-1"
            },
            {
              "Key": "LateralInflow",
              "Value": "40"
            },
            {
              "Key": "RainWindow",
              "Value": "3"
            }
          ],
          "Name": "Groundwater",
          "ResourceName": null,
          "Children": [],
          "Enabled": true,
          "ReadOnly": false
        }
      ],
      "Enabled": true,
      "ReadOnly": false
    },
    {
      "$type": "Models.PreSimulationTools.Virtual, Models",
      "FileName": "%root%/Tests/Validation/Pinus/Pinus.apsimx",
      "ModelPaths": [
        "[DataStore]",
        "[Validation]"
      ],
      "Name": "Virtual",
      "ResourceName": null,
      "Children": [],
      "Enabled": true,
      "ReadOnly": false
    }
  ],
  "Enabled": true,
  "ReadOnly": false
}