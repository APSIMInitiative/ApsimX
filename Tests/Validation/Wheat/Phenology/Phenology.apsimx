                    {
                      "$type": "Models.Report, Models",
                      "VariableNames": null,
                      "EventNames": null,
                      "GroupByVariableName": null,
                      "Name": "HarvestReport",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Manager, Models",
                      "CodeArray": [
                        "",
                        "using APSIM.Core;",
                        "using Newtonsoft.Json;",
                        "using System.Xml.Serialization;",
                        "using APSIM.Shared.Utilities;",
                        "using Models.PMF;",
                        "using Models.Core;",
                        "using System;",
                        "using Models.PMF.Phen;",
                        "using Models.Soils;",
                        "        ",
                        "namespace Models",
                        "{",
                        "    [Serializable] ",
                        "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                        "    public class Script : Model, IStructureDependency",
                        "    {",
                        "        [Link] private Plant Wheat;",
                        "        [Link] private Clock Clock;",
                        "        [Link] private Simulation sim;",
                        "        [Link] private Summary Summary;",
                        "        [Link(Type = LinkType.Path, Path = \"[Wheat].Phenology\")]",
                        "        private Phenology phenology;",
                        "        public IStructure Structure { private get; set; }",
                        "        ",
                        "        [Description(\"Cultivar\")]",
                        "        public string Cultivar { get; set; }",
                        "        ",
                        "        [JsonIgnore] public bool Sown { get; set; }",
                        "        [JsonIgnore] public bool Harvested { get; set; }",
                        "        [JsonIgnore] public bool EndSet { get; set; }",
                        "        ",
                        "",
                        "        ",
                        "",
                        "        [EventSubscribe(\"StartOfSimulation\")]",
                        "        private void OnSimulationCommencing(object sender, EventArgs e)",
                        "        {",
                        "            Sown = false;",
                        "            Harvested = false;",
                        "            EndSet = false;",
                        "        }",
                        "        ",
                        "        [EventSubscribe(\"DoManagement\")]",
                        "        private void OnDoManagement(object sender, EventArgs e)",
                        "        {",
                        "            if (Sown == false)",
                        "            {",
                        "                Wheat.Sow(population: 200, cultivar: Cultivar, depth: 15, rowSpacing: 150, budNumber: 1);",
                        "                Sown = true;",
                        "            }",
                        "            ",
                        "            if (phenology.CurrentPhase.Name == \"ReadyForHarvesting\")",
                        "            {",
                        "                Wheat.Harvest();",
                        "                Wheat.EndCrop();",
                        "                Harvested = true;",
                        "                Summary.WriteMessage(this, \"Flowering reached so setting end date to stop simulation\", MessageType.Diagnostic);",
                        "            }",
                        "            ",
                        "            if ((Harvested == true) && (EndSet == false))",
                        "            {",
                        "                Structure.Set(\"Clock.EndDate\", Clock.Today.AddDays(1), relativeTo: sim);",
                        "                EndSet = true;",
                        "            }",
                        "        }",
                        "    }",
                        "}",
                        "                "
                      ],
                      "Parameters": [
                        {
                          "Key": "Cultivar",
                          "Value": "Wakanui"
                        }
                      ],
                      "Name": "SowAndHarvest",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Report, Models",
