            {
              "$type": "Models.Factorial.Experiment, Models",
              "DisabledSimNames": null,
              "Name": "FAR RRC W22-03",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Memo, Models",
                  "Text": "# Field Applied Research (FAR) Australia trial FAR RRC W22-03 at Wallendbeen in 2022. \r\n\r\nThis trial has been selected because it contained 3 cultivars of interest, and had up to 3 Greenseeker (NDVI), 1 biomass, 0 N concentration or 9 growth stage measurements. \r\n\r\n*Grazing/defolation treatments have been excluded.* \r\n\r\nTrial description: **Genotype x Management 3 cultivars tested under 2 fungicide programs (single spray and High input) and 4 Canopy management strategies (Standard 150kg N/ha** \r\n\r\n[Trial write-up](https://faraustralia.com.au/wp-content/uploads/2023/05/2022-HYC-Results-for-distribution_LOW-RES.pdf) \r\n\r\n",
                  "Name": "Description",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Factorial.Factors, Models",
                  "Name": "Factors",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Factorial.Permutation, Models",
                      "Name": "Permutation",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Factorial.Factor, Models",
                          "Specification": null,
                          "Name": "Canopy",
                          "ResourceName": null,
                          "Children": [
                            {
                              "$type": "Models.Factorial.CompositeFactor, Models",
                              "Specifications": [
                                "[Sowing].Script.Treat = Split N",
                                "[FertDate2].Script.FertiliserType = UreaN",
                                "[FertDate2].Script.FertiliserDates = 19-sep",
                                "[FertDate2].Script.Amount = 0"
                              ],
                              "Paths": null,
                              "Values": null,
                              "Name": "Split N",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            },
                            {
                              "$type": "Models.Factorial.CompositeFactor, Models",
                              "Specifications": [
                                "[Sowing].Script.Treat = Add N",
                                "[FertDate2].Script.FertiliserType = UreaN",
                                "[FertDate2].Script.FertiliserDates = 19-sep",
                                "[FertDate2].Script.Amount = 50"
                              ],
                              "Paths": null,
                              "Values": null,
                              "Name": "Add N",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            },
                            {
                              "$type": "Models.Factorial.CompositeFactor, Models",
                              "Specifications": [
                                "[Sowing].Script.Treat = GS16 def",
                                "[FertDate2].Script.FertiliserType = UreaN",
                                "[FertDate2].Script.FertiliserDates = 19-sep",
                                "[FertDate2].Script.Amount = 0"
                              ],
