                  "Name": "FPQToolara",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "These data are from a genetics experiment in south-east Queensland described by [#dieters2007productivity]. Four genotypes are compared: _P. elliottii_ var. elliottii (PEE), _P. caribaea_ var. hondurensis (PCH), the F1 hybrid, and the F2 hybrid. As only stem metrics were provided in the paper, genotypes were not calibrated for biomass components and other physiological attributes. \n\n\n",
                      "Name": "Memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
