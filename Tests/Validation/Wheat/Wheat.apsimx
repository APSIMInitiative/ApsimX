                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "using Models.Soils;",
                            "using System;",
                            "using Models.Core;",
                            "using Models.PMF;",
                            "namespace Models",
                            "{",
                            "    [Serializable]",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] Clock Clock;",
                            "        [Link] Fertiliser Fertiliser;",
                            "        [Link] Summary Summary;",
                            "        ",
                            "        ",
                            "        [Description(\"Amount of fertiliser to be applied (kg/ha)\")]",
                            "        public double Amount { get; set;}",
                            "        ",
                            "        [Description(\"Crop to be fertilised\")]",
                            "        public string CropName { get; set;}",
                            "        ",
                            "        ",
                            "        ",
                            "",
                            "        [EventSubscribe(\"Sowing\")]",
                            "        private void OnSowing(object sender, EventArgs e)",
                            "        {",
                            "            Model crop = sender as Model;",
                            "            if (crop.Name.ToLower()==CropName.ToLower())",
                            "                Fertiliser.Apply(amount: Amount, type: \"NO3N\");",
                            "        }",
                            "        ",
                            "    }",
                            "}"
                          ],
                          "Parameters": [
                            {
                              "Key": "Amount",
                              "Value": "300"
                            },
                            {
                              "Key": "CropName",
                              "Value": "wheat"
                            }
                          ],
                          "Name": "SowingFertiliser",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [],
                          "Parameters": [],
                          "Name": "Harvesting",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "using Models.Soils.Nutrients;",
                            "using System;",
                            "using Models.Core;",
                            "using Models.PMF;",
                            "using Models.Soils;",
                            "using Models.Soils.Nutrients;",
                            "using Models.Utilities;",
                            "using APSIM.Shared.Utilities;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable]",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] Clock Clock;",
                            "        [Link] Fertiliser Fertiliser;",
                            "        [Link] Summary Summary;",
                            "        [Link] Plant Wheat;",
                            "        [Link] Soil Soil;",
                            "        Accumulator accumulatedRain;",
                            "        ",
                            "        [Description(\"Sowing date (d-mmm)\")]",
                            "        public string SowDate { get; set; }",
                            "        [Description(\"Cultivar to be sown\")]",
                            "        public string CultivarName { get; set; }",
                            "        [Description(\"Sowing depth (mm)\")]",
                            "        public double SowingDepth { get; set; }",
                            "        [Description(\"Row spacing (mm)\")]",
                            "        public double RowSpacing { get; set; }",
                            "        [Description(\"Plant population (/m2)\")]",
                            "        public double Population { get; set; }",
                            "        ",
                            "        ",
                            "",
                            "",
                            "        [EventSubscribe(\"DoManagement\")]",
                            "        private void OnDoManagement(object sender, EventArgs e)",
                            "        {",
                            "        ",
                            "            ",
                            "            if (DateUtilities.WithinDates(SowDate, Clock.Today, SowDate))",
                            "            {",
                            "                Wheat.Sow(population: Population, cultivar: CultivarName, depth: SowingDepth, rowSpacing: RowSpacing);",
                            "",
                            "                if(SowDate == \"11-Apr\")",
                            "                {",
                            "                    Wheat.Phenology.SetPhaseCompletionDate(\"16-Apr\",\"Emerging\");",
                            "                }",
                            "                if(SowDate == \"13-May\")",
                            "                {",
                            "                    Wheat.Phenology.SetPhaseCompletionDate(\"20-May\",\"Emerging\");",
                            "                }",
                            "                if(SowDate == \"16-Jul\")",
                            "                {",
                            "                    Wheat.Phenology.SetPhaseCompletionDate(\"23-Jul\",\"Emerging\");",
                            "                }",
                            "                if(SowDate == \"12-Aug\")",
                            "                {",
                            "                    Wheat.Phenology.SetPhaseCompletionDate(\"19-Aug\",\"Emerging\");",
                            "                }",
                            "            }",
                            "        ",
                            "        }",
                            "        ",
                            "    }",
                            "}"
                          ],
                          "Parameters": [
                            {
                              "Key": "SowDate",
                              "Value": "= "
                            },
                            {
                              "Key": "CultivarName",
                              "Value": "Hartog"
                            },
                            {
                              "Key": "SowingDepth",
                              "Value": "50"
                            },
                            {
                              "Key": "RowSpacing",
                              "Value": "250"
                            },
                            {
                              "Key": "Population",
                              "Value": "150"
                            }
                          ],
                          "Name": "Sowing",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        }
                      ],
                      "Enabled": true,
                      "ReadOnly": false
                    },
