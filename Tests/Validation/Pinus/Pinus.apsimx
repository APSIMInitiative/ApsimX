                {
                  "$type": "Models.Core.Folder, Models",
                  "ShowInDocs": true,
                  "Name": "HQP321R2",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "These data were kindly provided by Hancock Queensland Plantations (HQPlantations) from Experiment 321GYM, which was established to:(1) examine the impacts of slash management, fertilization and cover crops on tree growth and nutrient status; (2) quantify the effects on soil properties; and (3) contribute to the CIFOR international network of long term experiments designed to identify and develop sustainable inter-rotation management practices. Early results were reported in [#simpson2000effects]. Data here are reported only for one of the best performing treatments of the second rotation (2R) to age 8 years (Experiment 321GYM, Treatement BL2-TWC). \n\n\n",
                      "Name": "Memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Core.Simulation, Models",
                      "Name": "HQP321GYMBL2TWC",
