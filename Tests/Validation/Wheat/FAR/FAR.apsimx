            {
              "$type": "Models.Factorial.Experiment, Models",
              "DisabledSimNames": null,
              "Name": "FAR SAC W20-03-2",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Memo, Models",
                  "Text": "# Field Applied Research (FAR) Australia trial FAR SAC W20-03-2 at Millicent in 2020. \r\n\r\nThis trial has been selected because it contained 9 cultivars of interest, and had up to 6 Greenseeker (NDVI), 3 biomass, 0 N concentration or 4 growth stage measurements. \r\n\r\n*Grazing/defolation treatments have been excluded.* \r\n\r\nTrial description: **Performance of winter and spring wheat germplasm managed under three different levels of management (mid-May sown).** \r\n\r\n[Trial write-up](https://faraustralia.com.au/wp-content/uploads/2021/04/210324-HYC-Project-2020-Results-Wheat-Final-1.pdf) \r\n\r\n",
                  "Name": "Description",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
