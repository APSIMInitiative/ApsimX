                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "using System;",
                            "using Models.Core;",
                            "using Models.Interfaces;",
                            "using Models.PMF;",
                            "using APSIM.Shared.Utilities;",
                            "using Models.Soils;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable]",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] IClock Clock;",
                            "        [Link] ISummary Summary;",
                            "        [Link] Water water;",
                            "        [Link] Physical physical;",
                            "        [Link] Chemical chemical;",
                            "        [Link] private ISoilWater waterBalance;",
                            "        [Link] private ISoilTemperature soiltemperature;",
                            "        ",
                            "",
                            "",
                            "        [Description(\"EM reading at LL15\")]",
                            "        public double EMLL15 { get; set;}",
                            "        ",
                            "        [Description(\"EM reading range\")]",
                            "        public double EMRange { get; set;}",
                            "",
                            "",
                            "       [Description(\"Daily EMp100\")]",
                            "        public double EMp100 { get; set;}",
                            "",
                            "       [Description(\"Daily EMv100\")]",
                            "        public double EMv100 { get; set;}",
                            "        ",
                            "       [Description(\"Daily FASW p Dipole\")]",
                            "        public double FASWp { get; set;}",
                            "",
                            "       [Description(\"Daily FASW v Dipole\")]",
                            "        public double FASWv { get; set;}",
                            "",
                            "        [EventSubscribe(\"DoManagement\")]",
                            "        private void DoDailyCalculations(object sender, EventArgs e)",
                            "        {",
                            "            int numlayers = 8;",
                            "            double WFptot = 0;",
                            "            double WFvtot = 0.0;",
                            "            double top = 0;",
                            "            double bottom = 0;",
                            "            ",
                            "            for (int i=0; i<numlayers; i++)",
                            "            {",
                            "               top = bottom;",
                            "               bottom = top +physical.Thickness[i] ;",
                            "               WFptot += Fcp(top/1000, bottom/1000);",
                            "               WFvtot += Fcv(top/1000, bottom/1000);",
                            "            }",
                            "",
                            "            top = 0;",
                            "            bottom = 0;       ",
                            "            FASWv = 0;",
                            "            FASWp = 0;     ",
                            "            EMp100 = 0;",
                            "            EMv100 = 0;",
                            "            for (int i=0; i<numlayers; i++)",
                            "            {",
                            "               top = bottom;",
                            "               bottom = top + physical.Thickness[i] ;",
                            "               double WtpLayer = Fcp(top/1000, bottom/1000)/WFptot;",
                            "               double WtvLayer = Fcv(top/1000, bottom/1000)/WFvtot;",
                            "",
                            "               //double FASWLayer = (water.MM[i] - physical.LL15mm[i])/(physical.DULmm[i] - physical.LL15mm[i]);",
                            "               double FASWLayer = (water.MM[i] - physical.LL15mm[i])/(physical.SATmm[i] - physical.LL15mm[i]);                                             ",
                            "               FASWp += FASWLayer * WtpLayer;",
                            "               FASWv += FASWLayer * WtvLayer;",
                            "               ",
                            "               double f = 2.46 + 3.03/(physical.SAT[i]/physical.BD[i]);",
                            "               double EMsat = chemical.EC[i] * f * 100;",
                            "               ",
                            "               double ST = soiltemperature.Value[i];",
                            "               double ECLayer = (EMLL15 + FASWLayer * (EMsat - EMLL15))/TF(ST);   ",
                            "               //double ECLayer = (EMLL15 + FASWLayer * EMRange)/TF(ST);",
                            "               EMp100 += ECLayer * WtpLayer;",
                            "               EMv100 += ECLayer * WtvLayer;                              ",
                            "           ",
                            "            }",
                            "        ",
                            "            ",
                            "        }",
                            "       ",
                            "",
                            "private double  phiv(double z )",
                            "{",
                            "return 4 * z * Math.Pow((4 * Math.Pow(z,2) + 1),-1.5);",
                            "}",
                            "",
                            "private double  phih(double z ) ",
                            "{",
                            "return 2 - 4 * z * Math.Pow((4 * Math.Pow(z, 2) + 1),-0.5);",
                            "}",
                            "",
                            "",
                            "private double  phip(double z ) ",
                            "{",
                            "return 2 * Math.Pow((4 * Math.Pow(z, 2) + 1),-1.5);",
                            "}",
                            "",
                            "private double  Rv(double z ) ",
                            "{",
                            "return Math.Pow((4 * Math.Pow(z,2) + 1),-0.5);",
                            "}",
                            "",
                            "private double  Rh(double z ) ",
                            "{",
                            "return Math.Pow((4 * Math.Pow(z,2) + 1),0.5) - 2 * z;",
                            "}",
                            "",
                            "private double  Rp(double z ) ",
                            "{",
                            "return 2 * z * Math.Pow((4 * Math.Pow(z,2) + 1),-0.5);",
                            "}",
                            "",
                            "private double  Fcv(double D1, double D2 )",
                            "{",
                            "return Rv(D1) - Rv(D2);",
                            "}",
                            "",
                            "",
                            "private double  Fch(double D1, double D2)",
                            "{",
                            "return Rh(D1) - Rh(D2);",
                            "}",
                            "        ",
                            "private double  Fcp(double D1, double D2)",
                            "{",
                            "return Rp(D1) - Rp(D2);",
                            "}        ",
                            "        ",
                            "private double TF(double t)",
                            "{ ",
                            " return 1 / (1 + 0.0191 * (t - 25));",
                            "}",
                            "        ",
                            "        ",
                            "    }",
                            "}"
                          ],
                          "Parameters": [
                            {
                              "Key": "EMLL15",
                              "Value": "80"
                            },
                            {
                              "Key": "EMRange",
                              "Value": "110"
                            },
                            {
                              "Key": "EMp100",
                              "Value": "0"
                            },
                            {
                              "Key": "EMv100",
                              "Value": "0"
                            },
                            {
                              "Key": "FASWp",
                              "Value": "0"
                            },
                            {
                              "Key": "FASWv",
                              "Value": "0"
                            }
                          ],
                          "Name": "EMCalculator",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "using Models.Soils;",
                            "using System;",
                            "using Models.Core;",
                            "using System.Text;",
                            "using Models.PMF;",
                            "using Models;",
                            "using APSIM.Shared.Utilities;",
                            "using Models.PMF.Phen;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable] ",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] ISummary summary;",
                            "        [Link] private Plant cotton;",
                            "        [Link(Type = LinkType.Path, Path = \"[cotton].Phenology\")]",
                            "        private Phenology phenology;",
                            "                [Link] Clock Clock;",
                            "",
                            "        private bool Harvestable = false;",
                            "",
                            "        [Description(\"Harvest Date (d-mmm)\")]",
                            "        public string HarvestDate { get; set; }   ",
                            "      ",
                            "        [EventSubscribe(\"DoManagement\")]",
                            "        private void OnDoManagement(object sender, EventArgs e)",
                            "        {",
                            "           ",
                            "            if (Harvestable && phenology.CurrentPhase.Name == \"ReadyForHarvesting\")",
                            "            {",
                            "                cotton.Harvest();",
                            "                cotton.EndCrop();                ",
                            "            }",
                            "            ",
                            "            if (DateUtilities.DatesAreEqual(HarvestDate, Clock.Today))",
                            "                Harvestable = true;",
                            "",
                            "        }",
                            "    }",
                            "}",
                            "       "
                          ],
                          "Parameters": [
                            {
                              "Key": "HarvestDate",
                              "Value": "30-Apr"
                            }
                          ],
                          "Name": "HarvestAfterDate",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        }
                      ],
